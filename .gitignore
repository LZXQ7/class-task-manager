outputs/admin-create-user.sql
# ⛔ 云函数环境变量（含 DB 口令），由 tcb fn env pull 拉取到本地
.env-*
.env
# 云函数依赖与打包缓存
cloudfunctions/*/node_modules/
.verify/

# 系统垃圾
.DS_Store
Thumbs.db

# ===== 项目特定排除（密钥 / 生产数据 / 衍生物） =====

# ⛔ 工作区记忆与备份：含生产 SQL 备份（学生姓名/学号等隐私）+ 记忆密钥，绝不可入库
.workbuddy/

# ⛔ 微信 IDE 私钥 / 上传密钥 / 用户专属配置（IDE 可重新生成）
project.private.config.json

# 衍生物与参考副本（非本项目源码，体积大且无版本意义）
.fnverify/
Dawn-Course-ref/
preview/
miniapp/

# outputs/：702MB 构建/验证/迁移垃圾（含 Windows 保留名 aux 目录，git 无法读取），默认全忽略，仅保留 *.md 发版说明
outputs/**
!outputs/*.md

