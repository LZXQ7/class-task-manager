{
  "envId": "<YOUR_ENV_ID>",
  "region": "ap-shanghai",
  "functions": [
    {
      "name": "admin-web",
      "type": "HTTP",
      "protocolType": "HTTP",
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "timeout": 60,
      "memorySize": 512,
      "installDependency": true,
      "dir": "./cloudfunctions/admin-web",
      "description": "网页管理后台（仅超管）：课程表 / 成员 / 账号班级 / 系统配置 / 操作审计",
      "gatewayPath": "/admin",
      "public": true,
      "vpc": {
        "vpcId": "vpc-c4ga6fms",
        "subnetId": "subnet-a5mkrg1l"
      }
    },
    {
      "name": "fee",
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "timeout": 20,
      "memorySize": 256,
      "installDependency": true,
      "dir": "./cloudfunctions/fee",
      "description": "班费/团费：getSummary/setTotal/addExpense/deleteRecord",
      "vpc": {
        "vpcId": "vpc-c4ga6fms",
        "subnetId": "subnet-a5mkrg1l"
      }
    },
    {
      "name": "stat",
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "timeout": 20,
      "memorySize": 256,
      "installDependency": true,
      "dir": "./cloudfunctions/stat",
      "description": "使用埋点：track 批量写入 usage_event",
      "vpc": {
        "vpcId": "vpc-c4ga6fms",
        "subnetId": "subnet-a5mkrg1l"
      }
    },
    {
      "name": "auth",
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "timeout": 20,
      "memorySize": 256,
      "installDependency": true,
      "dir": "./cloudfunctions/auth",
      "description": "认证/绑定/换绑/审核体验入口（与线上 2026-10-15 配置一致，首次入库登记）",
      "vpc": {
        "vpcId": "vpc-c4ga6fms",
        "subnetId": "subnet-a5mkrg1l"
      }
    },
    {
      "name": "config",
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "timeout": 20,
      "memorySize": 256,
      "installDependency": true,
      "dir": "./cloudfunctions/config",
      "description": "前端远程配置下发：公开读 app_config 全表（免审改文案/开关）",
      "vpc": {
        "vpcId": "vpc-c4ga6fms",
        "subnetId": "subnet-a5mkrg1l"
      }
    }
  ],
  "gateway": {
    "routes": [
      {
        "path": "/admin",
        "target": "function:admin-web",
        "protocol": "HTTP_AND_HTTPS",
        "enablePathTransmission": false,
        "enableAuth": false
      }
    ]
  },
  "functionRoot": "./functions",
  "ai": {
    "defaultAgent": "{{env.AI_DEFAULT_AGENT}}",
    "agents": {
      "codebuddy": {
        "type": "none"
      }
    }
  }
}