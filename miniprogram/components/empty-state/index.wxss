.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.empty-title {
  margin-top: 24rpx;
  font-size: 28rpx;
  line-height: 40rpx;
  color: var(--text-3);
}
.empty-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--text-4);
  text-align: center;
  padding: 0 64rpx;
}
.empty-btn {
  margin-top: 32rpx;
  height: 64rpx;
  padding: 0 32rpx;
  border-radius: 40rpx;
  background: var(--brand-light);
  color: var(--brand);
  font-size: 26rpx;
  line-height: 64rpx;
}
.empty-btn:active {
  background: var(--brand-light-hover);
}
