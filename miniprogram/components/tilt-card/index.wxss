/* components/tilt-card/index.wxss（2026-11-14 试点 + #4 描边背光）
 * ============================================================
 * 四层结构（修「光不对：现在就一个框的线条转圈」+「描边看不出来」）：
 *   .tg-wrap    定位上下文 + **3D 变换目标**（无圆角、无 overflow ⇒ 变换不会吃掉圆角）
 *     .tg-glow  背光（纯色中性柔光，从四边透出）
 *     .tg-edge  描边壳：padding 2.5rpx + overflow:hidden + border-radius + 柔和投影
 *       .tg-cone  壳内的纯色片（被壳裁成**只沿边框一圈**）
 *       .tg-surface 卡片本体（裁切圆角；不做 transform）
 * ⚠️ 上一版把 conic 直接铺在卡片面上、靠 mask 掏空 —— WebView 不支持
 *    `mask-composite: exclude` ⇒ conic 实心铺满卡片内部 ⇒ 看着就是「斜线 / 半圈」，
 *    正是用户截图里圈出来的东西。
 * ⚠️ 描边改成**静态纯色**（用户口径：「光不要彩色，要简单平淡的。纯色」），
 *    不再转圈 —— 静态一圈中性灰反而更像「卡片有一层边」。
 * ⚠️ 所有多行值一律写成**单行**：WXSS 里以 `,` 续行会被 check-wxss 的
 *    「漏分号」启发式误判（app.wxss / aura-card / nav-bar 都栽过）。
 */

/* ---------- #4 中性纯色背光（用户口径：不要彩色、简单平淡）---------- */
.tg-wrap {
  position: relative;
  /* 3D 变换放在这一层：这一层**没有圆角也没有 overflow**，
     所以按住卡片时不会把子节点的圆角裁成方角（真机实锤问题）。 */
  transform: perspective(600px) rotateX(0deg) rotateY(0deg);
  transform-origin: center center;
  will-change: transform;
}
.tg-wrap.tg-off { will-change: auto; }
.tg-glow {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 124%;
  height: 150%;
  z-index: 0;
  margin-left: -62%;
  margin-top: -75%;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(126, 134, 150, 0.78) 0%, rgba(126, 134, 150, 0.36) 38%, rgba(126, 134, 150, 0.12) 56%, transparent 74%);
  filter: blur(26px);
  opacity: .7;
  animation: tgBreath 3.6s ease-in-out infinite;
  pointer-events: none;
}
.t-dark .tg-glow {
  background: radial-gradient(ellipse at center, rgba(170, 186, 214, 0.6) 0%, rgba(150, 166, 200, 0.26) 38%, rgba(150, 166, 200, 0.09) 56%, transparent 74%);
}
@keyframes tgBreath {
  0%, 100% { opacity: .48; transform: scale(.96); }
  50%      { opacity: .92; transform: scale(1.06); }
}

/* 描边壳：padding 2.5rpx = 描边宽度；overflow:hidden 把纯色片裁成只沿边框一圈 */
.tg-edge {
  position: relative;
  z-index: 1;
  padding: 2.5rpx;
  border-radius: var(--r-md, 24rpx);
  overflow: hidden;
  /* 柔和投影 = 第二层「背光」，保证在浅色背景上也看得见卡片浮起来 */
  box-shadow: 0 10rpx 34rpx rgba(96, 104, 120, 0.28);
}
.t-dark .tg-edge {
  box-shadow: 0 10rpx 34rpx rgba(0, 0, 0, 0.5);
}
/* 壳内的纯色片：被壳裁出一圈描边，卡片内部不会沾到 */
.tg-cone {
  position: absolute;
  inset: -60%;
  z-index: 0;
  background: rgba(154, 163, 178, 0.62);
}

.tg-surface {
  position: relative;
  z-index: 1;
  border-radius: calc(var(--r-md, 24rpx) - 2.5rpx);
  overflow: hidden;
}

/* ---------- 径向反射流光（CSS 兜底，必定可见）----------
   ⚠️ WXS 那条「逐帧跟随手指」的路**在真机上拿不到节点**
   （selectComponent 只能选中自定义组件，而 .tg-glare 是普通 <view>），
   所以 2026-11-14 起**彻底删掉** WXS 里的 selectComponent，
   光效全部交给 CSS：这里是一层常驻呼吸柔光。 */
.tg-glare {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 9;
  pointer-events: none;
  opacity: .2;
  background: radial-gradient(circle at 50% 42%, rgba(255, 255, 255, 0.46) 0%, rgba(255, 255, 255, 0.16) 36%, transparent 66%);
  animation: tgGlareBreath 4.2s ease-in-out infinite;
}
@keyframes tgGlareBreath {
  0%, 100% { opacity: .1; }
  50%      { opacity: .34; }
}

/* 🔴 无障碍：reduced-motion 用 !important 压过 WXS 写的内联 transform
 *    （内联非 important 的优先级低于作者 !important），视觉上完全静止、保留材质。 */
@media (prefers-reduced-motion: reduce) {
  .tg-wrap { transform: none !important; will-change: auto; }
  .tg-glare { opacity: 0 !important; }
  .tg-glow { animation: none; opacity: .5; }
}
@media (prefers-reduced-transparency: reduce) {
  .tg-glare { display: none; }
  .tg-glow { display: none; }
}
