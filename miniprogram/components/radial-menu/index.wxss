/* #10 弧形菜单（v1.0.9.0 → 2026-11-14 按用户口径重做）
 * 用户口径：按钮改**圆形**、配色跟随整体（不要白色方块）；弧上间距一致；
 *   手指悬停的按钮要**高亮**（能看出该松在哪）。 */
.rm-root {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 2000;          /* 高于 dialog(1100) 与 custom-tab-bar（菜单是瞬时浮层，
                            贴着屏幕边的按钮展开时不能被底部 tabBar 压住 —— 用户实锤） */
  pointer-events: none;
}
.rm-mask {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  background: var(--bg-mask, rgba(0,0,0,0.45));
  opacity: 0;
  transition: opacity .2s ease;
}
.rm-mask.in { opacity: 1; pointer-events: auto; }
.rm-root.in .rm-mask { opacity: 1; pointer-events: auto; }

.rm-origin {
  position: absolute;
  left: 0; top: 0;
  width: 0; height: 0;       /* 仅作定位锚点，自身不占空间 */
}
.rm-item {
  position: absolute;
  left: 0; top: 0;
  /* 先移到触点中心，再向外推 (dx,dy)，再缩放；起点 scale(0) 保证「弹出」感 */
  transform: translate(-50%, -50%) translate(var(--dx), var(--dy)) scale(0);
  opacity: 0;
  transition: transform .28s cubic-bezier(.34, 1.4, .64, 1), opacity .2s ease;
}
.rm-root.in .rm-item {
  transform: translate(-50%, -50%) translate(var(--dx), var(--dy)) scale(1);
  opacity: 1;
}
/* 圆形按钮：112rpx（≈60px）直径，文字居中；四字项用小一号字塞进圆里 */
.rm-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  padding: 0 8rpx;
  border-radius: 50%;
  white-space: nowrap;
  /* 🔴 2026-11-15 用户口径：「这四个按钮也改成统一样式，玻璃效果」。
     原来是实心蓝渐变（上浅下深的高光渐变），和全站其它玻璃面不是一套语汇。
     现在改成**品牌蓝玻璃**：半透明底 + 背景模糊 + 1rpx 亮边 + 外投影，
     与课表页「＋」（pages/timetable 的 .fab）共用同一组令牌 ⇒ 两处观感一致。
     ⚠️ 组件 wxss 里不能再写 `.t-dark .rm-btn`（跨组件不命中），深浅色全部由令牌承担。 */
  background: var(--brand-glass, rgba(51, 112, 255, 0.66));
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  backdrop-filter: blur(24px) saturate(180%);
  border: 1rpx solid var(--brand-glass-edge, rgba(255, 255, 255, 0.45));
  box-shadow: var(--brand-glass-shadow, 0 10rpx 26rpx rgba(51, 112, 255, 0.28));
  font-size: 24rpx;
  color: #FFFFFF;
  /* 🔴 手指滑过时的弹性反馈（2026-11-15 用户要求「放大弹一下、移开缩小也弹一下」）：
     之前只在 .hot 里写死 scale(1.14)，这里没有 transition ⇒ 加类瞬间跳变（实锤「生硬扩大」）。
     现在两条规则各带一条 overshoot 贝塞尔（y1 > 1）：
       · 默认态这条管「手指移开 → 缩回」= 缩过头再归位（弹一下）
       · .hot 那条管「手指滑上 → 放大」= 冲过头再回落（弹一下）
     CSS transition 从当前值起步 ⇒ 手指快速滑过多个按钮时可半途改道、不会硬切。 */
  transition: transform 300ms cubic-bezier(.34, 1.7, .64, 1), box-shadow 300ms ease, filter 300ms ease;
}
/* 「统一样式」的第二半：四字项（临时课表）原来单独缩到 20rpx、其余 24rpx，
   一眼就能看出不是一套。现在统一 22rpx —— 四个字在 112rpx 圆里仍排得下。 */
.rm-btn.long { font-size: 22rpx; }
.rm-icon { font-size: 40rpx; line-height: 1; margin-bottom: 6rpx; }
.rm-label { font-size: 22rpx; line-height: 30rpx; color: #FFFFFF; }
.rm-btn.long .rm-label { font-size: 22rpx; line-height: 30rpx; }
/* 手指悬停的按钮：放大 + 提亮，一眼看出「松在这里就会选中它」 */
.rm-item.hot .rm-btn {
  transform: scale(1.14);
  box-shadow: 0 14rpx 34rpx rgba(51, 112, 255, 0.45);
  filter: brightness(1.08);
  /* 进入方向单独一条更饱满的回弹。⚠️ 不能只在默认态写：加 .hot 时
     浏览器用的是**目标态**的 transition，漏写这条就只剩「生硬扩大」。 */
  transition: transform 360ms cubic-bezier(.22, 1.62, .36, 1), box-shadow 360ms ease, filter 360ms ease;
}

/* 玻璃降级（check-glass 强制两条路径）：
   ① 不支持 backdrop-filter 的安卓 WebView —— 半透明底会让背后的课表透上来压住白字，
      必须加厚到接近实心；② 系统开「降低透明度」—— 直接实心、关掉模糊。 */
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .rm-btn { background: var(--brand, #3370FF); }
}
@media (prefers-reduced-transparency: reduce) {
  .rm-btn {
    background: var(--brand, #3370FF);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
}

/* 减弱动效：去掉位移与缩放，直接淡入；弹性也要去掉，只留短暂光效变化 */
@media (prefers-reduced-motion: reduce) {
  .rm-item {
    transform: translate(-50%, -50%) translate(var(--dx), var(--dy)) scale(1);
    transition: opacity .12s ease;
  }
  .rm-btn { transition: box-shadow .12s ease, filter .12s ease; }
  .rm-item.hot .rm-btn {
    transform: none;
    transition: box-shadow .12s ease, filter .12s ease;
  }
}
