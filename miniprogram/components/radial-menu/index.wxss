/* #10 弧形菜单（v1.0.9.0 → 2026-11-14 按用户口径重做）
 * 用户口径：按钮改**圆形**、配色跟随整体（不要白色方块）；弧上间距一致；
 *   手指悬停的按钮要**高亮**（能看出该松在哪）。 */
.rm-root {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 2000;          /* 高于 dialog(1100) 与 custom-tab-bar（菜单是瞬时浮层，
                            贴着屏幕边的按钮展开时不能被底部 tabBar 压住 —— 用户实锤） */
  pointer-events: none;
}
.rm-mask {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  background: var(--bg-mask, rgba(0,0,0,0.45));
  opacity: 0;
  transition: opacity .2s ease;
}
.rm-mask.in { opacity: 1; pointer-events: auto; }
.rm-root.in .rm-mask { opacity: 1; pointer-events: auto; }

.rm-origin {
  position: absolute;
  left: 0; top: 0;
  width: 0; height: 0;       /* 仅作定位锚点，自身不占空间 */
}
.rm-item {
  position: absolute;
  left: 0; top: 0;
  /* 先移到触点中心，再向外推 (dx,dy)，再缩放；起点 scale(0) 保证「弹出」感 */
  transform: translate(-50%, -50%) translate(var(--dx), var(--dy)) scale(0);
  opacity: 0;
  transition: transform .28s cubic-bezier(.34, 1.4, .64, 1), opacity .2s ease;
}
.rm-root.in .rm-item {
  transform: translate(-50%, -50%) translate(var(--dx), var(--dy)) scale(1);
  opacity: 1;
}
/* 圆形按钮：112rpx（≈60px）直径，文字居中；四字项用小一号字塞进圆里 */
.rm-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  padding: 0 8rpx;
  border-radius: 50%;
  white-space: nowrap;
  /* 配色跟随整体：品牌蓝实心 + 白字（不再是白色方块 —— 用户实锤） */
  background: linear-gradient(140deg, #5A97FF 0%, var(--brand, #3370FF) 100%);
  box-shadow: 0 10rpx 26rpx rgba(51, 112, 255, 0.32);
  font-size: 26rpx;
  color: #FFFFFF;
}
.rm-btn.long { font-size: 20rpx; }
.rm-icon { font-size: 40rpx; line-height: 1; margin-bottom: 6rpx; }
.rm-label { font-size: 24rpx; line-height: 32rpx; color: #FFFFFF; }
.rm-btn.long .rm-label { font-size: 20rpx; line-height: 26rpx; }
/* 手指悬停的按钮：放大 + 提亮，一眼看出「松在这里就会选中它」 */
.rm-item.hot .rm-btn {
  transform: scale(1.14);
  box-shadow: 0 14rpx 34rpx rgba(51, 112, 255, 0.45);
  filter: brightness(1.08);
}

/* 深色模式：品牌蓝在深底上略压暗，保证白字对比度 */
.t-dark .rm-btn {
  background: linear-gradient(140deg, #4C8DFF 0%, #2F62D8 100%);
  box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, 0.5);
}

/* 减弱动效：去掉位移与缩放，直接淡入 */
@media (prefers-reduced-motion: reduce) {
  .rm-item {
    transform: translate(-50%, -50%) translate(var(--dx), var(--dy)) scale(1);
    transition: opacity .12s ease;
  }
  .rm-item.hot .rm-btn { transform: none; }
}
