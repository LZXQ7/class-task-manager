/* #10 弧形菜单（v1.0.9.0） */
.rm-root {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 1150;          /* 高于 dialog(1100)，菜单是瞬时浮层 */
  pointer-events: none;
}
.rm-mask {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  background: var(--bg-mask, rgba(0,0,0,0.45));
  opacity: 0;
  transition: opacity .2s ease;
}
.rm-mask.in { opacity: 1; pointer-events: auto; }
.rm-root.in .rm-mask { opacity: 1; pointer-events: auto; }

.rm-origin {
  position: absolute;
  left: 0; top: 0;
  width: 0; height: 0;       /* 仅作定位锚点，自身不占空间 */
}
.rm-item {
  position: absolute;
  left: 0; top: 0;
  /* 先移到触点中心，再向外推 (dx,dy)，再缩放；起点 scale(0) 保证「弹出」感 */
  transform: translate(-50%, -50%) translate(var(--dx), var(--dy)) scale(0);
  opacity: 0;
  transition: transform .28s cubic-bezier(.34, 1.4, .64, 1), opacity .2s ease;
}
.rm-root.in .rm-item {
  transform: translate(-50%, -50%) translate(var(--dx), var(--dy)) scale(1);
  opacity: 1;
}
.rm-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  height: 120rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  background: var(--sheet-solid, rgba(255,255,255,0.94));
  border: 1rpx solid var(--sheet-edge, rgba(255,255,255,0.95));
  box-shadow: var(--glass-shadow, 0 16rpx 64rpx rgba(29,33,41,0.15)), var(--glass-highlight, inset 0 2rpx 0 rgba(255,255,255,0.6));
  -webkit-backdrop-filter: var(--glass-blur, blur(24px) saturate(180%));
  backdrop-filter: var(--glass-blur, blur(24px) saturate(180%));
  font-size: 26rpx;
  color: var(--text-1);
}
.rm-icon { font-size: 40rpx; line-height: 1; margin-bottom: 6rpx; }
.rm-label { font-size: 24rpx; line-height: 32rpx; color: var(--text-2); }

/* 不支持模糊的机型：底色加厚到接近实心（与全站玻璃纪律一致，check-glass 管） */
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .rm-btn { background: var(--sheet-solid, rgba(255,255,255,0.96)); }
  .t-dark .rm-btn { background: var(--sheet-solid, rgba(26,30,39,0.98)); }
}
@media (prefers-reduced-transparency: reduce) {
  .rm-btn { background: var(--sheet-solid, #FFFFFF); -webkit-backdrop-filter: none; backdrop-filter: none; }
  .t-dark .rm-btn { background: var(--sheet-solid, #1C2027); }
}
/* 减弱动效：去掉位移与缩放，直接淡入 */
@media (prefers-reduced-motion: reduce) {
  .rm-item {
    transform: translate(-50%, -50%) translate(var(--dx), var(--dy)) scale(1);
    transition: opacity .12s ease;
  }
}
