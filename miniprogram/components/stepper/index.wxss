.stepper {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.sp-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: var(--bg-fill);
  color: var(--text-2);
  font-size: 32rpx;
  line-height: 64rpx;
  text-align: center;
}
.sp-btn.off {
  color: var(--text-4);
}
.sp-num {
  width: 80rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}
