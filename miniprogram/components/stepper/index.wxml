<view class="stepper">
  <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="sp-btn {{value <= min ? 'off' : ''}}" bindtap="onMinus">−</view>
  <view class="sp-num">{{value}}</view>
  <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="sp-btn {{value >= max ? 'off' : ''}}" bindtap="onPlus">＋</view>
</view>
