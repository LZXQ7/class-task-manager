/* 姓名自动补全（2026-11-14）：输入框 + 浮在下方的匹配列表 */
.ac {
  position: relative;
}
.ac-box {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: var(--r-pill, 999rpx);
  background: var(--bg-fill, #F2F3F5);
}
.ac-input {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
  height: 72rpx;
  font-size: 26rpx;
  color: var(--text-1);
}
.ac-clear {
  padding: 0 6rpx;
  font-size: 34rpx;
  line-height: 1;
  color: var(--text-4);
}
/* 下拉匹配列表：浮在输入框下方（不撑开页面布局） */
.ac-list {
  position: absolute;
  left: 0;
  right: 0;
  top: 80rpx;
  z-index: 30;
  max-height: 560rpx;
  overflow-y: auto;
  padding: 8rpx 0;
  border-radius: 24rpx;
  background: var(--bg-card, #FFFFFF);
  box-shadow: 0 16rpx 48rpx rgba(29, 33, 41, 0.18);
}
.ac-empty {
  padding: 24rpx 24rpx;
  font-size: 24rpx;
  color: var(--text-3);
  text-align: center;
}
.ac-item {
  display: flex;
  flex-direction: column;
  padding: 18rpx 24rpx;
}
.ac-item.off { opacity: .45; }
.ac-name {
  font-size: 28rpx;
  color: var(--text-1);
}
.ac-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-3);
}
/* 命中片段高亮（品牌蓝 + 淡蓝底） */
.ac-hl {
  color: var(--brand, #3370FF);
  background: var(--brand-light, #F0F5FF);
  border-radius: 4rpx;
  font-weight: 600;
}
