/* 过渡时长 .24s 必须与 components/popup-anim.js 的 DURATION 一致（那个用来决定何时卸载节点） */
.sheet-root {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  /* 关闭动画期间节点还在 DOM 里，用一个「不挡点击」的空壳兜住：
     只有真正到了终态（.in / .up）才接管点击，否则会吞掉页面的点击。 */
  pointer-events: none;
}
.sheet-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  /* 深色下遮罩要更重（--bg-mask 0.45 → 0.65），否则深页面压不暗、弹层浮不起来 */
  background: var(--bg-mask, rgba(0,0,0,0.45));
  opacity: 0;
  transition: opacity .24s ease;
}
.sheet-mask.in {
  opacity: 1;
  pointer-events: auto;
}
.sheet-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 78vh;
  /* 弹层 = 玻璃材质（v0.7.17）：面板压在页面内容之上，背后就是被模糊的正文 ——
     这是全站最「像玻璃」的位置。
     ⚠️ tint 从 0.52 提到 0.72（v0.7.21 需求④「成员详情界面比较暗」）：
        遮罩是 rgba(0,0,0,0.45)，把背后的极光压成 ≈#85858A；面板只有 52% 白时
        合成结果 ≈#C4C4C6 —— 一块灰板。内容少的弹层（普通管理员的成员详情就只有
        头像 + 三行字 + 一两个按钮）看上去就是「一块暗色面板」。
        0.72 合成 ≈#DCDCDE，是干净的近白，同时仍有 28% 底色透上来保住玻璃感。
        原注释写的 0.66 其实一直没落到代码里，这次一并改成真实值。 */
  background: var(--sheet-bg, rgba(255, 255, 255, 0.72));
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  backdrop-filter: blur(24px) saturate(180%);
  box-shadow: inset 0 1rpx 0 var(--sheet-edge, rgba(255, 255, 255, 0.95));
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform .24s cubic-bezier(.22, .61, .36, 1);
}
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .sheet-panel { background: var(--sheet-solid, rgba(255, 255, 255, 0.94)); }
}
@media (prefers-reduced-transparency: reduce) {
  .sheet-panel {
    background: var(--sheet-solid, rgba(255, 255, 255, 0.94));
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
}
.sheet-panel.up {
  transform: translateY(0);
  pointer-events: auto;
}

/* ===== variant="float"：**居中悬浮卡片**（不是贴底抽屉）=====
   用户口径（2026-11-14）：成员详情这种「看一个成员的完整信息」不该是
   从底部升起的抽屉，而该是**浮在页面中间的一张卡片**（截图5 的红框就是不要的样子）。
   ⚠️ 居中不用 `transform: translateY(-50%)` —— 那样会和拖拽用的内联 transform 打架
      （拖拽写的是 translate3d(0, Ypx, 0)）。改成让 **root 变成 flex 居中容器**、
      面板回到文档流里居中 ⇒ 拖拽的 transform 保持原样，互不干扰。
   ⚠️ 入场动画也从「从底部升起」改成「轻微放大 + 淡入」，符合"浮起来"的观感。 */
.sheet-root.float {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
}
.sheet-root.float .sheet-panel {
  position: relative;
  left: auto;
  right: auto;
  bottom: auto;
  width: 100%;
  /* 悬浮卡片必须比可用高度小，否则内容一长就撑满屏幕、看着还是"贴底的抽屉" */
  max-height: 72vh;
  border-radius: 32rpx;
  transform: scale(0.94);
  opacity: 0;
  transition: transform .24s cubic-bezier(.22, .61, .36, 1), opacity .24s ease;
  box-shadow: 0 24rpx 70rpx rgba(29, 33, 41, 0.28), inset 0 1rpx 0 var(--sheet-edge, rgba(255, 255, 255, 0.95));
}
.sheet-root.float .sheet-panel.up {
  transform: scale(1);
  opacity: 1;
}
.sheet-root.float .sheet-panel.tall { max-height: 72vh; }
.t-dark .sheet-root.float .sheet-panel {
  box-shadow: 0 24rpx 70rpx rgba(0, 0, 0, 0.6), inset 0 1rpx 0 var(--sheet-edge, rgba(255, 255, 255, 0.95));
}
@media (prefers-reduced-motion: reduce) {
  .sheet-root.float .sheet-panel,
  .sheet-root.float .sheet-panel.up { transform: none; }
  /* v1.0.10.7：JS 侧已经在「减弱动效」时整段不播容器转场，这里是双保险 ——
     万一远程配置/旧基础库让 morph 类漏进来，也不许再跑 240ms 的淡入淡出。 */
  .sheet-root.morph .sheet-mask,
  .sheet-root.morph .sheet-face,
  .sheet-root.morph .sheet-drag,
  .sheet-root.morph .sheet-spring,
  .sheet-root.morph .sheet-footer { transition: none; }
  /* v1.0.8.39：上面 v1.0.8.39 那条 delay 用的选择器多了 .morph-show、优先级更高，
     这里必须用同优先级显式归零，否则「减弱动效」下仍会残留 80ms 延迟。 */
  .sheet-root.morph.morph-show .sheet-drag,
  .sheet-root.morph.morph-show .sheet-spring,
  .sheet-root.morph.morph-show .sheet-footer { transition-delay: 0s; }
}
/* v0.7.25：更高面板 —— 内容确实装不进 78vh 的弹层用（如成员详情） */
.sheet-panel.tall { max-height: 92vh; }
/* ===== 拖动感应区（v0.7.32）：grabber + 标题栏，合计约 124rpx ≈ 62px =====
   ⚠️ 只有这一块接 touchmove（见 index.wxml），内容区 scroll-view 不受影响。
   改这里的高度要同步 components/bottom-sheet/index.js 的 bodyMaxH 里扣掉的 124rpx。 */
.sheet-drag { flex-shrink: 0; }
.sheet-grab {
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 拖动指示条（grabber）：短横胶囊 */
.sheet-grab::after {
  content: '';
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--sheet-grab, rgba(78, 89, 105, 0.28));
}
/* 拖动/回弹/滑出期间关掉 CSS 过渡 —— 位移完全由内联 transform 跟手驱动 */
.sheet-panel.drag { transition: none; }
/* v1.0.7 高度过渡：内容变高/变矮时平滑伸缩。
   ⚠️ 过渡的是 **min-height + max-height 这一对夹紧值**，不是 height：
      面板常态是 `height:auto + max-height`，**CSS 过渡不了 auto**（第一版就栽在这：
      高度「闪烁两下」且「几乎不平滑」—— 两段式的第一拍把面板写回旧高度造成回跳，
      第二拍 `px → auto` 根本不可插值）。
      成对夹紧的好处：① 上下同值 ⇒ 面板高度完全由这两个值决定，内容变化动不了它，
      不会出现「先跳到新高度再跳回来」；② 两端都是 JS 下发的确定 px ⇒ 直接插值；
      ③ **变高变矮完全对称**（只写 min-height 的话变高会被 auto 顶上去，仍然是硬跳变）。
   ⚠️ `transition` 是**简写属性、会整条覆盖**：这里必须把 transform 一并写上，
      否则挂上 .animating 的这 220ms 里面板的位移过渡（.24s）会一起消失。
      两条各管各的属性、互不覆盖，谁也不抢谁。
   ⚠️ min-height 与 max-height 的时长/曲线**必须写成一样的**：两端同值同曲线，
      夹紧区才是一个整体在动；不一致会出现「先撞上某一头再被另一头拽回去」的抽搐。 */
.sheet-panel.animating {
  transition: transform .24s cubic-bezier(.22, .61, .36, 1), min-height 220ms cubic-bezier(.22, .61, .36, 1), max-height 220ms cubic-bezier(.22, .61, .36, 1);
}
.sheet-head {
  position: relative;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 2rpx solid var(--sheet-line, rgba(229,230,235,0.7));
  flex-shrink: 0;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
}
.sheet-close {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sheet-body {
  flex: 1;
  /* v1.0.5：flex 子项默认 min-height:auto（= 内容高度）会阻止它收缩 → scroll-view
     拿不到确定高度、长内容滚不动。显式 min-height:0 让它在面板 max-height 内收缩并滚动。 */
  min-height: 0;
  overflow: hidden;
}
/* v1.0.5：body 改用 spring-scroll 后，spring-scroll 根节点（.ss-viewport）需要作为
   panel 的 flex 子项填满头部以下区域；min-height:0 让它在面板 max-height 内收缩并滚动。

   ⚠️ v1.0.6：光给 body 下发 max-height **不够**，实测「请假登记」整段完全滚不动。
      根因：面板是 **auto 高度**（只有 max-height，没有确定高度），它的高度是
      「先按内容算、再被 cap」—— 这种链上内核**不解析子节点的 height:100%**
      （项目踩过同一条：备注滚动那次记的「内核不支持 height:100% 解析时退化为
      max-height」）。`.ss-viewport { height:100% }` 落不了地 ⇒ 视口高度退化成
      **内容高度** ⇒ spring-scroll 算出的 `_maxScroll` 恒为 0 ⇒ 手指怎么滑都不动，
      长内容被直接截在屏幕底沿（看着像「就这么多了」）。
      现在让宿主自己成为 **column flex 容器**，由 `.ss-viewport { flex:1; min-height:0 }`
      拿到确定高度 —— 整条链不再依赖百分比高度解析。 */
.sheet-spring {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  /* 双保险：万一 flex 没落地，宿主自己也要把溢出裁掉（至少不会糊到面板外面去） */
  overflow: hidden;
}
.sheet-body-inner {
  width: 100%;
}
/* v0.7.25：底部固定操作条 —— panel（flex column）的第三个子项，flex-shrink:0
   保证不随 sheet-body 滚动/压缩。
   ⚠️ v0.7.32：容器只给「上留白 + 左右留白 + 上边框」，**底部留白归 footer 内容自己**
   （原来这里给 20rpx + 安全区，而使用方又各给一份 → 并入 duty-sheet 后会出现双份；
     而且需要让开悬浮 tabBar 的 footer 还得额外加，两处相加很难对上）。
   现在是：需要让位的 footer 内容自己写 `padding-bottom: calc(114rpx + max(env(...), 32px))`。 */
.sheet-footer {
  flex-shrink: 0;
  padding: 20rpx 32rpx 0;
  border-top: 2rpx solid var(--sheet-line, rgba(229, 230, 235, 0.7));
}

/* ===== v1.0.10.7 容器共享元素转场（originRect） ======================
   真实 .sheet-panel 从源卡片矩形非等比 FLIP 放大成详情面板，transform 由 JS
   内联下发（见 index.js 的 morphStyle）；这里只负责**与它同步**的两件事：

   ① 背景遮罩：改由 morphCls 接管淡入，不再只靠 .sheet-mask.in ——否则遮罩跟着
      popup-anim 的 active 在 20ms 起跑，而容器要等 selector query 回来才起跑，
      两者会错开一拍，看着就是「背景先暗、卡片后长」。现在两者同起点、同终点、
      同 240ms、同 cubic-bezier(.22,.61,.36,1)，才是一个连续的整体。
      ⚠️ 选择器要压过 `.sheet-mask.in`（0,2,0）：`.sheet-root.morph .sheet-mask` 是 0,3,0。
   ② 内容：非等比 scale(sx,sy) 会把文字横向/纵向拉变形 ⇒ 变换期间整体淡出，
      落定后淡入（container transform 的标准做法，不是可选项）。
      ⚠️ 两个方向**各写一条** transition（MEMORY 铁律）：加类时浏览器用目标态的
         过渡，去类时用默认态的；只写一条会让「缩回」变成瞬间消失。

   ⚠️ 全文件 transition 时长必须都是 .24s：scripts/check-popup-anim.js 会扫
      `transition: …s` 并逐条与 popup-anim.js 的 DURATION=240 比对。
   ==================================================================== */

/* v1.0.8.39：转场期把弹层再抬一档，兜住自定义 tabBar。
   .sheet-root 常态 z-index:1000 已高于 .tabbar-wrap 的 900，但自定义 tabBar 是
   **独立渲染树**，真机层叠上下文可能与页面 WebView 不同 —— 展开那一拍被底栏压住，
   会立刻暴露「这是另一个图层新冒出来的弹窗」，破坏「原卡浮起展开」的连续感。
   只在 .morph 期间生效；不传 originRect 的全站其它弹层层级完全不变。 */
.sheet-root.morph { z-index: 1200; }

.sheet-root.morph .sheet-mask {
  opacity: 0;
  transition: opacity .24s cubic-bezier(.22, .61, .36, 1);
}
.sheet-root.morph.morph-show .sheet-mask {
  opacity: 1;
  transition: opacity .24s cubic-bezier(.22, .61, .36, 1);
}
.sheet-root.morph .sheet-drag,
.sheet-root.morph .sheet-spring,
.sheet-root.morph .sheet-footer {
  opacity: 0;
  transition: opacity .24s cubic-bezier(.22, .61, .36, 1);
}
.sheet-root.morph.morph-show .sheet-drag,
.sheet-root.morph.morph-show .sheet-spring,
.sheet-root.morph.morph-show .sheet-footer {
  opacity: 1;
  transition: opacity .24s cubic-bezier(.22, .61, .36, 1);
}

/* v1.0.8.39：卡面淡出与详情淡入不再**同拍**重叠。
   两者都是 240ms 时，中段约 120ms 两套文字都半透明叠在一起，看着像糊成一团；
   让详情晚 80ms 起跑 ⇒ 卡面先退、详情后现，全程只有一个连续的卡轮廓。
   ⚠️ 只写 longhand `transition-delay`，**不碰 transition 简写** ——
      check-popup-anim / check-leave-morph 会扫全文件 `transition: …s`，
      要求时长恒为 .24s；写成 `transition: opacity .12s …` 会直接判死。
   ⚠️ 关闭方向（去掉 .morph-show）无 delay：详情立即淡出、卡面瞬间显形，本身不重叠。 */
.sheet-root.morph.morph-show .sheet-drag,
.sheet-root.morph.morph-show .sheet-spring,
.sheet-root.morph.morph-show .sheet-footer {
  transition-delay: .08s;
}

/* ---- 1.0.8.32：起点帧必须是「那张卡」，不是一块空白玻璃板 ----------------
   1.0.10.7 的翻车点：源卡被 visibility:hidden 藏掉、面板自己从源矩形长开，
   但面板是近白玻璃底 + 内容全淡出 ⇒ 用户看到「原地冒出个白矩形」。
   现在面板里多一层 .sheet-face（具名 slot，内容与源卡共用同一份 WXML），
   由 morphFaceStyle 做 counter-scale 抵消非等比缩放 ⇒ 卡面按源卡尺寸排版、
   放大全程不形变；材质/圆角都由卡面自己的 .card 提供。 */
.sheet-face {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 3;
  pointer-events: none;
  opacity: 0;
  overflow: hidden;
  border-radius: inherit;
  transition: none;
}
/* 起点帧：瞬间贴上卡面，**不能淡入**（否则源卡消失后先空一拍）。 */
.sheet-root.morph .sheet-face {
  opacity: 1;
  transition: none;
}
/* 终点帧：卡面淡出 / 详情淡入，同一拍、同一 240ms、同一曲线。 */
.sheet-root.morph.morph-show .sheet-face {
  opacity: 0;
  transition: opacity .24s cubic-bezier(.22, .61, .36, 1);
}
/* 转场期面板不带白色玻璃底，让卡面的 .card 材质透出来；终点帧长回 sheet 材质。
   background 已被 morphInline 纳入 240ms 过渡（见 utils/morph.js），不会中途闪白。 */
.sheet-root.morph .sheet-panel {
  background: transparent;
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
  box-shadow: none;
}
.sheet-root.morph.morph-show .sheet-panel {
  background: var(--sheet-bg, rgba(255, 255, 255, 0.72));
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  backdrop-filter: blur(24px) saturate(180%);
}
