/* 值日详情弹层的内容样式（v0.7.32：外壳已并入 components/bottom-sheet，
   这里只留「面板内部」的东西 —— 遮罩 / 面板 / 头部 / 指示条 / 开合动画都在那边，
   所以本文件不再有 .ds-root / .ds-mask / .ds-panel / .ds-head / .ds-handle / .ds-body）。 */

/* 内容区（原 .ds-body 的内边距搬到这里） */
.ds-content { padding: 24rpx 32rpx; }

.ds-main {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.ds-main-info { margin-left: 24rpx; flex: 1; min-width: 0; }
.ds-name { font-size: 34rpx; font-weight: 600; color: var(--text-1); margin-right: 12rpx; }
.ds-sub { margin-top: 4rpx; font-size: 24rpx; color: var(--text-3); }
.ds-block { margin-top: 32rpx; }
.ds-block-title { font-size: 26rpx; color: var(--text-2); margin-bottom: 16rpx; }
.ds-peers { display: flex; flex-direction: row; flex-wrap: wrap; }
.ds-peer {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 0 16rpx 12rpx 0;
}
.ds-peer-name { margin: 0 12rpx; font-size: 26rpx; color: var(--text-1); }
.ds-log {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 8rpx 0;
}
.ds-log-text { margin-left: 12rpx; flex: 1; font-size: 24rpx; color: var(--text-2); }
.ds-log-time { font-size: 22rpx; color: var(--text-4); }
.ds-cand {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx;
  border-radius: 32rpx;
  background: var(--fill-soft);
  margin-bottom: 16rpx;
}
.ds-cand.on { background: var(--brand-light); }
/* 姓名一行、「值日 N 次」另起一行：不写 flex-direction:column 的话两者是同一行的行内元素，
   「值日」的起始位置会随姓名长短左右漂移（2 字名 / 3 字名对不齐）。 */
.ds-cand-info {
  margin-left: 20rpx;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.ds-cand-name { font-size: 30rpx; color: var(--text-1); }
.ds-cand-sub { font-size: 24rpx; color: var(--text-3); }
/* 「值日 N 次」三段对齐：中间数字占固定宽度并居中，单位数↔双位数不改变两侧文字的位置。 */
.cnt-num { display: inline-block; min-width: 46rpx; text-align: center; }
.ds-chips { display: flex; flex-direction: row; flex-wrap: wrap; }
.ds-chip {
  height: 64rpx;
  padding: 0 24rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 32rpx;
  background: var(--bg-fill);
  color: var(--text-2);
  font-size: 26rpx;
  line-height: 64rpx;
}
.ds-chip.on {
  background: var(--brand-light);
  color: var(--brand);
  font-weight: 600;
  border: 2rpx solid var(--brand);
}
.ds-dates { display: flex; flex-direction: row; }
.ds-date {
  width: 310rpx;
  height: 96rpx;
  margin-right: 14rpx;
  border-radius: 40rpx;
  background: var(--fill-soft);
  font-size: 28rpx;
  color: var(--text-1);
  display: flex;
  align-items: center;
  justify-content: center;
}
.ds-none { padding: 16rpx 0; }

/* 底部操作条：容器（padding + 上边框）由 bottom-sheet 的 .sheet-footer 提供，
   这里只管按钮排布 + 让开底部悬浮胶囊 tabBar 的额外留白。
   无安全区机型（安卓）兜底 32px（同 TABBAR_LIFT_PX）；前一行是回退（老引擎丢 max() 整条声明）。 */
.ds-foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-bottom: calc(114rpx + env(safe-area-inset-bottom));
  padding-bottom: calc(114rpx + max(env(safe-area-inset-bottom), 32px));
}
.ds-btn {
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 16rpx;
}
.ds-btn:last-child { margin-right: 0; }
.ds-btn.primary { flex: 1; background: var(--brand); color: #FFFFFF; font-weight: 600; }
.ds-btn.ghost { background: var(--bg-fill); color: var(--text-2); }
.ds-btn.danger { background: var(--danger-bg); color: var(--danger); }
.ds-btn:active { opacity: 0.8; }
