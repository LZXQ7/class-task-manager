<!-- 防滚动穿透（v0.7.9）：弹层里的 scroll-view 滑到下沿后，touchmove 会继续冒泡给 page，
     「在弹层里滑到底 → 后面的页面跟着一起滑」就是这么来的。
     page-meta 的 page-style 是官方/社区验证的锁页面滚动方案（Vant Weapp 的 popup 同款）。
     ⚠️ 新增 / 改名的弹层 show 标志必须同步进下面表达式，否则 scripts/check-scroll-lock.js 会报错。 -->
<page-meta page-style="{{(appShow || aboutShow || anncShow || aiShow || dutyListShow || moreShow || feeTotalShow) ? 'overflow:hidden' : ''}}"></page-meta>

<view class="page mn {{paReady ? (animSeq === 0 ? 'pa-first' : (animSeq === 1 ? 'pa-lite-a' : 'pa-lite-b')) : 'pa-hold'}} {{tClass}}">

  <!-- NavBar（fixed 默认开）：移出 spring-scroll，否则被 .ss-content 的 transform 建立包含块、固定定位失效（v0.7.19 修）
       ⚠️ id="mnNav"：页面内的「外观」设置项要复用 nav-bar 的圆形揭示 overlay（同一个组件实例），
          selectComponent 靠这个 id 拿 —— 两条切换入口的动效必须一致，不能一个动一个不动。 -->
  <nav-bar id="mnNav" title="我的" />

  <!-- 「切换测试账号」模拟态护栏（v1.0.5）：必须在 spring-scroll 之外，
       否则被 .ss-content 的 transform 建立包含块，且会跟着内容一起滚走。 -->
  <notice-bar
    wx:if="{{impersonateBanner}}"
    type="danger"
    icon="info"
    text="{{impersonateBanner}}"
    btnText="恢复本人"
    bind:action="onRecoverSelf"
  />


  <!-- 主内容滚动（v0.7.19 需求④）：spring-scroll 提供边界阻尼回弹；flex:1 填满导航栏以下区域 -->
  <spring-scroll style="display:block;flex:1;min-height:0" class="mn-scroll" id="mineMain" bindrefresh="onRefresh">

  <!-- 用户信息 -->
  <view class="mn-user st-item st-1">
    <!-- 头像位（2026-10-18 第二次修正：button 彻底退出文档流；2026-10-30 改为选本地图设为头像）。
         🔴 两次真机实测结论：<button open-type="chooseAvatar"> **只要参与布局**，真机就会按
            「内容宽 + 默认 padding」撑出约 121rpx 的空框 —— 内放 avatar-tag 时头像还被渲染到
            按钮右侧外面（右移约 87px）；换成内置 <image> 后空框依旧在，头像仍被顶到框右边。
            表现就是用户说的「头像占位太大 / 头像要往左」。
         ✅ 根治结构：.avatar-slot 是 80rpx 定宽槽位（relative），头像图与姓氏回落块作为**普通子节点**
            贴左渲染；<button> **留空** + absolute 铺满槽位，只当点击层（现 bindtap 唤起 wx.chooseMedia 选图）。
            按钮不占文档流 ⇒ 撑不大、推不动任何兄弟元素，头像必然贴左，信息区紧邻其后。 -->
    <view class="avatar-slot">
      <image
        wx:if="{{profile && profile.avatarUrl && profile.avatarUrl !== avatarErrSrc}}"
        class="avatar-img"
        src="{{profile.avatarUrl}}"
        mode="aspectFill"
        lazy-load="{{true}}"
        binderror="onAvatarImgError"
      />
      <view wx:else class="avatar-fallback">{{avatarChar}}</view>
      <!-- 空按钮（必须留空，任何子节点都会把按钮重新撑大）：点击从相册/拍摄选一张图设为头像 -->
      <button class="avatar-btn" bindtap="onPickAvatar"></button>
    </view>
    <view class="mn-user-info">
      <view class="mn-user-line">
        <text class="mn-user-name">{{profile ? profile.name : '未绑定'}}</text>
        <view wx:if="{{profile}}" class="mn-bind">{{demo ? '体验中' : '已绑定'}}</view>
      </view>
      <text class="mn-user-sub">
        {{profile ? (profile.groupTag === 'X' ? '辅导员' : profile.studentNoMasked + ' · ' + profile.groupTag + ' 组') : '绑定后可查看班级值日'}}
      </text>
    </view>
    <!-- 职位头衔（超管金 / 班委蓝 / 辅导员青，明显阶级区分）：来自 profile.position -->
    <view wx:if="{{selfTag}}" class="mn-admin {{selfTier}}">{{selfTag}}</view>
  </view>

  <!-- 统计（v0.7.17 需求⑤）：辅导员不参与值日，「本学期 / 待值日 / 已结束」对他全是 0，
       留着只是噪声。整块对辅导员不渲染。 -->
  <view wx:if="{{stats && !isCounselor}}" class="mn-stat card st-item st-2">
    <view class="mn-stat-cell">
      <text class="mn-num">{{stats.termCount}}</text>
      <text class="mn-label">本学期</text>
    </view>
    <view class="mn-stat-cell tappable" bindtap="onShowDutyList" data-type="pending" hover-class="tap-hover" hover-start-time="0" hover-stay-time="60">
      <text class="mn-num {{stats.pendingCount > 0 ? 'warn' : ''}}">{{stats.pendingCount}}</text>
      <text class="mn-label">待值日</text>
      <view class="mn-stat-go">›</view>
    </view>
    <view class="mn-stat-cell tappable" bindtap="onShowDutyList" data-type="past" hover-class="tap-hover" hover-start-time="0" hover-stay-time="60">
      <text class="mn-num">{{stats.expiredCount}}</text>
      <text class="mn-label">已结束</text>
      <view class="mn-stat-go">›</view>
    </view>
  </view>

  <!-- 通知入口（v0.7.22 需求④）：只保留首页一处，「我的」页不再有通知栏
       （角标 / 列表缓存的拉取也随之下线，缓存由首页继续写入） -->

  <!-- 管理 -->
  <view wx:if="{{isAdmin || switched}}" class="card mn-card st-item st-3">
    <!-- 换班确认权在生活委员：成员提交的申请都在这里拍板 -->
    <view wx:if="{{isSuper}}" class="mn-row" hover-class="tap-hover" hover-start-time="0" hover-stay-time="60" bindtap="openApps">
      <app-icon name="bell" variant="brand" size="{{40}}" />
      <text class="mn-row-text">换班待确认</text>
      <view wx:if="{{pendingCount}}" class="mn-badge">{{pendingCount}}</view>
      <app-icon name="arrow-right" variant="gray" size="{{32}}" />
    </view>
    <!-- 发送更新公告（v0.7.25，仅超管）：全员主页弹窗、每人仅展示一次 -->
    <view wx:if="{{isSuper}}" class="mn-row" hover-class="tap-hover" hover-start-time="0" hover-stay-time="60" bindtap="openAnnc">
      <app-icon name="bell" variant="brand" size="{{40}}" />
      <text class="mn-row-text">发送更新公告</text>
      <app-icon name="arrow-right" variant="gray" size="{{32}}" />
    </view>
    <!-- 「更多」（2026-10-14 需求①）：低频的管理 / 设置类入口收进这里，让「我的」页保持干净。
         原本平铺在本卡的 4 项（切换测试账号 / 班级绑定入口 / 手动排班 / AI 排班设置）
         加上从首页班费弹层迁来的「班费总额 / 团费总额」都在弹层里，权限与行为**完全不变**。
         ⚠️ 可见性 = showMore（任一相关能力的持有者），不是 isAdmin ——
            生活委员（canSchedule）、班长兼团支书（团费设置权）都要能看到，
            而普通班委（无上述任一能力）不该看到一个空的弹层。
         ⚠️ 弹层内的各行再按原权限二次控制，别指望外层兜底。 -->
    <view wx:if="{{showMore}}" class="mn-row" hover-class="tap-hover" hover-start-time="0" hover-stay-time="60" bindtap="onMoreOpen">
      <app-icon name="more" variant="gray" size="{{40}}" />
      <text class="mn-row-text">更多</text>
      <app-icon name="arrow-right" variant="gray" size="{{32}}" />
    </view>
    <!-- 体验版演示态 →「返回登录页」（口令页）（2026-10-29）：清演示身份 → 未绑定 → 回口令页。
         仅 `demo && isTrial` 显示；超管正式版的演示态退出仍走「更多 → 切换正式版」。 -->
    <view wx:if="{{demo && isTrial}}" class="mn-row" hover-class="tap-hover" hover-start-time="0" hover-stay-time="60" bindtap="onBackToLogin">
      <app-icon name="logout" variant="gray" size="{{40}}" />
      <text class="mn-row-text">返回登录页</text>
      <app-icon name="arrow-right" variant="gray" size="{{32}}" />
    </view>
    </view>

  <!-- 外观（深色模式 C-4）：二级页没有 nav-bar 左上角的切换按钮（那里是返回键的地盘），
       所以「我的」页给一份完整的三态入口 —— 按钮只能循环，看不出当前是哪一档，
       也无法直接回到「跟随系统」。切换走 nav-bar 的 applyTheme（圆形揭示动效与按钮完全一致）。
       ⚠️ 本卡是 st-4，「关于」顺延到 st-5；st-item 档位必须从 st-1 连续，check-tab-enter 会验。
       ⚠️ 2026-10-07：`wx:if="{{themeEnabled}}"` —— 深色模式总开关关闭时整卡不渲染。
           档位号**保持 st-4 不变**（不重新编号）：check-tab-enter 是源码静态扫描，
           隐藏后 st-1..st-5 照样连续；代价是运行时「关于」会晚一档入场（一个 ST_STEP_MS，
           约 60ms），只在开关关闭期间存在，可接受 —— 重新编号会让恢复开关时布局顺序跳变。 -->
  <view wx:if="{{themeEnabled}}" class="card mn-card st-item st-4">
    <view
      wx:for="{{themeOpts}}"
      wx:key="key"
      class="appear-opt"
      data-k="{{item.key}}"
      bindtap="onThemePick"
      hover-class="tap-hover"
      hover-start-time="0"
      hover-stay-time="60"
    >
      <view class="appear-radio {{themeMode === item.key ? 'on' : ''}}"></view>
      <view class="appear-txt">
        <view class="appear-t">{{item.text}}</view>
        <view class="appear-d">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="card mn-card st-item st-5">
    <view class="mn-row" hover-class="tap-hover" hover-start-time="0" hover-stay-time="60" bindtap="onAbout">
      <app-icon name="info" variant="brand" size="{{40}}" />
      <text class="mn-row-text">关于</text>
      <app-icon name="arrow-right" variant="gray" size="{{32}}" />
    </view>
  </view>

  <view class="mn-unbind-hint">如需解绑，请联系班级管理员手动处理</view>
  <view class="mn-foot"></view>
  </spring-scroll>

  <!-- 我的申请（排班负责人这里同时是「待我确认」的处理台） -->
  <bottom-sheet show="{{appShow}}" title="待确认" bind:close="onAppClose">
    <!-- 排班域（需求 D：超管 | 本班生活委员）：全班待拍板的换班申请 -->
    <block wx:if="{{canSchedule && pendingSwaps.length}}">
      <view class="ap-sect">待我确认 · {{pendingSwaps.length}}</view>
      <view wx:for="{{pendingSwaps}}" wx:key="swapId" class="ap-item pending">
        <avatar-tag name="{{item.fromName}}" size="{{72}}" />
        <view class="ap-info">
          <view class="ap-title">{{item.fromName}} → {{item.toName || '未指定'}}</view>
          <!-- v0.7.25：超管待确认列表跨班可见 —— 条目带班名，多班申请不再混淆 -->
          <view class="ap-sub">{{item.className ? item.className + ' · ' : ''}}{{item.classDate}} {{item.whenText}} · {{item.courseName}}</view>
        </view>
        <view class="ap-actions">
          <view class="ap-btn" data-id="{{item.swapId}}" bindtap="onPendingReject">拒绝</view>
          <view class="ap-btn primary" data-id="{{item.swapId}}" bindtap="onPendingAgree">同意</view>
        </view>
      </view>
      <view class="ap-sect">我的申请</view>
    </block>

    <block wx:if="{{apps.length}}">
      <view wx:for="{{apps}}" wx:key="swapId" class="ap-item">
        <avatar-tag name="{{item.direction === 'out' ? item.toName || item.fromName : item.fromName}}" size="{{72}}" />
        <view class="ap-info">
          <view class="ap-title">
            {{item.type === 'LEAVE' ? '请假' : '换班'}} ·
            {{item.classDate}} {{item.whenText}}
            <block wx:if="{{item.type !== 'LEAVE' && item.toName}}"> → {{item.toName}}</block>
          </view>
          <view class="ap-sub">
            提交于 {{item.createdAt}} · {{item.reasonText || '其他'}}
          </view>
        </view>
        <view class="ap-status" style="color:{{item.statusFg || '#86909C'}};background:{{item.statusBg || '#F2F3F5'}}">
          {{item.statusText || '已撤销'}}
        </view>
        <!-- 换班的确认权在生活委员：成员只能撤销自己的申请；超管在这里也能直接拍板 -->
        <view class="ap-actions" wx:if="{{item.canAgree || item.canCancel}}">
          <view wx:if="{{item.canAgree}}" class="ap-btn" data-id="{{item.swapId}}" bindtap="onSwapReject">拒绝</view>
          <view wx:if="{{item.canAgree}}" class="ap-btn primary" data-id="{{item.swapId}}" bindtap="onSwapAgree">同意</view>
          <view wx:if="{{item.canCancel}}" class="ap-btn" data-id="{{item.swapId}}" bindtap="onSwapCancel">撤销</view>
        </view>
      </view>
    </block>
    <empty-state wx:elif="{{!pendingSwaps.length}}" icon="empty-box" title="暂无申请记录" desc="需要调整值日时可在值日详情里发起" padding="{{80}}" />
  </bottom-sheet>

  <!-- 关于 P8 -->
  <bottom-sheet show="{{aboutShow}}" title="关于" bind:close="onAboutClose">
    <view class="ab-wrap">
      <view class="ab-logo"><app-icon name="logo" variant="brand" size="{{96}}" /></view>
      <view class="ab-name">班级任务管理</view>
      <view class="ab-ver">Version {{appVersion}}</view>

      <view class="ab-card">
        <view class="ab-row" hover-class="tap-hover" hover-start-time="0" hover-stay-time="60" bindtap="onAgreement"><text>用户协议</text><app-icon name="arrow-right" variant="gray" size="{{32}}" /></view>
        <view class="ab-row" hover-class="tap-hover" hover-start-time="0" hover-stay-time="60" bindtap="onPrivacy"><text>隐私政策</text><app-icon name="arrow-right" variant="gray" size="{{32}}" /></view>
      </view>

      <!-- ICP 备案号（2026-10-12 备案通过后展示）：合规要求「真实展示 + 主色加下划线 + 可点击」。
           小程序**不能**用 web-view 打开工信部域名（非自有域名、无法配业务域名）
           ⇒ 点击 = 复制工信部查询地址（见 pages/mine 的 onIcp），用户可自行粘贴核对。 -->
      <view class="ab-icp" hover-class="tap-hover" hover-start-time="0" hover-stay-time="60" bindtap="onIcp">
        <text class="ab-icp-l">ICP 备案号</text>
        <text class="ab-icp-v">{{icpNo}}</text>
      </view>

      <view class="ab-foot">
        <text>本工具为开源示例项目，仅用于班级内部值日安排</text>
        <text>数据存储于腾讯云 CloudBase（中国大陆境内）；不涉及支付与广告</text>
        <text>信息处理方式详见《隐私政策》</text>
      </view>
    </view>
  </bottom-sheet>

  <!-- 发送更新公告（v0.7.25→改，仅超管）：版本号自动取 APP_VERSION、标题固定「版本更新公告」，超管只填更新内容 -->
  <bottom-sheet show="{{anncShow}}" title="发送更新公告" bind:close="onAnncClose">
    <view class="an-wrap">
      <view class="an-tip">将向全员推送「版本更新公告」（v{{appVersion}}），无需手填版本号与标题。</view>
      <view class="an-field">
        <text class="an-label">更新内容</text>
        <textarea class="an-textarea" value="{{anncContent}}" maxlength="2000" placeholder="一行一条，写这次更新了什么…" placeholder-class="f-ph" bindinput="onAnncContent" />
      </view>
      <view class="an-tip">发送后：所有人下次打开小程序时主页弹窗展示一次，看过不再弹</view>
      <view class="an-btn {{anncBusy ? 'busy' : ''}}" bindtap="onAnncSend">{{anncBusy ? '发送中…' : '发送公告'}}</view>
    </view>
  </bottom-sheet>

  <!-- 需求 D：AI 排班设置（自带密钥，跟随本人） -->
  <bottom-sheet show="{{aiShow}}" title="AI 排班设置" bind:close="onAiClose">
    <view class="an-wrap">
      <view class="an-tip">填写你自己的大模型接口与密钥，AI 生成值日表时使用「你」的额度。密钥只存一份、不会回显，保存即覆盖。</view>

      <view class="an-field">
        <text class="an-label">常用接口预设（点一下自动填好地址与默认模型）</text>
        <view class="an-presets">
          <view class="an-preset {{aiProvider === 'deepseek' ? 'on' : ''}}" data-p="deepseek" bindtap="onAiPreset">DeepSeek</view>
          <view class="an-preset {{aiProvider === 'glm' ? 'on' : ''}}" data-p="glm" bindtap="onAiPreset">智谱 GLM</view>
          <view class="an-preset {{aiProvider === 'qwen' ? 'on' : ''}}" data-p="qwen" bindtap="onAiPreset">通义千问</view>
        </view>
      </view>

      <view class="an-field">
        <text class="an-label">接口地址（可留空）</text>
        <input class="an-input" value="{{aiBaseUrl}}" placeholder="留空=官方默认 https://api.deepseek.com" placeholder-class="f-ph" bindinput="onAiBaseUrl" />
      </view>
      <view class="an-field">
        <text class="an-label">模型名（可留空；填了密钥点「获取」从服务商拉列表）</text>
        <view class="an-model-row">
          <input class="an-input" value="{{aiModel}}" placeholder="留空=默认 deepseek-chat" placeholder-class="f-ph" bindinput="onAiModel" />
          <view class="an-fetch {{aiBusy ? 'busy' : ''}}" bindtap="onAiFetchModels">获取</view>
        </view>
        <scroll-view wx:if="{{aiModels.length}}" scroll-y class="an-models-scroll">
          <view class="an-models-hint">点击选择模型（共 {{aiModels.length}} 个）</view>
          <view wx:for="{{aiModels}}" wx:key="*this" class="an-model {{aiModel === item ? 'on' : ''}}" data-m="{{item}}" bindtap="onPickModel">{{item}}</view>
        </scroll-view>
      </view>
      <view class="an-field">
        <text class="an-label">密钥</text>
        <input class="an-input" password="{{true}}" value="{{aiKey}}" placeholder="{{aiKeyMask ? '已保存 ' + aiKeyMask + '，留空则不改' : 'sk-…'}}" placeholder-class="f-ph" bindinput="onAiKey" />
      </view>

      <view wx:if="{{aiConfigured && !aiKey}}" class="an-tip">当前已保存：{{aiKeyMask}}（不填密钥保存则保持原值不变）</view>
      <view wx:if="{{aiTestResult}}" class="an-tip">{{aiTestResult}}</view>

      <!-- 左右并排一行：次行动（描边）在左，主行动（实心）在右 -->
      <view class="an-actions">
        <view class="an-btn ghost {{aiBusy ? 'busy' : ''}}" bindtap="onAiTest">{{aiBusy ? '测试中…' : '测试连通'}}</view>
        <view class="an-btn {{aiBusy ? 'busy' : ''}}" bindtap="onAiSave">{{aiBusy ? '保存中…' : '保存'}}</view>
      </view>
      <view wx:if="{{aiConfigured}}" class="an-tip" bindtap="onAiClear">清除我的密钥（清除后无法恢复，需重新填写）</view>
    </view>
  </bottom-sheet>

  <!-- 值日明细（需求：「待值日 / 已结束」数字可点开查看具体条目；只读清单，不可点） -->
  <bottom-sheet show="{{dutyListShow}}" title="{{dutyListTitle}}" tall bind:close="onDutyListClose">
    <view class="dl">
      <view wx:if="{{dutyListLoading}}" class="dl-loading">加载中…</view>
      <view wx:elif="{{!dutyList.length}}" class="dl-empty">暂无相关值日</view>
      <view wx:for="{{dutyList}}" wx:key="id" class="dl-item">
        <view class="dl-date">{{item.classDate}}</view>
        <view class="dl-info">
          <view class="dl-line1">
            <text class="dl-course">{{item.courseName}}</text>
            <text class="dl-tag {{item.statusCls}}">{{item.statusText}}</text>
          </view>
          <view class="dl-line2">{{item.periodText}} · {{item.room || '未填教室'}}{{item.groupScope ? ' · ' + item.groupScope + ' 组' : ''}}</view>
        </view>
      </view>
    </view>
  </bottom-sheet>

  <!-- ============ 更多（2026-10-14 需求①）============
       低频的管理 / 设置类入口收在这里，让「我的」页保持干净。每一项的行为与原先平铺时
       **完全一致**（沿用各自的 handler 与权限 wx:if），只是换了容器。
       ⚠️ 会二次开弹层的两项（AI 排班设置 / 切换测试账号）：先关本弹层再开对应弹层 ——
          两个弹层同时显示会互相串触摸事件，也别指望用户在半透明背景上点。
       ⚠️ 跳页的那项（手动排班）同样先关；「班级绑定入口」是开关型，原地生效不用关。 -->
  <bottom-sheet show="{{moreShow}}" title="更多" bind:close="onMoreClose">
    <view class="mn-more">
      <!-- 切换测试账号（仅超管）：一键换到测试身份验证不同角色视角。
           模拟态下的「恢复本人」由顶部红色护栏条统一承担（v1.0.5）。 -->
      <view wx:if="{{isSuper}}" class="mn-row" hover-class="tap-hover" hover-start-time="0" hover-stay-time="60" bindtap="onMoreSwitch">
        <app-icon name="people" variant="brand" size="{{40}}" />
        <text class="mn-row-text">切换测试账号</text>
        <app-icon name="arrow-right" variant="gray" size="{{32}}" />
      </view>
      <!-- 切换体验版 / 切换正式版（2026-10-29，仅超管）：一键 impersonate 到演示班 104 超管（全虚拟数据），
           无需第二账号、不解绑真实账号。**不显示顶部「模拟中」横幅**（避免打扰演示体验），
           改为本按钮在「切换体验版 ⇄ 切换正式版」之间切换文案来承担退出入口：
             · demo=false（正式版态）→ 文案「切换体验版」，点击进入演示态；
             · demo=true （演示态）  → 文案「切换正式版」，点击 recover 退出演示态（reLaunch 回首页）。
           与「切换测试账号」共用同一个 impersonation 行（互斥），故二者不会同时生效；
           切换测试账号的顶部「模拟中」横幅行为保持不变。 -->
      <view wx:if="{{isSuper}}" class="mn-row" hover-class="tap-hover" hover-start-time="0" hover-stay-time="60" bindtap="onMoreSwitchDemo">
        <app-icon name="swap" variant="brand" size="{{40}}" />
        <text class="mn-row-text">{{demo ? '切换正式版' : '切换体验版'}}</text>
        <app-icon name="arrow-right" variant="gray" size="{{32}}" />
      </view>
      <!-- 绑定入口开关（仅超管）：防爆破自动锁死或开学季统一开放时用 -->
      <view wx:if="{{isSuper}}" class="mn-row" hover-class="tap-hover" hover-start-time="0" hover-stay-time="60" bindtap="onToggleBind">
        <app-icon name="lock" variant="brand" size="{{40}}" />
        <text class="mn-row-text">班级绑定入口</text>
        <view class="mn-mini-tag {{bindOpen ? 'ok' : 'warn'}}">{{bindOpen ? '开放中' : '已关闭'}}</view>
        <app-icon name="arrow-right" variant="gray" size="{{32}}" />
      </view>
      <view wx:if="{{canSchedule}}" class="mn-row" hover-class="tap-hover" hover-start-time="0" hover-stay-time="60" bindtap="onMoreManual">
        <app-icon name="grid" variant="brand" size="{{40}}" />
        <text class="mn-row-text">手动排班</text>
        <view class="mn-mini-tag super">排班</view>
        <app-icon name="arrow-right" variant="gray" size="{{32}}" />
      </view>
      <!-- AI 排班设置：自带密钥（跟随本人，不是班）。密钥只回掩码，保存即覆盖，不回显明文 -->
      <view wx:if="{{canSchedule}}" class="mn-row" hover-class="tap-hover" hover-start-time="0" hover-stay-time="60" bindtap="onMoreAi">
        <app-icon name="settings" variant="brand" size="{{40}}" />
        <text class="mn-row-text">AI 排班设置</text>
        <view wx:if="{{aiConfigured}}" class="mn-mini-tag ok">已配置</view>
        <app-icon name="arrow-right" variant="gray" size="{{32}}" />
      </view>
      <!-- 班费 / 团费总额（2026-10-14 需求②；2026-10-15 两行合并为一行）：
           点进去用「班费 ⇄ 团费」分段滑动切换（与值日页按日/按人同一个 segmented 组件，
           动效完全一致），在同一张弹层里分别改两个总额。
           权限 = 任一设置权（班费超管/生活委员；团费超管/班长兼团支书），
           弹层里只出现有权的那几档；只有一档时不渲染分段控件、直接编辑。 -->
      <view wx:if="{{showFeeTotalRow}}" class="mn-row" hover-class="tap-hover" hover-start-time="0" hover-stay-time="60" bindtap="onFeeTotalOpen">
        <app-icon name="tag" variant="brand" size="{{40}}" />
        <text class="mn-row-text">班/团费总额</text>
        <text class="mn-row-done">{{feeTotalRowText}}</text>
        <app-icon name="arrow-right" variant="gray" size="{{32}}" />
      </view>
    </view>
  </bottom-sheet>

  <!-- ============ 班费 / 团费总额（2026-10-15 改版）============
       「更多」一行入口进来后，用**分段控件**在班费 ⇄ 团费之间滑动切换
       （与值日页「按日/按人」同一个 segmented 组件，滑块动效完全一致），
       下面是当前档的总额编辑框。只渲染你有设置权的档位；
       只有一档时不渲染分段控件、直接编辑，避免出现一个不可点的假开关。 -->
  <bottom-sheet show="{{feeTotalShow}}" title="班/团费总额" bind:close="onFeeTotalClose">
    <view class="an-wrap">
      <view class="an-tip">班费由微信收取，这里登记「收缴总额」；余额 = 总额 − 已消费明细合计，改这里不需要重排任何记录。</view>
      <view wx:if="{{feeTotalTabs.length > 1}}" class="an-field">
        <segmented items="{{feeTotalTabs}}" value="{{feeTotalType}}" width="{{686}}" bind:change="onFeeTotalTab" />
      </view>
      <view class="an-field">
        <text class="an-label">{{feeTotalType === 'league' ? '团费' : '班费'}}总额（元）· 当前 ¥{{feeTotalCurrentText}}</text>
        <input class="an-input" type="digit" value="{{feeTotalType === 'league' ? feeInputLeague : feeInputClass}}" placeholder="例如：500" placeholder-class="f-ph" bindinput="onFeeTotalInput" />
      </view>
      <view class="an-actions">
        <view class="an-btn ghost" bindtap="onFeeTotalClose">取消</view>
        <view class="an-btn {{feeTotalBusy ? 'busy' : ''}}" bindtap="onFeeTotalSave">{{feeTotalBusy ? '保存中…' : '保存'}}</view>
      </view>
    </view>
  </bottom-sheet>

</view>
