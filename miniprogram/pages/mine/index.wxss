/* P7 · 我的 */
.mn {
  padding-bottom: 40rpx;
  /* 主内容滚动交给 spring-scroll（v0.7.19 需求④）；根不再原生滚动 */
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.mn-scroll { display: block; }

/* 用户信息 */
.mn-user {
  display: flex;
  align-items: center;
  margin: 24rpx 32rpx 0;
  padding: 32rpx;
  /* 玻璃材质，与全站卡片统一（v0.7.19 需求③） */
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-edge);
  border-radius: 40rpx;
  box-shadow: var(--glass-shadow), var(--glass-highlight);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
}
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  /* 深色下走 --bg-card（= #1C2027），不能写死白底 —— 不支持模糊的安卓机上会是一整块白 */
  .mn-user { background: var(--bg-card, rgba(255, 255, 255, 0.9)); }
}
@media (prefers-reduced-transparency: reduce) {
  .mn-user { background: var(--bg-card); -webkit-backdrop-filter: none; backdrop-filter: none; }
}
.mn-user-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}
.mn-user-line {
  display: flex;
  align-items: center;
}
.mn-user-name {
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: 600;
  color: var(--text-1);
}
.mn-bind {
  margin-left: 12rpx;
  padding: 0 12rpx;
  height: 36rpx;
  line-height: 36rpx;
  font-size: 20rpx;
  color: var(--success);
  background: var(--success-bg);
  border-radius: 999rpx;
}
.mn-user-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--text-3);
}
.mn-admin {
  padding: 0 16rpx;
  height: 44rpx;
  line-height: 44rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--brand);
  background: var(--brand-light);
  border-radius: 999rpx;
}
/* 超管：标黄区分普通管理员 */
.mn-admin.super {
  color: var(--warning-strong);
  background: var(--warning-bg);
}
/* 班委（蓝，与 .mn-admin 默认一致）；辅导员（青） */
.mn-admin.committee {
  color: var(--brand);
  background: var(--brand-light);
}
.mn-admin.counselor {
  color: #0AA5A8;
  background: var(--success-bg);
}
/* 头像位（2026-10-18 第二次修正：button 退出文档流）。
   🔴 真机两次实测：<button open-type="chooseAvatar"> **只要参与布局**，就会被撑成
      「内容宽 + 默认 padding」≈121rpx 的空框，并把头像顶到框外右侧（用户报「头像占位太大」）。
      2026-10-16 的「button 直接包裹头像」与 2026-10-18 的「button 内只放内置 image」都治不了：
      框的宽度由 button 自身的盒模型决定，与里面放什么无关。
   ✅ 现结构：.avatar-slot（定宽 relative）+ 正常流里的头像图/回落块 + **留空**的
      absolute button。button 不占文档流 ⇒ 撑不大也推不动兄弟元素。
   ✅ 2026-10-18(3) 用户要求「大一点、上端齐姓名、下端齐学号、圆形」：信息区高度 =
      姓名 line-height 56 + 学号 margin-top 6 + line-height 34 = 96rpx，故头像定 96rpx 圆，
      与 .mn-user（align-items:center）等高 ⇒ 上下自然对齐。 */
.avatar-slot {
  position: relative;
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  margin: 0;
  padding: 0;
}
/* 圆形头像图（与 avatar-tag 组件的 .avatar-img 同规格：96rpx 圆 + 灰底） */
.avatar-slot .avatar-img {
  display: block;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--bg-fill);
}
/* 无头像 / 头像加载失败：姓氏色块（底 #F0F5FF、字 #3370FF；无姓名时显示「?」，
   与组件 firstChar 一致；96rpx 圆下字号取 38rpx 居中） */
.avatar-slot .avatar-fallback {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--brand-light);
  color: var(--brand);
  font-size: 38rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
/* 空的透明按钮：绝对铺满槽位，只当「选图设头像」点击层（不参与布局 ⇒ 不会撑大占位）。
   🔴 必须 position:absolute + 显式 0/0 + 96rpx：一旦回到文档流，121rpx 空框立刻复现。 */
.avatar-btn {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 2;
  width: 96rpx;
  height: 96rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 50%;
  font-size: 0;
  line-height: 1;
  overflow: hidden;
  box-sizing: border-box;
}
.avatar-btn::after {
  border: none;
}

/* 统计 */
.mn-stat {
  display: flex;
  margin: 24rpx 32rpx 0;
  padding: 28rpx 0;
}
.mn-stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}
.mn-stat-cell + .mn-stat-cell::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 2rpx;
  background: var(--bg-fill);
}
.mn-num {
  font-size: 48rpx;
  line-height: 60rpx;
  font-weight: 700;
  color: var(--text-1);
}
.mn-num.warn {
  color: var(--warning);
}
.mn-label {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--text-3);
}
/* 待值日 / 已结束 可点开明细（需求）：点击查看具体值日条目；本学期为纯展示不可点 */
.mn-stat-cell.tappable {
  cursor: pointer;
}
.mn-stat-go {
  position: absolute;
  top: 6rpx;
  right: 14rpx;
  font-size: 28rpx;
  line-height: 1;
  color: var(--text-4);
}
.mn-stat-cell.tappable:active .mn-num,
.mn-stat-cell.tappable:active .mn-label {
  opacity: 0.6;
}

/* 卡片组 */
.mn-card {
  margin: 24rpx 32rpx 0;
}
/* 「更多」弹层的行容器：行本身复用 .mn-row（含 .mn-row + .mn-row 的分隔线），
   这里只补弹层内的上下留白，别再抄一份行样式过来。 */
.mn-more {
  padding: 8rpx 0 32rpx;
}
.mn-row {
  display: flex;
  align-items: center;
  height: 112rpx;
  padding: 0 32rpx;
  position: relative;
}
.mn-row + .mn-row::before {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 0;
  top: 0;
  height: 2rpx;
  background: var(--bg-fill);
}
.mn-row-text {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  font-size: 30rpx;
  line-height: 44rpx;
  color: var(--text-1);
}
.mn-row-done {
  font-size: 26rpx;
  color: var(--text-3);
}
.mn-mini-btn {
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #FFFFFF;
  background: var(--brand);
  border-radius: 999rpx;
}
.mn-mini-btn:active {
  background: var(--brand-press);
}
.mn-mini-tag {
  padding: 0 12rpx;
  height: 36rpx;
  line-height: 36rpx;
  font-size: 20rpx;
  color: var(--brand);
  background: var(--brand-light);
  border-radius: 16rpx;
}
/* 「模拟中」橙色变体（切换测试账号时显示） */
.mn-mini-tag.warn {
  color: var(--warning);
  background: var(--warning-bg);
}
/* 「绑定入口开放中」绿色小标签 */
.mn-mini-tag.ok {
  color: var(--success);
  background: var(--success-bg);
}
/* 仅超管可见的入口（如手动排班）用金色标 */
.mn-mini-tag.super {
  color: var(--warning-strong);
  background: var(--warning-bg);
}
/* 班委（蓝）/ 辅导员（青）：与 .mn-admin 三色一致，挂在入口行表示当前用户职位 */
.mn-mini-tag.committee {
  color: var(--brand);
  background: var(--brand-light);
}
.mn-mini-tag.counselor {
  color: #0AA5A8;
  background: var(--success-bg);
}
/* 「换班待确认」的条数角标 */
.mn-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  margin-right: 12rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 22rpx;
  color: #FFFFFF;
  background: var(--danger);
  border-radius: 999rpx;
  box-sizing: border-box;
}

/* ============ 外观（深色模式 C-4）============
 * 紧凑单行：标签「外观」+ 复用全站 segmented 组件（自动 / 浅色 / 深色）。
 * 🔴 本块**一律走 var(--token)** —— 玻璃材质与文字色都靠令牌自动翻深色，
 *    不写死色值（否则深色下这道窄条会反色失败、与整页脱节）。
 * ⚠️ 玻璃配方与 app.wxss 的 .card 同款（--glass-* 令牌），并把本类补进
 *    「不支持 backdrop-filter / 降低透明度」两份降级，否则深色 + 降级会惨白。
 *    不再占整张卡：原本三行单选 ≈ 336rpx + 内边距，现在单行 ≈ 120rpx。 */
.mn-theme {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 32rpx 0;
  padding: 24rpx 32rpx;
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-edge);
  border-radius: var(--r-md);
  box-shadow: var(--glass-shadow), var(--glass-highlight);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
}
/* 不支持 backdrop-filter 的机型（部分安卓 WebView）：用实心底色（令牌自动翻深色，不写死白） */
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .mn-theme { background: var(--bg-card); }
}
/* 系统开了「降低透明度」：直接实心、不做模糊（无障碍优先于观感） */
@media (prefers-reduced-transparency: reduce) {
  .mn-theme { background: var(--bg-card); -webkit-backdrop-filter: none; backdrop-filter: none; }
}
.mn-theme-label {
  font-size: 30rpx;
  line-height: 44rpx;
  font-weight: 500;
  color: var(--text-1);
}

/* 解除绑定（已禁用，仅提示） */
.mn-unbind {
  margin: 40rpx 32rpx 0;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--danger);
  background: var(--bg-card);
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.mn-unbind:active {
  background: var(--danger-bg);
}
/* v0.7.18 需求④：纯说明文字，去底色与圆角 */
.mn-unbind-hint {
  margin: 40rpx 32rpx 0;
  text-align: center;
  font-size: 26rpx;
  line-height: 40rpx;
  color: var(--text-3);
}
.mn-foot {
  height: 180rpx;
}

/* ============ 我的申请 ============ */
.ap-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  position: relative;
}
.ap-item + .ap-item::before {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: 0;
  height: 2rpx;
  background: var(--bg-fill);
}
.ap-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}
.ap-title {
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 500;
  color: var(--text-1);
}
.ap-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--text-3);
}
.ap-status {
  flex-shrink: 0;
  padding: 0 16rpx;
  height: 44rpx;
  line-height: 44rpx;
  font-size: 22rpx;
  border-radius: 999rpx;
}
.ap-actions {
  display: flex;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.ap-btn {
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  color: var(--text-2);
  background: var(--bg-fill);
  border-radius: 999rpx;
  /* 申请处理按钮按下反馈（v0.7.14 · #5④）：缩放 + 淡入回弹 */
  transition: opacity .08s ease, transform .08s ease;
}
.ap-btn + .ap-btn {
  margin-left: 12rpx;
}
.ap-btn.primary {
  color: #FFFFFF;
  background: var(--brand);
}
.ap-btn:active {
  opacity: 0.8;
  transform: scale(0.95);
}
/* 超管的「待我确认」分组标题 */
.ap-sect {
  padding: 20rpx 32rpx 12rpx;
  font-size: 24rpx;
  color: var(--text-3);
}
/* 待确认条目：浅底，与「我的申请」列表区分开 */
.ap-item.pending {
  background: var(--bg-card);
}

/* ============ 关于 P8 ============ */
.ab-wrap {
  padding: 40rpx 32rpx 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ab-logo {
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-light);
  border-radius: 40rpx;
}
.ab-name {
  margin-top: 20rpx;
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 600;
  color: var(--text-1);
}
.ab-ver {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--text-3);
}
.ab-card {
  width: 100%;
  margin-top: 32rpx;
  padding: 24rpx;
  background: var(--fill-soft);
  border-radius: 24rpx;
}
.ab-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  font-size: 28rpx;
  color: var(--text-1);
}
.ab-row + .ab-row {
  border-top: 2rpx solid var(--bg-fill);
}
/* ICP 备案号（2026-10-12）：与上方协议卡同宽同底色；值用**主色 + 下划线**（合规要求「可点击」的视觉暗示） */
.ab-icp {
  width: 100%;
  margin-top: 24rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--fill-soft);
  border-radius: 24rpx;
}
.ab-icp-l {
  font-size: 28rpx;
  color: var(--text-1);
}
.ab-icp-v {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--brand);
  text-decoration: underline;
}
.ab-foot {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ab-foot text {
  font-size: 22rpx;
  line-height: 34rpx;
  color: var(--text-4);
}
/* 微信提醒「额度已用完」的行尾提示（v0.7.15）：沿用本页告警色，与左侧橙色铃铛同色 */
.mn-row-warn {
  color: var(--warning);
}

/* ---------- 审核体验口令（2026-10-15 · v1.0.6.8，仅超管） ----------
   等宽 + 大字距 + 可整块点击复制：口令要被手抄/粘贴，糊成一团最容易抄错。
   ⚠️ 色值一律走 token（深色模式才能自动翻），不在这里硬编码。 */
.rv-code {
  margin: 8rpx 0 8rpx;
  padding: 28rpx 24rpx;
  background: var(--bg-fill);
  border: 2rpx dashed var(--line-1);
  border-radius: var(--r-md);
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-align: center;
  color: var(--text-1);
  user-select: true;
  word-break: break-all;
}
.rv-code:active {
  background: var(--brand-light);
}
.rv-warn {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--warning-bg);
  border-radius: var(--r-sm);
  font-size: 24rpx;
  line-height: 36rpx;
  color: var(--warning);
}

/* ---------- 发送更新公告（v0.7.25，仅超管） ---------- */
.an-wrap {
  padding: 24rpx 32rpx 48rpx;
  display: flex;
  flex-direction: column;
}
.an-field {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}
.an-label {
  display: block;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--text-3);
  margin-bottom: 12rpx;
}
/* ⚠️ input 组件必须给显式 height：只给 padding 时盒子塌陷，
   占位文字垂直居中溢出、向上盖住 label（真机实拍 2026-09-27）。
   ⚠️ 垂直方向不能给 padding：小程序 input 的内层输入域会整体被 padding-top
   往下推、而内部文字仍按自身高度居中 → **文字视觉靠下**（2026-09-27 实测）。
   居中交给 height（88rpx）+ 无垂直 padding 的标准写法。 */
.an-input {
  display: block;
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  background: var(--bg-card);
  border: 2rpx solid rgba(229, 230, 235, 0.9);
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-1);
}
/* 本页本地定义（勿借别页类名 —— 页面 wxss 不跨页共享） */
.f-ph { color: var(--text-4); }
.an-textarea {
  background: var(--bg-card);
  border: 2rpx solid rgba(229, 230, 235, 0.9);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-1);
  width: 100%;
  min-height: 240rpx;
  box-sizing: border-box;
}
.an-tip {
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.6;
  margin-bottom: 20rpx;
}

/* 预设服务商 chips：点选即填好接口地址 + 默认模型 */
.an-presets {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.an-preset {
  padding: 12rpx 30rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #8B5CF6;
  background: rgba(236, 72, 153, 0.08);
  border: 2rpx solid rgba(236, 72, 153, 0.22);
  box-sizing: border-box;
}
.an-preset.on {
  color: #FFFFFF;
  background: linear-gradient(135deg, #EC4899, #8B5CF6);
  border-color: transparent;
}

/* 模型名输入 + 「获取」按钮 同一行 */
.an-model-row {
  display: flex;
  align-items: center;
}
.an-model-row .an-input {
  flex: 1;
  width: auto;
  margin-right: 16rpx;
}
.an-fetch {
  flex: none;
  height: 88rpx;
  padding: 0 32rpx;
  border-radius: 44rpx;
  box-sizing: border-box;
  background: var(--bg-card);
  border: 2rpx solid rgba(236, 72, 153, 0.35);
  color: #EC4899;
  font-size: 28rpx;
  font-weight: 600;
  /* 文字居中必须用 flex 双轴（与 .an-btn 同款）：line-height 撑高在真机会偏 */
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.an-fetch.busy { opacity: 0.6; }

/* 「获取」拉回的模型列表（可滚动，点击即选） */
.an-models-scroll {
  max-height: 320rpx;
  margin-top: 16rpx;
}
.an-models-hint {
  font-size: 22rpx;
  color: var(--text-3);
  margin-bottom: 12rpx;
}
.an-model {
  padding: 16rpx 22rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--text-1);
  background: rgba(31, 38, 135, 0.05);
  border: 2rpx solid transparent;
  margin-bottom: 12rpx;
  word-break: break-all;
}
.an-model.on {
  color: #EC4899;
  background: rgba(236, 72, 153, 0.08);
  border-color: rgba(236, 72, 153, 0.5);
}
.an-btn {
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, #EC4899, #8B5CF6);
}
.an-btn.busy { opacity: 0.6; }
/*
 * 两个按钮**左右并排**（需求：原来上下各占满一行、零间距，糊成一片且分不出主次）。
 * 主次靠**实心 vs 描边**区分：主行动实心渐变，次行动描边留白。
 * ⚠️ 只在本容器里 `flex:1` —— 公告弹层那一个按钮不受影响（仍是整行宽）。
 * ⚠️ 不用 `gap`：用相邻兄弟 margin，兼容更老的基础库。
 */
.an-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 8rpx;
}
.an-actions .an-btn { flex: 1; }
.an-actions .an-btn + .an-btn { margin-left: 20rpx; }
/* 次要行动：描边 + 留白，与主行动的实心渐变形成明显对比 */
.an-btn.ghost {
  color: #EC4899;
  background: var(--bg-card);
  border: 2rpx solid rgba(236, 72, 153, 0.35);
  box-sizing: border-box;
}

/* ============ 值日明细（待值日 / 已结束 可点开） ============ */
.dl { padding: 8rpx 32rpx 32rpx; }
.dl-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  position: relative;
}
.dl-item + .dl-item::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 2rpx;
  background: var(--bg-fill);
}
.dl-date {
  flex-shrink: 0;
  width: 156rpx;
  font-size: 26rpx;
  line-height: 36rpx;
  color: var(--text-2);
}
.dl-info { flex: 1; min-width: 0; margin-left: 20rpx; }
.dl-line1 {
  display: flex;
  align-items: center;
}
.dl-course {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  line-height: 44rpx;
  font-weight: 500;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dl-line2 {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--text-3);
}
.dl-tag {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 0 14rpx;
  height: 36rpx;
  line-height: 36rpx;
  font-size: 20rpx;
  border-radius: 999rpx;
}
.dl-tag.pending { color: var(--warning); background: var(--warning-bg); }
.dl-tag.ongoing { color: var(--brand); background: var(--brand-light); }
.dl-tag.expired { color: var(--text-3); background: var(--bg-fill); }
.dl-tag.done    { color: var(--success); background: var(--success-bg); }
.dl-loading,
.dl-empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  line-height: 40rpx;
  color: var(--text-3);
}
