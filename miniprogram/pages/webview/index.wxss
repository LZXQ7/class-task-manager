.wv { min-height: 100vh; background: var(--bg-page); }
.wv-fail {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 240rpx;
}
.wv-title {
  margin-top: 32rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
}
.wv-desc {
  margin: 16rpx 64rpx 0;
  font-size: 26rpx;
  color: var(--text-3);
  line-height: 40rpx;
  text-align: center;
}
.wv-btn {
  margin-top: 48rpx;
  padding: 0 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 32rpx;
  background: var(--brand);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
}
.wv-btn:active { background: var(--brand-press); }
