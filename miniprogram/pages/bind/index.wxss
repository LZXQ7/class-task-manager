.bind {
  min-height: 100vh;
  background: var(--bg-card);
}

/* ---------- Step 1 ---------- */
.bind-status { width: 100%; }
.bind-gap { width: 100%; }
.bind-logo {
  width: 176rpx;
  height: 176rpx;
  margin: 0 auto;
  border-radius: 48rpx;
  background: var(--brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
}
.bind-title {
  margin-top: 32rpx;
  text-align: center;
  font-size: 56rpx;
  line-height: 76rpx;
  font-weight: 600;
  color: var(--text-1);
}
.bind-sub {
  margin-top: 8rpx;
  text-align: center;
  font-size: 28rpx;
  line-height: 40rpx;
  color: var(--text-3);
}
.bind-form {
  padding: 0 32rpx;
  margin-top: 48rpx;
}
.bind-label {
  font-size: 26rpx;
  line-height: 36rpx;
  color: var(--text-2);
}
.bind-input {
  margin-top: 16rpx;
  height: 96rpx;
  border-radius: 40rpx;
  border: 2rpx solid var(--line-1);
  background: var(--bg-card);
  padding: 0 24rpx;
  font-size: 32rpx;
  color: var(--text-1);
  text-align: center;
  letter-spacing: 4rpx;
}
/* ===== 浮动标签（2026-11-14 用户要求）=====
   未输入：标签躺在输入框**里面**（替代占位符）；
   聚焦 / 有内容：缩小上浮到框**上方**，并一直显示。
   ⚠️ 标签是 absolute 定位在 .bind-field 上（不是 input 内部），
      所以 input 的 placeholder 必须留空，否则两者重影。 */
.bind-field {
  position: relative;
  margin-top: 16rpx;
  padding-top: 30rpx;
}
.bind-field .bind-input {
  margin-top: 0;
  transition: border-color .18s ease, box-shadow .18s ease;
}
.bind-field.filled .bind-input {
  border-color: var(--brand);
  box-shadow: 0 0 0 4rpx rgba(51, 112, 255, 0.08);
}
.bind-field.err .bind-input {
  border-color: var(--danger);
}
.bind-float {
  position: absolute;
  left: 0;
  right: 0;
  top: 30rpx;
  transform: translateY(34rpx);
  text-align: center;
  font-size: 28rpx;
  line-height: 40rpx;
  color: var(--text-4);
  pointer-events: none;
  transition: transform .2s cubic-bezier(.22, .61, .36, 1), color .2s ease, font-size .2s ease;
}
.bind-field.filled .bind-float {
  transform: translateY(0) scale(0.82);
  color: var(--brand);
}
.bind-input.err {
  border-color: var(--danger);
}
.bind-ph {
  color: var(--text-4);
  font-size: 28rpx;
}
.bind-help {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--text-3);
}
.bind-note {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--text-2);
  background: rgba(31, 35, 41, 0.04);
  border-radius: 12rpx;
}
.bind-help.center { text-align: center; }
.bind-err {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--danger);
}
.bind-primary {
  margin: 48rpx 32rpx 0;
  height: 96rpx;
  border-radius: 40rpx;
  background: var(--brand);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.bind-primary:active { background: var(--brand-press); }
.bind-primary.disabled {
  background: var(--bg-fill);
  color: var(--text-4);
}
.bind-spinner {
  width: 40rpx;
  height: 40rpx;
  border-radius: 32rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: var(--bg-card);
  animation: bind-spin .8s linear infinite;
}
@keyframes bind-spin { to { transform: rotate(360deg); } }
.bind-scan {
  margin-top: 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  color: var(--brand);
  font-size: 26rpx;
}
/* 隐私合规勾选行（2026-09-25 审核）：主动勾选同意，不得默认即同意 */
.bind-agreement {
  margin-top: 64rpx;
  display: flex;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text-3);
}
.agree-row {
  display: flex;
  align-items: center;
}
.agree-box {
  width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--bg-fill);
  margin-right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.55);
}
.agree-box.on {
  background: var(--brand-light);
  border-color: var(--brand);
}
.agree-text { color: var(--text-3); }
.link { color: var(--brand); }
/* 绑定入口关闭提示条（超管手动关闭 / 防爆破自动锁死） */
.bind-closed {
  margin: 24rpx 48rpx 0;
  padding: 20rpx 24rpx;
  background: var(--warning-bg);
  color: var(--warning-strong);
  border-radius: 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
}
.shake { animation: bind-shake .3s; }
@keyframes bind-shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-8rpx); }
  75% { transform: translateX(8rpx); }
}

/* ---------- Step 2 ---------- */
.bind-tip {
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  color: var(--text-3);
}
.search-box {
  margin: 0 32rpx 16rpx;
  height: 80rpx;
  border-radius: 32rpx;
  background: var(--bg-fill);
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 24rpx;
}
.search-input {
  flex: 1;
  margin-left: 12rpx;
  font-size: 26rpx;
  color: var(--text-1);
}
.roster-scroll {
  height: calc(100vh - 320rpx);
}
.roster-group-title {
  padding: 8rpx 32rpx;
  height: 64rpx;
  line-height: 48rpx;
  font-size: 26rpx;
  color: var(--text-3);
  background: var(--bg-page);
}
.roster-row {
  position: relative;
  height: 128rpx;
  padding: 0 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  background: var(--bg-card);
  border-bottom: 2rpx solid var(--bg-fill);
}
.roster-row.on { background: var(--brand-light); }
.roster-row.bound { opacity: 0.45; }
.roster-name {
  margin-left: 24rpx;
  font-size: 30rpx;
  color: var(--text-1);
}
.roster-no {
  position: absolute;
  left: 132rpx;
  top: 76rpx;
  font-size: 24rpx;
  color: var(--text-3);
}
.roster-row > .roster-badge,
.roster-row > .roster-tag {
  position: absolute;
  right: 32rpx;
}
.roster-badge {
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  line-height: 40rpx;
}
.roster-badge.ga { background: var(--brand-light); color: var(--brand); }
.roster-badge.gb { background: var(--purple-bg); color: var(--purple); }
.roster-badge.teacher { background: var(--success-bg); color: #0AA5A8; }
.roster-tag {
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  background: var(--bg-fill);
  color: var(--text-2);
  font-size: 22rpx;
  line-height: 40rpx;
}
.roster-row > app-icon {
  position: absolute;
  right: 32rpx;
}
.pick-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 196rpx;
  background: var(--bg-card);
  border-top: 2rpx solid var(--bg-fill);
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 32rpx;
  transform: translateY(100%);
  transition: transform .25s ease-out;
}
.pick-bar.up { transform: translateY(0); }
.pick-name {
  margin-left: 16rpx;
  font-size: 30rpx;
  color: var(--text-1);
}
.pick-name.placeholder { color: var(--text-4); }
.pick-btn {
  margin-left: auto;
  width: 240rpx;
  height: 88rpx;
  border-radius: 32rpx;
  background: var(--brand);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pick-btn:active { background: var(--brand-press); }
.pick-btn.disabled { background: var(--bg-fill); color: var(--text-4); }

/* ---------- Step 3 ---------- */
.picked-card {
  margin: 16rpx 32rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 2rpx solid var(--bg-fill);
  border-radius: 40rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}
.picked-info { margin-left: 24rpx; flex: 1; min-width: 0; }
.picked-name { font-size: 34rpx; font-weight: 600; color: var(--text-1); }
.picked-no { margin-top: 4rpx; font-size: 24rpx; color: var(--text-3); }
.picked-change { color: var(--brand); font-size: 30rpx; }
.code-title {
  margin-top: 48rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--text-1);
}
.code-wrap {
  position: relative;
  margin: 32rpx auto 0;
  display: flex;
  flex-direction: row;
  justify-content: center;
}
.code-cell {
  width: 112rpx;
  height: 112rpx;
  margin: 0 12rpx;
  border-radius: 40rpx;
  border: 2rpx solid var(--line-1);
  background: var(--bg-card);
  font-size: 44rpx;
  font-weight: 600;
  color: var(--text-1);
  display: flex;
  align-items: center;
  justify-content: center;
}
.code-cell.active {
  border: 4rpx solid var(--brand);
}
.code-wrap.err .code-cell { border-color: var(--danger); }
.code-input {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 112rpx;
  opacity: 0;
  color: transparent;
  caret-color: transparent;
}
.code-err {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--danger);
}

/* ---------- 教职工绑定码入口（2026-09-26） ----------
 * 辅导员 / 老师没有班级也没有学号，走独立的一次性绑定码。
 * 8 位码常要口头念或手抄，所以拉开字距 + 等宽体，让字符边界一眼可辨
 * （字符集本身也已去掉易混的 I/O/0/1，见 member 云函数 STAFF_CODE_CHARS）。 */
.bind-input-code {
  text-align: center;
  letter-spacing: 8rpx;
  font-family: Menlo, Consolas, monospace;
}
.bind-switch {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
  text-decoration: underline;
}

/* ---------- 审核体验入口（2026-10-11 · v1.0.6.3） ----------
 * 颜色一律走 app.wxss 的 token（.t-light / .t-dark 各一份），本页不硬编码色值 ——
 * 深色模式才能自动跟着翻。布局复用已有的 .bind-input / .bind-primary，不另起一套尺寸。 */
.bind-review {
  margin: 40rpx 32rpx 0;
  padding: 28rpx 24rpx 4rpx;
  border-radius: var(--r-md);
  background: var(--bg-fill);
}
.bind-review-title {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 38rpx;
  color: var(--text-1);
}
.bind-review-help {
  margin: 8rpx 0 20rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--text-2);
}
/* 口令是长字符串，不能沿用 8 位绑定码那套「居中 + 8rpx 字距 + 等宽字体」 */
.bind-input-review {
  text-align: left;
  letter-spacing: 0;
  font-family: inherit;
}
/* 卡片自带左右 padding，.bind-primary 的 32rpx 横向外边距要收掉，否则按钮比卡片窄一截 */
.bind-review .bind-primary {
  margin: 24rpx 0 20rpx;
}
