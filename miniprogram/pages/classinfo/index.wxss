/* P5 · 信息（框架图式层级聚合页） */
.ci {
  padding-bottom: 40rpx;
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.ci-scroll { display: block; }

/* 根节点：班级概况 */
.ci-hero {
  margin: 24rpx 32rpx 0;
  padding: 32rpx;
  /* ⚠️ 必须定位：卡顶部的班级下拉浮层要盖住下面的「倒数日」卡，
     而后者是 DOM 后面的兄弟 —— 不抬层叠会被它压住（值日页同款问题）。 */
  position: relative;
  z-index: 2;
  /* 🔴 必须显式 visible：全局 .card 是 overflow:hidden（玻璃圆角要裁切层），
     会把下拉浮层裁在卡片里 —— 5 个班只露出 3 个、底边齐整切断（2026-11-14 用户截图）。
     本卡内部没有需要裁切的溢出元素，放开安全。 */
  overflow: visible;
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-edge);
  border-radius: 40rpx;
  box-shadow: var(--glass-shadow), var(--glass-highlight);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
}
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .ci-hero { background: var(--bg-card, rgba(255, 255, 255, 0.9)); }
}
@media (prefers-reduced-transparency: reduce) {
  .ci-hero { background: var(--bg-card); -webkit-backdrop-filter: none; backdrop-filter: none; }
}
.ci-hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ci-hero-label {
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--text-3);
}
/* 「班级管理」入口（右上角胶囊）：与子卡图标块同色系（#F0F5FF 底 + 品牌蓝字），
   保持卡片内既有视觉刻度；深色模式与 .ci-item-ic 走同一口径。 */
.ci-manage {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background: var(--brand-light);
  border-radius: 999rpx;
}
.ci-manage-t {
  margin-left: 8rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 500;
  color: var(--brand);
}
/* 教职工切班（2026-11-14 用户要求②：挪到「班级概况」右边）
 * 演进：横滑胶囊条 → 班名右侧「切换 ⌄」开 bottom-sheet → 一行「查看班级 + 当前班名 + 下拉」
 *      → 现在收进卡片顶行。字段/浮层样式在 components/class-picker/index.wxss。
 * ⚠️ 旧 .ci-name-row / .ci-name-switch / .cs-* 已随弹层删除。 */

/* 顶行左侧组：品类标签 + 班级下拉紧挨着（用户口径「放到班级概况文字的右边」） */
.ci-hero-top-l {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  flex: 1 1 auto;
  min-width: 0;
}
/* 下拉容器：允许被挤压（班名过长时由组件内部 ellipsis），不能把「班级管理」顶出卡片 */
.ci-clsw {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 0 1 auto;
  min-width: 0;
}
/* 2026-10-28：`.ci-item-off`（切到别班时把「通知」子卡置灰）已删除 ——
 * 通知支持按班查看后，四张子卡在哪个班都可用，没有不可用态了。 */

/* 班级大标题（2026-11-14 用户要求②：居中 + 一行显示完）
   · text-align:center —— 用户口径「班级名称居中显示」；
   · white-space:nowrap —— 副标题式的班名折行会把卡片撑高，用户明确要求「保证一行显示完」；
   · 字号不写死在这里：由 JS 的 _nameFont() 按字数算好，用内联 style 下发
     （WXSS 没有「字多自动缩」的表达，写死 44rpx 时 16 字以上就会溢出）。
   · text-align-last:center 让「未绑定班级」这种短文本也居中（部分机型 nowrap 下仍按左对齐）。 */
.ci-hero-name {
  display: block;
  margin-top: 20rpx;
  font-size: 44rpx;
  line-height: 60rpx;
  font-weight: 700;
  color: var(--text-1);
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
}
.ci-hero-stats {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
}
.ci-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ci-stat-num {
  font-size: 44rpx;
  line-height: 56rpx;
  font-weight: 700;
  color: var(--text-1);
}
.ci-stat-label {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--text-3);
}
.ci-stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: var(--bg-fill);
}

/* 层级连线（纯视觉）：从「班级概况」向下汇入班级模块子卡的主干 */
.ci-connector {
  width: 2rpx;
  height: 28rpx;
  margin: 0 auto;
  background: var(--line-1);
}

/* 子节点：班级模块入口 */
.ci-list {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
}
.ci-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  margin-top: 16rpx;
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-edge);
  border-radius: 32rpx;
  box-shadow: var(--glass-shadow), var(--glass-highlight);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
}
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .ci-item { background: var(--bg-card, rgba(255, 255, 255, 0.9)); }
}
@media (prefers-reduced-transparency: reduce) {
  .ci-item { background: var(--bg-card); -webkit-backdrop-filter: none; backdrop-filter: none; }
}
.ci-item-ic {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: var(--brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
}
.ci-item-main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}
.ci-item-name {
  font-size: 32rpx;
  line-height: 46rpx;
  font-weight: 600;
  color: var(--text-1);
}
.ci-item-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--text-3);
  /* 副标题现在可能是动态摘要（课程表：「今天 5 节 · 本周 20 节」，2026-10-28），
     字数不定 ⇒ 单行省略，避免换行把整行卡片顶高、六张卡高度参差 */
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 请假审批卡角标（2026-11-01）：待批条数红点，贴在箭头前。
   与全局危险色 #F53F3F 同源（删除倒数日 confirmColor 同色）。 */
.ci-badge {
  flex-shrink: 0;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 10rpx;
  margin-right: 14rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: var(--danger);
  border-radius: 999rpx;
}
.ci-foot {
  height: 180rpx;
}

/* ---------------- 班级选择弹层（2026-10-28）已删除（2026-11-14） ----------------
 * 切班统一走 hero 卡内的 class-picker 下拉，.cs-list / .cs-row / .cs-name 随之删除。
 * 留空段说明「这里曾经有什么」，避免下一个人按旧门禁去找不存在的类。 */

/* ---------------- 倒数日（2026-11-02 新增）：个人本地自定义事件卡 ---------------- */
.ci-cd {
  margin: 16rpx 32rpx 0;
  padding: 28rpx 32rpx;
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-edge);
  border-radius: 32rpx;
  box-shadow: var(--glass-shadow), var(--glass-highlight);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
}
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .ci-cd { background: var(--bg-card, rgba(255, 255, 255, 0.9)); }
}
@media (prefers-reduced-transparency: reduce) {
  .ci-cd { background: var(--bg-card); -webkit-backdrop-filter: none; backdrop-filter: none; }
}
.ci-cd-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid var(--line-1, var(--line-1));
}
.ci-cd-title {
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: 600;
  color: var(--text-1);
}
/* 体验版常驻标识（2026-11-12）：演示态下倒数日展示全部记录（含过期），明确提示用户 */
.ci-cd-pin { flex: none; margin-left: 12rpx; padding: 2rpx 12rpx; font-size: 20rpx; line-height: 1.4; color: #fff; background: #ff9500; border-radius: 16rpx; }
.ci-cd-add {
  display: flex;
  align-items: center;
  padding: 6rpx 20rpx;
  background: var(--brand-light, #F0F5FF);
  border-radius: 999rpx;
}
.ci-cd-add-t {
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--brand, #3370FF);
}
.ci-cd-empty {
  margin-top: 20rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--text-3);
}
.ci-cd-list {
  margin-top: 4rpx;
}
.ci-cd-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--bg-fill, var(--bg-fill));
}
.ci-cd-row:first-child {
  border-top: none;
}
.ci-cd-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
/* 2026-11-02：事件名（标题）加粗 + 名字/日期同步放大 */
.ci-cd-name {
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 700;
  color: var(--text-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ci-cd-date {
  margin-top: 2rpx;
  font-size: 30rpx;
  line-height: 42rpx;
  color: var(--text-3);
}
/* 「x天」粗体 44rpx，垂直居中于整条：视觉上顶到名字行中线、底到日期行中线。 */
.ci-cd-days {
  flex-shrink: 0;
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 44rpx;
  line-height: 1;
  font-weight: 700;
  white-space: nowrap;
  color: var(--brand, #3370FF);
}
.ci-cd-days.passed {
  color: var(--text-3);
  font-weight: 400;
}

/* 倒数日添加弹层表单（2026-11-02） */
.cd-form {
  padding: 8rpx 32rpx 32rpx;
}
.cd-field {
  margin-top: 24rpx;
}
.cd-label {
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--text-3);
}
.cd-input {
  margin-top: 12rpx;
  height: 72rpx;
  padding: 0 20rpx;
  background: var(--bg-fill, #F2F3F5);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--text-1);
}
.cd-picker {
  margin-top: 12rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  background: var(--bg-fill, #F2F3F5);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--text-1);
}
.cd-picker.placeholder {
  color: #A8ABB2;
}

/* 底部操作条：复用全局 .btn / .btn-ghost，这里补 .f-actions 布局与等宽子按钮
   （app.wxss 未提供，duty 页用 .sl .f-actions 本地定义，本页同样本地定义） */
.f-actions {
  display: flex;
  gap: 20rpx;
  align-items: stretch;
  margin-top: 32rpx;
}
.f-cancel,
.f-save {
  flex: 1;
}
