<!-- 信息（框架图式层级聚合页）：根「班级概况」+ 班级模块子卡 -->
<!-- 防滚动穿透（与 home / duty 同一套方案）：弹层里的列表滑到下沿后，touchmove 会继续冒泡给
     page，「在弹层里滑到底 → 后面的页面跟着一起滑」就是这么来的。
     ⚠️ 新增 / 改名的弹层 show 标志必须同步进下面表达式，否则 scripts/check-scroll-lock.js 会报错。 -->
<page-meta page-style="{{cdSheetShow ? 'overflow:hidden' : ''}}"></page-meta>

<view class="page ci {{paReady ? (animSeq === 0 ? 'pa-first' : (animSeq === 1 ? 'pa-lite-a' : 'pa-lite-b')) : 'pa-hold'}} {{tClass}}">

  <!-- NavBar（Tab 页无返回键，左上角放主题切换按钮） -->
  <nav-bar id="ciNav" title="信息" sheet-open="{{cdSheetShow}}" />

  <!-- 主内容滚动（spring-scroll 提供边界阻尼回弹；flex:1 填满导航栏以下区域） -->
  <spring-scroll style="display:block;flex:1;min-height:0" class="ci-scroll" id="ciMain">

    <!-- 根节点：班级概况（展示班级名 + 成员统计） -->
    <view class="ci-hero card st-item st-1">
      <view class="ci-hero-top">
        <view class="ci-hero-top-l">
          <text class="ci-hero-label">班级概况</text>
          <!-- 切班下拉（2026-11-14 用户要求②：挪到「班级概况」文字右边，不再单独占一行）
               trigger-text="切换" —— 班名已经在本卡的大标题里居中显示，这里再放一遍全名
               会被省略号截成「示例专业26…」，等于没显示（截图核对时实测）。
               只绑 1 个班也渲染：它是「换一个班看」的唯一入口。 -->
          <view wx:if="{{isStaff && classChips.length}}" class="ci-clsw">
            <class-picker
              trigger-text="切换"
              list="{{classChips}}"
              value="{{viewClassId}}"
              bind:change="onClassPick"
            />
          </view>
        </view>
        <!-- 右上角的 grid 图标：对本班有管理权的人（超管 / 辅导员）是「班级管理」入口，
             其余身份维持原来的纯装饰图标（首页精简后该入口曾一度全站消失）。 -->
        <view data-pressable wx:if="{{canManageClass}}" class="ci-manage" bindtap="goClasses"
              hover-class="press-dim" hover-start-time="0" hover-stay-time="60">
          <app-icon name="grid" variant="brand" size="{{28}}" />
          <text class="ci-manage-t">班级管理</text>
        </view>
        <app-icon wx:else name="grid" variant="brand" size="{{36}}" />
      </view>
      <!-- 班级大标题：居中 + 字号自适应（用户要求「居中显示，自适应大小，保证一行显示完」）。
           字号由 JS 按字数算（_nameFont），WXSS 没有「字多自动缩」这种表达。
           切班下拉已挪到上方「班级概况」右边，这里不再重复渲染第二份。 -->
      <text class="ci-hero-name" style="font-size:{{nameFont}}rpx">{{className ? className : '未绑定班级'}}</text>
      <view class="ci-hero-stats">
        <view class="ci-stat">
          <text class="ci-stat-num">{{stats ? stats.total : '—'}}</text>
          <text class="ci-stat-label">总人数</text>
        </view>
        <view class="ci-stat-divider"></view>
        <view class="ci-stat">
          <text class="ci-stat-num">{{stats ? stats.groupA : '—'}}</text>
          <text class="ci-stat-label">A 组</text>
        </view>
        <view class="ci-stat-divider"></view>
        <view class="ci-stat">
          <text class="ci-stat-num">{{stats ? stats.groupB : '—'}}</text>
          <text class="ci-stat-label">B 组</text>
        </view>
      </view>
    </view>

    <!-- 层级连线（纯视觉，提示框架图的「根 → 子节点」层级） -->
    <view class="ci-connector"></view>

    <!-- 倒数日（2026-11-03 改云端）：**仅本人**的自定义事件，按日期升序显示「N 天」 -->
    <view class="ci-cd card st-item st-2">
      <view class="ci-cd-head">
        <text class="ci-cd-title">倒数日</text>
        <view wx:if="{{demo}}" class="ci-cd-pin">体验版常驻</view>
        <view data-pressable class="ci-cd-add" bindtap="onCdAdd" hover-class="press-dim" hover-start-time="0" hover-stay-time="60">
          <text class="ci-cd-add-t">+ 添加</text>
        </view>
      </view>
      <view wx:if="{{countdowns.length === 0}}" class="ci-cd-empty">还没有倒数日，点「添加」记录重要节点</view>
      <view wx:else class="ci-cd-list">
        <view data-pressable wx:for="{{countdowns}}" wx:key="id" class="ci-cd-row" data-id="{{item.id}}" bindtap="onCdTap" hover-class="press-dim" hover-start-time="0" hover-stay-time="60">
          <view class="ci-cd-row-main">
            <text class="ci-cd-name">{{item.name}}</text>
            <text class="ci-cd-date">{{item.date}}</text>
          </view>
          <view class="ci-cd-days {{item.passed ? 'passed' : ''}}"><text>{{item.dayText}}</text></view>
        </view>
      </view>
    </view>

    <!-- 子节点：班级模块入口（「课程表」已于 2026-10-28 下线；「通知/作业」于 2026-11-02 移除） -->
    <view class="ci-list">
      <view data-pressable class="ci-item card st-item st-3" hover-class="tap-hover" hover-start-time="0" hover-stay-time="60" bindtap="onOpen" data-key="roster">
        <view class="ci-item-ic"><app-icon name="people" variant="brand" size="{{40}}" /></view>
        <view class="ci-item-main">
          <text class="ci-item-name">班级成员</text>
          <text class="ci-item-sub">成员名单与分组</text>
        </view>
        <app-icon name="arrow-right" variant="gray" size="{{32}}" />
      </view>

      <view data-pressable class="ci-item card st-item st-4" hover-class="tap-hover" hover-start-time="0" hover-stay-time="60" bindtap="onOpen" data-key="fee">
        <view class="ci-item-ic"><app-icon name="tag" variant="brand" size="{{40}}" /></view>
        <view class="ci-item-main">
          <text class="ci-item-name">班费</text>
          <text class="ci-item-sub">{{feeTotal != null ? '当前班费 ¥' + feeTotal : '班费收支与余额'}}</text>
        </view>
        <app-icon name="arrow-right" variant="gray" size="{{32}}" />
      </view>

      <!-- 请假 v3（2026-11-01）：普通成员本人申请入口 + 审批人待批入口 -->
      <view data-pressable wx:if="{{canApply}}" class="ci-item card st-item st-5" hover-class="tap-hover" hover-start-time="0" hover-stay-time="60" bindtap="onGoMyLeave">
        <view class="ci-item-ic"><app-icon name="calendar" variant="brand" size="{{40}}" /></view>
        <view class="ci-item-main">
          <text class="ci-item-name">我的请假</text>
          <text class="ci-item-sub">提交请假申请 · 查看审批进度</text>
        </view>
        <app-icon name="arrow-right" variant="gray" size="{{32}}" />
      </view>

      <view data-pressable wx:if="{{canApprove}}" class="ci-item card st-item st-6" hover-class="tap-hover" hover-start-time="0" hover-stay-time="60" bindtap="onGoApprove">
        <view class="ci-item-ic"><app-icon name="check" variant="brand" size="{{40}}" /></view>
        <view class="ci-item-main">
          <text class="ci-item-name">请假审批</text>
          <text class="ci-item-sub">{{pendingCount > 0 ? (pendingCount + ' 条待审批') : '审批同学的请假申请'}}</text>
        </view>
        <view wx:if="{{pendingCount > 0}}" class="ci-badge">{{pendingCount}}</view>
        <app-icon name="arrow-right" variant="gray" size="{{32}}" />
      </view>

    </view>

    <view class="ci-foot"></view>
  </spring-scroll>

  <!-- 班级选择弹层已删除（2026-11-14）：切班统一走 Hero 卡内的 class-picker 下拉字段。 -->

  <!-- 倒数日添加弹层（2026-11-03 改云端）：名称 + 日期，存服务端（仅本人可见） -->
  <bottom-sheet
    show="{{cdSheetShow}}"
    title="添加倒数日"
    bind:close="onCdSheetClose"
  >
    <view class="cd-form">
      <view class="cd-field">
        <text class="cd-label">事件名称</text>
        <input class="cd-input" placeholder="如：期末考试 / 寒假 / 生日" value="{{cdName}}" bindinput="onCdNameInput" maxlength="20" />
      </view>
      <view class="cd-field">
        <text class="cd-label">目标日期</text>
        <picker mode="date" value="{{cdDate}}" start="2020-01-01" end="2035-12-31" bindchange="onCdDateChange">
          <view class="cd-picker {{cdDate ? '' : 'placeholder'}}">{{cdDate || '选择日期'}}</view>
        </picker>
      </view>
      <view class="f-actions">
        <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="btn btn-ghost f-cancel" bindtap="onCdSheetClose">取消</view>
        <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="btn f-save" bindtap="onCdSave">保存</view>
      </view>
    </view>
  </bottom-sheet>
</view>
