<page-meta page-style=""></page-meta>

<view class="page hw page-fade {{tClass}}">

  <nav-bar title="发布作业" show-back="{{true}}" custom-back="{{true}}" bind:back="onBack" />

  <view class="fm-card">
    <view class="fm-label">标题 <text class="fm-req">*</text></view>
    <input class="fm-input" value="{{title}}" placeholder="如：第7周微课设计与制作作业" placeholder-class="f-ph" maxlength="64" bindinput="onTitleInput" />
  </view>

  <view class="fm-card">
    <view class="fm-label">说明</view>
    <textarea class="fm-area" value="{{brief}}" placeholder="作业要求（可选）" placeholder-class="f-ph" maxlength="500" bindinput="onBriefInput"></textarea>
  </view>

  <view class="fm-card">
    <view class="fm-label">截止时间 <text class="fm-req">*</text></view>
    <view class="fm-row">
      <picker class="fm-pick-half" mode="date" value="{{dueDate}}" bindchange="onDateChange">
        <view class="fm-pick">{{dueDate || '选择日期'}}</view>
      </picker>
      <picker class="fm-pick-half" mode="time" value="{{dueTime}}" bindchange="onTimeChange">
        <view class="fm-pick">{{dueTime || '选择时间'}}</view>
      </picker>
    </view>
  </view>

  <!-- 需交分组（多选） -->
  <view class="fm-card">
    <view class="fm-label">需交作业分组 <text class="fm-req">*</text></view>
    <view class="fm-chips">
      <view class="fm-chip chip-motion {{groupA ? 'on' : ''}}" data-g="A" bindtap="onToggleGroup">A 组</view>
      <view class="fm-chip chip-motion {{groupB ? 'on' : ''}}" data-g="B" bindtap="onToggleGroup">B 组</view>
      <view class="fm-chip chip-motion {{groupSelf ? 'on' : ''}}" data-g="SELF" bindtap="onToggleGroup">仅自己</view>
    </view>
    <view class="fm-hint">「仅自己」= 只有你自己能看到并提交这份作业，用于自测</view>
  </view>

  <!-- 要求提交材料 -->
  <view class="fm-card">
    <view class="fm-label">要求提交材料</view>
    <view class="fm-chips">
      <view
        class="fm-chip chip-motion {{requireType === item.key ? 'on' : ''}}"
        wx:for="{{requireOptions}}"
        wx:key="key"
        data-k="{{item.key}}"
        bindtap="onRequireType"
      >{{item.label}}</view>
    </view>
    <view class="fm-hint">不要求：学生可纯文字提交；图片 / 文件：至少上传 1 个对应类型</view>
  </view>

  <!-- 数量限制（picker 选项式，不手动输入——2026-10-24 用户要求） -->
  <view class="fm-card">
    <view class="fm-label">最多上传图片（张）</view>
    <picker mode="selector" range="{{maxImagesOptions}}" value="{{maxImagesIdx}}" bindchange="onMaxImagesChange">
      <view class="fm-pick">{{maxImages}}</view>
    </picker>
    <view class="fm-hint">可选 1–{{limit.image}}，默认 {{limit.imageDefault}}</view>
  </view>

  <view class="fm-card">
    <view class="fm-label">最多上传文件（个）</view>
    <picker mode="selector" range="{{maxFilesOptions}}" value="{{maxFilesIdx}}" bindchange="onMaxFilesChange">
      <view class="fm-pick">{{maxFiles}}</view>
    </picker>
    <view class="fm-hint">可选 1–{{limit.file}}，默认 {{limit.fileDefault}}</view>
  </view>

  <!-- 附件 -->
  <view class="fm-card">
    <view class="fm-label">附件（可选）</view>
    <view class="fm-acts">
      <view class="fm-act" bindtap="onPickImage">+ 图片</view>
      <view class="fm-act" bindtap="onPickFile">+ 文件</view>
    </view>
    <view
      wx:for="{{attaches}}"
      wx:key="path"
      class="fm-file"
    >
      <!-- 图片附件：缩略图（tempFilePath 本地路径可直接渲染）；文件附件：文件名+后缀 -->
      <image wx:if="{{item.kind === 'IMAGE'}}" class="fm-file-thumb" src="{{item.path}}" mode="aspectFill" />
      <view class="fm-file-body">
        <text class="fm-file-name">{{item.name}}</text>
        <text class="fm-file-size">{{item.sizeText}}</text>
      </view>
      <view class="fm-file-del" data-idx="{{index}}" bindtap="onRemoveAttach">×</view>
    </view>
  </view>

  <view style="height:24rpx"></view>

  <view class="f-actions">
    <view class="btn btn-ghost f-cancel" bindtap="onBack">取消</view>
    <view class="btn f-save" bindtap="onSubmit">发布</view>
  </view>
</view>
