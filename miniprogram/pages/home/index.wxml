<!-- Tab 入场动画（v0.7.12）：内容**分块**依次上浮淡入，见 app.wxss 的 .pa-first / .pa-lite-*
     与 utils/page-anim.js。首次播完整版，之后回访在两个 lite 类名之间轮换（换名字 = 重播）。
     ⚠️ 三个类名都要写全，别用 pa-{{animSeq}} 插值 —— check-wxss 是静态扫描，
        插值出来的类名它看不到，会报「用了但没定义」。
     ⚠️ 需要入场的块标 st-item + 档位类 st-1~st-7（第 7 块起封顶，错峰见 app.wxss）。
       ⚠️ 增删块之后必须重排档位号，check-tab-enter 会校验「第 N 块 = st-N」。 -->
<!-- 防滚动穿透（v0.7.9）：弹层里的 scroll-view 滑到下沿后，touchmove 会继续冒泡给 page，
     「在弹层里滑到底 → 后面的页面跟着一起滑」就是这么来的。
     page-meta 的 page-style 是官方/社区验证的锁页面滚动方案（Vant Weapp 的 popup 同款）。
     ⚠️ 新增 / 改名的弹层 show 标志必须同步进下面表达式，否则 scripts/check-scroll-lock.js 会报错。 -->
<page-meta page-style="{{(sheetShow || noticeShow || anncSheetShow || npopSheetShow || leaveHomeShow || courseInfoShow || feeShow) ? 'overflow:hidden' : ''}}"></page-meta>

<view class="page home {{paReady ? (animSeq === 0 ? 'pa-first' : (animSeq === 1 ? 'pa-lite-a' : 'pa-lite-b')) : 'pa-hold'}} {{tClass}}">

  <!-- NavBar（fixed 默认开）：移出 spring-scroll，否则被 .ss-content 的 transform 建立包含块、固定定位失效（v0.7.19 修） -->
  <nav-bar>
    <view class="nav-center" slot="center">
      <text class="nav-date">{{dateText}}</text>
      <text class="nav-week">{{weekText}}</text>
    </view>
  </nav-bar>

  <!-- 「切换测试账号」模拟态护栏（v1.0.5）：留在此处（spring-scroll 之外）——
       进 spring-scroll 会被 .ss-content 的 transform 建立包含块，且会跟着一起滚走。 -->
  <notice-bar
    wx:if="{{impersonateBanner}}"
    type="danger"
    icon="info"
    text="{{impersonateBanner}}"
    btnText="恢复本人"
    bind:action="onRecoverSelf"
  />

  <!-- 主内容滚动（v0.7.19 需求④）：spring-scroll 提供边界阻尼回弹；flex:1 填满导航栏以下区域 -->
  <spring-scroll style="display:block;flex:1;min-height:0" class="home-scroll" id="homeMain" bindrefresh="onRefresh">
  <!-- 未绑定 -->
  <block wx:if="{{unbound}}">
    <view class="wrap">
      <empty-state
        icon="cloud-off"
        title="你还没有绑定班级"
        desc="绑定后即可查看自己的值日安排与课表"
        btn-text="立即绑定"
        bind:action="goBind"
        padding="{{160}}"
      />
    </view>
  </block>

  <!-- 网络失败 -->
  <block wx:elif="{{failed}}">
    <view class="wrap">
      <empty-state
        icon="cloud-off"
        title="数据没加载出来"
        desc="检查网络后重试"
        btn-text="重新加载"
        bind:action="onReload"
        padding="{{160}}"
      />
    </view>
  </block>

  <!-- 加载骨架 -->
  <block wx:elif="{{loading}}">
    <view class="wrap">
      <skeleton type="card" rows="{{1}}" height="{{296}}" />
      <skeleton type="list" rows="{{3}}" />
    </view>
  </block>

  <block wx:else>
    <view class="wrap">

      <!-- Hero 卡（v0.7.16 需求⑨：教职工不值日 → 辅导员不渲染；wx:if 不影响 st-item 兄弟关系） -->
      <view wx:if="{{!isCounselor}}" class="hero {{hero ? hero.cls : 'plain small'}} st-item st-1" bindtap="onHero">
        <block wx:if="{{myDuty}}">
          <view class="hero-top">
            <view class="hero-chip">{{periodText}}</view>
            <view class="hero-chip right">
              {{hero.status}}
              <view wx:if="{{myDuty.status === 'ONGOING'}}" class="hero-dot"></view>
            </view>
          </view>
          <view class="hero-title" style="color:{{hero.titleColor}}">{{hero.title}}</view>
          <view class="hero-sub" style="color:{{hero.subColor}}">{{heroSub}}</view>
          <view class="hero-bottom">
            <view class="hero-peers">
              <view wx:for="{{myDuty.peers}}" wx:key="index" class="hero-peer">
                <avatar-tag name="{{item.name}}" size="{{48}}" ring="{{true}}" />
              </view>
              <text class="hero-peer-text" wx:if="{{myDuty.peers.length}}">
                和 {{myDuty.peers[0].name}}<block wx:if="{{myDuty.peers.length > 1}}">、{{myDuty.peers[1].name}}</block> 一起
              </text>
            </view>
            <text class="hero-more" style="color:{{hero.subColor}}">查看详情 ›</text>
          </view>
        </block>
        <block wx:else>
          <view class="hero-title noduty">今天没有你的值日</view>
          <view class="hero-sub noduty-sub">可在「值日」页查看本周安排</view>
        </block>
      </view>

      <!-- 关注的学生（v0.7.17 需求⑥，仅辅导员 / 超管）：固定在主页的学生在这里常驻，
           每行「头像 + 姓名 + 最新一条备注摘要」，点开直接进他的成员详情继续记录。
           ⚠️ 插在最前面（辅导员最常看的就是这几个人）；插块后**档位必须整体重排**（st-2~st-4）。 -->
      <view wx:if="{{showPins}}" class="card mt16 st-item st-2">
        <view class="card-head">
          <text class="card-title">关注的学生</text>
          <text class="card-sub">{{pins.length}}/{{pinLimit}}</text>
        </view>
        <block wx:if="{{pins.length}}">
          <view
            wx:for="{{pins}}"
            wx:key="memberId"
            class="pin-row"
            data-id="{{item.memberId}}"
            data-class-id="{{item.classId}}"
            data-name="{{item.name}}"
            hover-class="press-dim"
            hover-start-time="0"
            hover-stay-time="60"
            bindtap="onPinTap"
          >
            <avatar-tag name="{{item.name}}" src="{{item.avatarUrl}}" size="{{72}}" />
            <view class="pin-info">
              <view class="pin-line1">
                <text class="pin-name">{{item.name}}</text>
                <text wx:if="{{item.className}}" class="pin-class">{{item.className}}</text>
              </view>
              <text class="pin-note">{{item.latestNote ? item.latestNote : '还没有备注，点开可以记录'}}</text>
            </view>
            <text wx:if="{{item.noteCount}}" class="pin-cnt">{{item.noteCount}}</text>
            <app-icon name="arrow-right" variant="gray" size="{{32}}" />
          </view>
        </block>
        <view wx:else class="pin-empty">在成员详情里点「固定到主页」，需要长期关注的学生就会出现在这里</view>
      </view>

      <!-- 语音通知条 -->
      <view wx:if="{{unreadNotice}}" class="mt16 st-item st-3">
        <view class="voice-bar">
          <view class="voice-ic" bindtap="onPlayNotice">
            <app-icon name="{{playing ? 'pause' : 'play'}}" variant="brand" size="{{44}}" />
          </view>
          <view class="voice-info">
            <view class="voice-title">{{unreadNotice.publisherName}} 发布了语音通知</view>
            <view class="voice-sub">
              {{unreadNotice.audioReady ? '时长 ' + unreadNotice.durationText : '审核中'}} · {{unreadNotice.createdAt}}
            </view>
          </view>
          <view class="voice-btn" bindtap="onPlayNotice">{{playing ? '暂停' : '播放'}}</view>
        </view>
      </view>

      <!-- 今日课次（教职工隐藏，需求⑨） -->
      <view wx:if="{{!isCounselor}}" class="card mt16 st-item st-4">
        <view class="card-head">
          <text class="card-title">今日课次</text>
          <view class="card-link" bindtap="goTimetable">查看课表 ›</view>
        </view>
        <block wx:if="{{sessions.length}}">
          <!-- ⚠️ 2026-10-09 需求②：`canCourseInfo`（班长/副班长/超管）才能点开「课堂情况」弹窗。
     🔴 按权限**渲染两份**而不是靠 bindtap 插值：后者虽然真机可用
        （home:235 admin-cell / roster:199 mb-note-main 都是这么写的），但
        条件为假时会绑成一个**空 handler 名** —— 真机上照样能点、只是没反应，
        属于「点了没反应又不报错」那类最难查的形态。两份渲染则从根上不存在这个分支。
     ⚠️⚠️ **WXML 注释里绝不能写注释的结束标记本身**
        （本轮真机编译失败就是它：注释体里多写一个结束标记 ⇒ 注释**提前闭合**
        ⇒ 后面的文字全变成真实标记 ⇒ DevTools报「文件解析编译错误」，
        而报错位置落在后面几十行的普通标签上，根本看不出是这里）。
        ✅ 提到结束标记时用中文说法代替符号本身。
        （注释里**写插值花括号是合法的**，真机正常，既有代码到处都这么写。） -->
          <block wx:if="{{canCourseInfo}}">
            <!-- 🔴 wx:key 用 JS 预计算好的 `key` 字段（`s<sessionId>` / `p<pid>`），
                 **绝不能写 `{{ }}` 表达式** —— wx:key 只接受属性名，表达式会让渲染层直接报错
                 （DevTools：`missing ) after argument list` + `FLOW_INITIAL_CREATION` 框架内部错误；
                  详见 home/index.js 的 _withRowKey 注释）。
                 选修课仍保留 bindtap：onCourseTap 里有 `if (s.isPersonal) return` 守卫，
                 不会弹课堂情况；tappable 只是视觉提示，由 .personal 样式单独关掉按压反馈。 -->
            <view wx:for="{{sessions}}" wx:key="key" wx:for-index="ci"
              class="course-row tappable {{item.isMine ? 'mine' : ''}} {{item.done ? 'done' : ''}} {{item.isPersonal ? 'personal' : ''}}"
              bindtap="onCourseTap" data-idx="{{ci}}"
              hover-class="{{item.isPersonal ? '' : 'press-dim'}}" hover-start-time="0" hover-stay-time="60">
              <view class="course-bar {{item.isMine ? 'on' : ''}}"></view>
              <view class="course-side">
                <text class="course-time">{{item.periodTime ? item.periodTime.start + '-' + item.periodTime.end : '第' + item.period + '节'}}</text>
                <view class="course-room">{{item.room || '未填教室'}}</view>
              </view>
              <text class="course-name">{{item.name}}</text>
              <!-- 选修课不显示「全体」标签（它不属于任何分组，显示「全体」会误导成全班课） -->
              <view wx:if="{{item.isPersonal}}" class="tag elective">选修</view>
              <block wx:else>
                <text wx:if="{{item.groupScope}}" class="tag {{item.groupScope === 'A' ? 'ga' : 'gb'}}">{{item.groupScope}} 组</text>
                <view wx:else class="tag all">全体</view>
              </block>
            </view>
          </block>
          <block wx:else>
            <!-- ⚠️ wx:key 用预计算的 `key`（同理：不能写表达式）。为什么不直接用 sessionId：
                 选修课的 sessionId 恒为 0（个人课次没有 session 身份）⇒ 多门选修课会撞 key，
                 列表增删时 diff 错位。`_withRowKey` 给两个 id 空间加前缀区分（s… / p…）。
                 2026-10-16 首页并入本人选修课时一并修正。 -->
          <!-- ⚠️ 选修课**不加 tappable**（2026-10-16）：它不驱动值日、也没有课堂情况名单
               （onCourseTap 里对 isPersonal 直接 return）⇒ 点了没反应反而像坏了，
               不如做成纯展示行。 -->
            <view wx:for="{{sessions}}" wx:key="key"
              class="course-row {{item.isMine ? 'mine' : ''}} {{item.done ? 'done' : ''}} {{item.isPersonal ? 'personal' : ''}}">
              <view class="course-bar {{item.isMine ? 'on' : ''}}"></view>
              <view class="course-side">
                <text class="course-time">{{item.periodTime ? item.periodTime.start + '-' + item.periodTime.end : '第' + item.period + '节'}}</text>
                <view class="course-room">{{item.room || '未填教室'}}</view>
              </view>
              <text class="course-name">{{item.name}}</text>
              <!-- 🔴 选修课不显示「全体」标签：它不属于任何分组，显示「全体」会误导成全班课。
                   改显「选修」角标，一眼区分本人课与全班课。 -->
              <view wx:if="{{item.isPersonal}}" class="tag elective">选修</view>
              <block wx:else>
                <text wx:if="{{item.groupScope}}" class="tag {{item.groupScope === 'A' ? 'ga' : 'gb'}}">{{item.groupScope}} 组</text>
                <view wx:else class="tag all">全体</view>
              </block>
            </view>
          </block>
        </block>
        <view wx:else class="no-course">今天无课🎉</view>
      </view>

      <!-- 明日课次（放假 / 调课 / 跨周都由后端按「实际上课日期」算好；教职工隐藏，需求⑨） -->
      <view wx:if="{{!isCounselor}}" class="card mt16 st-item st-5">
        <view class="card-head">
          <text class="card-title">明日课次</text>
          <text class="card-sub">{{tomorrowText}}</text>
        </view>
        <block wx:if="{{tomorrowSessions.length}}">
          <!-- 同今日课次：wx:key 用预计算的 `key`（选修课 p<pid>、全班课次 s<sessionId>），
               选修课显「选修」角标而非「全体」 -->
          <view wx:for="{{tomorrowSessions}}" wx:key="key" class="course-row">
            <view class="course-bar"></view>
            <view class="course-side">
              <text class="course-time">{{item.periodTime ? item.periodTime.start + '-' + item.periodTime.end : '第' + item.period + '节'}}</text>
              <view class="course-room">{{item.room || '未填教室'}}</view>
            </view>
            <text class="course-name">{{item.name}}</text>
            <view wx:if="{{item.isPersonal}}" class="tag elective">选修</view>
            <block wx:else>
              <view wx:if="{{item.groupScope}}" class="tag {{item.groupScope === 'A' ? 'ga' : 'gb'}}">{{item.groupScope}} 组</view>
              <view wx:else class="tag all">全体</view>
            </block>
          </view>
        </block>
        <view wx:else class="no-course">明日无课🎉</view>
      </view>

      <!-- 班费 / 团费（2026-10-14）：班费全员可见；团费仅超管 / 班长兼团支书可见（左右一排两卡）。
           普通成员（及无管理职位的班委）班费卡仅展示、不可点开；点开弹出消费 / 明细弹层。 -->
      <view class="fee-block mt16 st-item st-6">
        <view class="fee-row">
          <view
            class="card fee-card tappable"
            data-type="class"
            bindtap="onFeeTap"
            hover-class="press-dim"
            hover-start-time="0"
            hover-stay-time="60"
          >
            <view class="fee-card-top">
              <view class="fee-card-left">
                <text class="fee-name">班费</text>
                <text class="fee-tag {{feeCanManageClass ? 'manage' : 'view'}}">{{feeCanManageClass ? '管理' : '查看'}}</text>
              </view>
              <app-icon name="arrow-right" variant="gray" size="{{28}}" />
            </view>
            <text class="fee-balance">¥{{feeClass.balanceText}}</text>
            <text class="fee-sub">总额 ¥{{feeClass.totalText}} · 已消费 ¥{{feeClass.expenseText}}</text>
          </view>

          <view
            wx:if="{{showLeagueCard}}"
            class="card fee-card tappable"
            data-type="league"
            bindtap="onFeeTap"
            hover-class="press-dim"
            hover-start-time="0"
            hover-stay-time="60"
          >
            <view class="fee-card-top">
              <view class="fee-card-left">
                <text class="fee-name">团费</text>
                <text class="fee-tag {{feeCanManageLeague ? 'manage' : 'view'}}">{{feeCanManageLeague ? '管理' : '查看'}}</text>
              </view>
              <app-icon name="arrow-right" variant="gray" size="{{28}}" />
            </view>
            <text class="fee-balance">¥{{feeLeague.balanceText}}</text>
            <text class="fee-sub">总额 ¥{{feeLeague.totalText}} · 已消费 ¥{{feeLeague.expenseText}}</text>
          </view>
        </view>
      </view>

      <!-- 首页请假卡（1.0.5 追加，需求①②）：班委/超管看本班请假人数、辅导员看各班总数；
           普通同学不可见（决策④）。点击 → 按 A/B 组列出请假的人（班委可撤销）。 -->
      <view wx:if="{{showLeaveHome}}" class="card mt16 leave-home st-item st-7">
        <block wx:if="{{leaveHomeMode === 'class'}}">
          <view class="lh-head">
            <text class="lh-title">{{leaveHomeClassName ? leaveHomeClassName + ' · 请假' : '本班请假'}}</text>
            <text wx:if="{{leaveHomeDate}}" class="lh-date">{{leaveHomeDate}}</text>
          </view>
          <!-- ⚠️ 2026-10-09：数字从 `stat`（日期口径）改成 **`now`（实时口径）**——
     上午请假的人到了下午就该翻回在位。日期口径的数字移到下方「今日共 N 人请假」，
     它与弹层名单行数恒等（统计同源），供核对用。两个数字口径不同是**有意的**。 -->
          <view class="lh-body" bindtap="onLeaveHomeOpen" hover-class="press-dim" hover-start-time="0" hover-stay-time="60">
            <text class="lh-num {{leaveHomeLeave > 0 ? 'warn' : ''}}">{{leaveHomeHasNow ? leaveHomeLeave : '—'}}</text>
            <text class="lh-unit">{{leaveHomeHasNow ? '人当前请假' : '人数未知'}}</text>
          </view>
          <view class="lh-foot">
            <!-- 日期口径：与弹层名单行数恒等（不是实时数，别混用） -->
            <text class="lh-grp">今日共 {{leaveHomeTotal}} 人请假</text>
            <text class="lh-grp">A 组 {{leaveHomeLeaveA}} 人</text>
            <text class="lh-grp">B 组 {{leaveHomeLeaveB}} 人</text>
            <!-- 1.0.6 修：过去这行「查看名单 ›」**没绑 tap**（只有上面的「x人请假」块绑了），
                 点了没反应，用户只能猜到要点数字 —— 现在两处行为完全一致（同一个弹层）。 -->
            <text
              class="lh-more"
              bindtap="onLeaveHomeOpen"
              hover-class="press-dim"
              hover-start-time="0"
              hover-stay-time="60"
            >查看名单 ›</text>
          </view>
        </block>
        <block wx:else>
          <view class="lh-head"><text class="lh-title">各班请假人数</text></view>
          <view class="lh-classes">
            <view
              wx:for="{{leaveHomeClasses}}"
              wx:key="classId"
              class="lh-cls"
              data-id="{{item.classId}}"
              data-name="{{item.className}}"
              bindtap="onLeaveHomeClassTap"
              hover-class="press-dim"
              hover-start-time="0"
              hover-stay-time="60"
            >
              <text class="lh-cls-name">{{item.className}}</text>
              <text class="lh-cls-num">{{item.leave}} 人</text>
            </view>
          </view>
          <view wx:if="{{!leaveHomeClasses.length}}" class="lh-empty">暂无可查看的班级</view>
        </block>
      </view>

      <!-- 管理员入口（2026-10-14 移动：原在「明日课次」后，现置于「本班请假」之下）：
           标题按身份显示职位头衔（超管金 / 班委蓝 / 辅导员青）。
           「管理员」含超管，「超管」严格仅超管（§41 术语约定）。
           v0.7.16 需求⑥：辅导员不显示「成员与分组」（只能看到一个班的旧卡片），
           原位换成「查看班级」—— 从班级管理里看特定班级的人员。 -->
      <view wx:if="{{isAdmin}}" class="card mt16 admin-card st-item st-7">
        <view wx:if="{{adminTag}}" class="admin-tag {{adminTier}}">{{adminTag}}</view>
        <view class="admin-grid">
          <view class="admin-cell" hover-class="press-dim" hover-start-time="0" hover-stay-time="60" bindtap="{{isCounselor ? 'goClasses' : 'goRoster'}}">
            <app-icon name="people" variant="brand" size="{{48}}" />
            <text>{{isCounselor ? '查看班级' : '成员与分组'}}</text>
          </view>
          <view class="admin-cell" bindtap="onNoticeOpen">
            <app-icon name="bell" variant="brand" size="{{48}}" />
            <text>发布通知</text>
          </view>
        </view>
      </view>

      <!-- 查看通知（§41 需求⑦）：全员可见，未确认数红点角标。点开直接进通知页，
           不再绕到「我的」页找入口 -->
      <view class="card mt16 notice-card st-item st-7" bindtap="goNotice" hover-class="press-dim" hover-start-time="0" hover-stay-time="60">
        <app-icon name="bell" variant="brand" size="{{40}}" />
        <view class="notice-info">
          <view class="notice-title">查看通知</view>
          <view class="notice-sub">班委发布的所有通知与回执</view>
        </view>
        <view wx:if="{{noticeUnacked}}" class="notice-badge">{{noticeUnacked}}</view>
        <app-icon name="arrow-right" variant="gray" size="{{32}}" />
      </view>

      <!-- 查看班级（超管 / 辅导员，多班级 §43 需求⑤）：可新建班级、查看邀请码 / 入班码、导入名单
           v0.7.16：辅导员的这个入口已上移到管理员卡（原「成员与分组」位置），这里不再重复显示 -->
      <!-- 1.0.6 修：这张卡过去**漏标 st-item / 档位类**，是首页唯一不参与入场动画的块
           —— 其它卡都是逐级上浮，它直接杵在那儿。档位按「第 N 块 = st-N、第 7 块起封顶」
           落在 st-7（它前面已有 7 块），check-tab-enter 门禁认这套写法。 -->
      <view wx:if="{{canViewClass && !isCounselor}}" class="card mt16 notice-card st-item st-7" bindtap="goClasses" hover-class="press-dim" hover-start-time="0" hover-stay-time="60">
        <app-icon name="people" variant="brand" size="{{40}}" />
        <view class="notice-info">
          <view class="notice-title">查看班级</view>
          <view class="notice-sub">班级列表、邀请码 / 入班码、导入名单</view>
        </view>
        <app-icon name="arrow-right" variant="gray" size="{{32}}" />
      </view>

      <!-- 待办条 -->
      <view wx:if="{{pendingSwapCount > 0}}" class="mt16 st-item st-7">
        <notice-bar
          type="warning"
          icon="bell"
          text="你有 {{pendingSwapCount}} 条换班申请待确认"
          btn-text="去处理"
          bind:action="goMine"
        />
      </view>

      <view class="foot-space"></view>
    </view>
  </block>

  </spring-scroll>

  <duty-sheet
    show="{{sheetShow}}"
    duty-id="{{sheetDutyId}}"
    bind:close="onSheetClose"
    bind:changed="onSheetChanged"
  />

  <!-- 发布通知（管理员）：文字 + 在线文档链接 + 可选「需要确认收到」
       表单统一走 .np-field 分组（左右 32rpx、每组 28rpx 间距），拿不到 .np-field 会贴屏幕边 -->
  <bottom-sheet show="{{noticeShow}}" title="发布通知" height="{{1560}}" bind:close="onNoticeClose">
    <view class="np">
      <view class="np-field">
        <view class="np-label">标题<text class="np-opt">选填</text></view>
        <input
          class="np-input"
          value="{{noticeTitle}}"
          placeholder="不填则只发内容"
          placeholder-class="f-ph"
          maxlength="60"
          bindinput="onNoticeTitle"
        />
      </view>

      <view class="np-field">
        <view class="np-label">内容</view>
        <textarea
          class="np-textarea"
          value="{{noticeContent}}"
          placeholder="写清楚时间、地点、要带什么"
          placeholder-class="f-ph"
          maxlength="2000"
          bindinput="onNoticeContent"
        />
      </view>

      <!-- 配图（v0.7.14）：最多 3 张，chooseMedia 压缩后直传云存储（不走云函数中转） -->
      <view class="np-field">
        <view class="np-label">图片<text class="np-opt">最多 3 张，选填</text></view>
        <view class="np-imgs">
          <view wx:for="{{noticeImages}}" wx:key="*this" class="np-img">
            <image class="np-img-pic" src="{{item}}" mode="aspectFill" />
            <view class="np-img-x" data-i="{{index}}" bindtap="onNoticeRemoveImage" hover-class="press-dim" hover-start-time="0" hover-stay-time="60">
              <app-icon name="close" variant="gray" size="{{24}}" />
            </view>
          </view>
          <view wx:if="{{noticeImages.length < 3}}" class="np-img np-img-add" bindtap="onNoticePickImage" hover-class="np-abtn-hover" hover-start-time="0" hover-stay-time="60">
            <app-icon name="plus" variant="brand" size="{{40}}" />
            <text class="np-img-add-t">添加</text>
          </view>
        </view>
      </view>

      <view class="np-field">
        <view class="np-label">在线文档链接<text class="np-opt">选填</text></view>
        <input
          class="np-input"
          value="{{noticeLinkUrl}}"
          placeholder="https://…（金山文档 / 腾讯文档）"
          placeholder-class="f-ph"
          maxlength="500"
          bindinput="onNoticeLink"
        />
        <input
          wx:if="{{noticeLinkUrl}}"
          class="np-input np-input-2"
          value="{{noticeLinkName}}"
          placeholder="显示名（粘贴链接后自动检测标题）"
          placeholder-class="f-ph"
          maxlength="60"
          bindinput="onNoticeLinkName"
        />
        <text wx:if="{{noticeLinkDetecting}}" class="np-link-detecting">正在检测文档标题…</text>
        <text wx:if="{{noticeLinkHint}}" class="np-link-hint">{{noticeLinkHint}}</text>
      </view>

      <view class="np-field">
        <view class="np-label">发给谁</view>
        <!-- width 必须等于「750 - .np 左右内边距」= 686，否则会出现右侧空缺或换行 -->
        <segmented items="{{noticeScopeItems}}" value="{{noticeScope}}" width="{{686}}" bind:change="onNoticeScope" />
      </view>

      <!-- 多班级：仅辅导员账号显示「发送班级」；**默认只勾本班**，可逐个点班 / 一键全选 / 清空。
           需求④：以前默认「全部班级」，导致想发本班的人把通知发到了所有班级 -->
      <view wx:if="{{noticeShowClasses && noticeScope !== 'PICK'}}" class="np-field">
        <view class="np-label">发送班级<text class="np-opt">可多选</text></view>
        <view class="np-classes">
          <view class="np-cls chip-motion {{noticeAllClasses ? 'on' : ''}}" bindtap="onNoticeToggleAllClasses" hover-class="np-abtn-hover" hover-stay-time="60">全部班级</view>
          <view class="np-cls ghost chip-motion" bindtap="onNoticeClearClasses" hover-class="np-abtn-hover" hover-stay-time="60">清空</view>
          <view
            wx:for="{{noticeClasses}}"
            wx:key="id"
            class="np-cls chip-motion {{noticeClassPicked[item.id] ? 'on' : ''}}"
            data-id="{{item.id}}"
            bindtap="onNoticeToggleClass"
            hover-class="np-abtn-hover"
            hover-stay-time="60"
          >{{item.name}}</view>
        </view>
        <text class="np-cls-tip">{{noticeAllClasses ? '已选全部班级（点某个班可取消该班）' : (noticeClassIds.length ? '已选 ' + noticeClassIds.length + ' 个班级' : '未选班级，将无法发布')}}</text>
      </view>

      <!-- 按职位：预设职位一键选择（口径 = member.position 实际的 7 种，不做手输） -->
      <view wx:if="{{noticeScope === 'POSITION'}}" class="np-field">
        <view class="np-label">职位<text class="np-opt">可多选</text></view>
        <view class="np-chips">
          <view
            wx:for="{{noticePosPresets}}"
            wx:key="*this"
            class="np-chip chip-motion {{noticePosPicked[item] ? 'on' : ''}}"
            data-pos="{{item}}"
            bindtap="onNoticePosPreset"
            hover-class="np-abtn-hover"
            hover-stay-time="60"
          >{{item}}</view>
        </view>
        <text class="np-pos-tip">{{noticePosPickedCount ? '已选 ' + noticePosPickedCount + ' 个职位（再点一下取消）' : '点上方职位一键选择，未选将无法发布'}}</text>
      </view>

      <view wx:if="{{noticeScope === 'PICK'}}" class="np-field">
        <view class="np-panel">
          <view class="np-pick-hint">测试账号与辅导员不接收通知，已自动隐藏</view>
          <view class="np-search">
            <app-icon name="search" variant="gray" size="{{32}}" />
            <input
              class="np-search-input"
              value="{{noticeKw}}"
              placeholder="搜索姓名或学号"
              placeholder-class="f-ph"
              bindinput="onNoticeKw"
            />
          </view>
          <view class="np-abtns">
            <view class="np-abtn chip-motion {{noticePickAllA ? 'on' : ''}}" data-tag="A" bindtap="onPickGroup" hover-class="np-abtn-hover" hover-stay-time="60">A 组</view>
            <view class="np-abtn chip-motion {{noticePickAllB ? 'on' : ''}}" data-tag="B" bindtap="onPickGroup" hover-class="np-abtn-hover" hover-stay-time="60">B 组</view>
            <view class="np-abtn ghost chip-motion" bindtap="onClearPick" hover-class="np-abtn-hover" hover-stay-time="60">清空</view>
            <view wx:if="{{noticePickedCount}}" class="np-picked">已选 {{noticePickedCount}} 人</view>
          </view>
          <!-- 小图形网格：每个成员一个头像圆点（显示序号），点一下即选；比长列表紧凑得多（需求④） -->
          <scroll-view scroll-y class="np-grid-scroll">
            <view class="np-grid">
              <view
                wx:for="{{noticeMembers}}"
                wx:key="id"
                class="np-cell chip-motion {{noticePick[item.id] ? 'on' : ''}}"
                data-id="{{item.id}}"
                bindtap="onNoticePick"
                hover-class="np-cell-hover"
                hover-stay-time="60"
              >
                <avatar-tag name="{{item.name}}" text="{{item.seq}}" no-fallback="{{true}}" size="{{76}}" />
                <text class="np-cell-name">{{item.name}}</text>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>

      <view class="np-field">
        <view class="np-switch">
          <view class="np-switch-info">
            <text class="np-switch-title">需要确认收到</text>
            <text class="np-switch-sub">打开后，成员要在首页「查看通知」里点「确认收到」</text>
          </view>
          <switch checked="{{noticeNeedAck}}" color="#3370FF" bindchange="onNoticeAck" />
        </view>
      </view>

      <!-- 一次性弹窗（v1.0.5）：与超管的「发布更新公告」同款体验，但跟着这条通知走
           （只弹给本条的接收人，看过不再弹）。 -->
      <view class="np-field">
        <view class="np-switch">
          <view class="np-switch-info">
            <text class="np-switch-title">弹出一次性弹窗</text>
            <text class="np-switch-sub">打开后，接收人下次打开首页会弹出来一次，看过就不再弹</text>
          </view>
          <switch checked="{{noticePopup}}" color="#3370FF" bindchange="onNoticePopupChange" />
        </view>
      </view>

      <view class="np-actions">
        <view class="np-btn ghost" bindtap="onNoticeClose">取消</view>
        <view class="np-btn primary {{noticeBusy ? 'off' : ''}}" bindtap="onNoticeSubmit">{{noticeBusy ? '发布中…' : '发布通知'}}</view>
      </view>
    </view>
  </bottom-sheet>

  <!-- 更新公告（v0.7.25）：超管发送后，所有人下次打开主页弹一次、看过不再弹 -->
  <bottom-sheet show="{{anncSheetShow}}" title="{{anncNotice.version ? '更新公告 v' + anncNotice.version : '更新公告'}}" bind:close="onAnncDismiss">
    <view class="an-view">
      <text wx:if="{{anncNotice.title}}" class="an-view-title">{{anncNotice.title}}</text>
      <scroll-view class="an-view-scroll" scroll-y="{{true}}" enhanced show-scrollbar="{{false}}">
        <text class="an-view-content">{{anncNotice.content}}</text>
      </scroll-view>
      <view class="an-view-btn" bindtap="onAnncDismiss">知道了</view>
    </view>
  </bottom-sheet>

  <!-- 通知一次性弹窗（v1.0.5）：发布通知勾了「弹出一次性弹窗」→ 本条接收人下次打开主页弹一次、
       看过不再弹。与上面的更新公告共用 .an-view 样式，优先级见 home/index.js 的 _loadPopups。 -->
  <bottom-sheet show="{{npopSheetShow}}" title="{{npopNotice.title || '班级通知'}}" bind:close="onNpopDismiss">
    <view class="an-view">
      <text wx:if="{{npopNotice.title}}" class="an-view-title">{{npopNotice.title}}</text>
      <scroll-view class="an-view-scroll" scroll-y="{{true}}" enhanced show-scrollbar="{{false}}">
        <text class="an-view-content">{{npopNotice.content}}</text>
      </scroll-view>
      <view class="an-view-btn" bindtap="onNpopDismiss">知道了</view>
    </view>
  </bottom-sheet>

  <!-- 首页请假名单（1.0.5 追加）：按 A/B 组列出请假的人。
       1.0.6：行尾的「撤销」换成「假条 / 传假条」（撤销**只在请假登记里保留**，
       首页离登记入口太远、误触成本高），弹层底部补一行去登记的入口把撤销接回来。 -->
  <bottom-sheet show="{{leaveHomeShow}}" title="{{leaveHomeViewTitle}}" bind:close="onLeaveHomeClose">
    <view class="lv">
      <view wx:if="{{leaveHomeListA.length}}" class="lv-grp">
        <text class="lv-grp-t">A 组 · {{leaveHomeListA.length}} 人</text>
        <view wx:for="{{leaveHomeListA}}" wx:key="leaveId" class="lv-row">
          <avatar-tag name="{{item.name}}" text="{{item.seq}}" no-fallback="{{true}}" size="{{56}}" />
          <view class="lv-info">
            <text class="lv-name">{{item.name}}<text wx:if="{{item.over}}" class="lv-over">已过时段</text></text>
            <text class="lv-sub">{{item.startDate}} ~ {{item.endDate}}{{item.startTime ? ' ' + item.startTime + '-' + item.endTime : ''}}</text>
          </view>
          <!-- 1.0.6 需求③：行尾从「假条」二字改成**缩略图** ——
               文字看不出「到底传了没」，缩略图一眼就知道，而且能点开核对内容。
               没有图时保留幽灵「传假条」按钮：上传入口不能被缩略图吃掉。
               ⚠️ 换不到临时链接时退回「假条」二字（wx:else），不留空白方块。 -->
          <view
            wx:if="{{item.hasImage}}"
            class="lv-thumb"
            data-id="{{item.leaveId}}"
            data-has="1"
            catchtap="onLeaveHomeImageTap"
          >
            <image wx:if="{{leaveImgUrls[item.image]}}" class="lv-thumb-img" src="{{leaveImgUrls[item.image]}}" mode="aspectFill" />
            <text wx:else class="lv-thumb-t">假条</text>
          </view>
          <view
            wx:elif="{{leaveHomeCanCancel}}"
            class="lv-btn ghost"
            data-id="{{item.leaveId}}"
            data-has="0"
            catchtap="onLeaveHomeImageTap"
          >传假条</view>
        </view>
      </view>
      <view wx:if="{{leaveHomeListB.length}}" class="lv-grp">
        <text class="lv-grp-t">B 组 · {{leaveHomeListB.length}} 人</text>
        <view wx:for="{{leaveHomeListB}}" wx:key="leaveId" class="lv-row">
          <avatar-tag name="{{item.name}}" text="{{item.seq}}" no-fallback="{{true}}" size="{{56}}" />
          <view class="lv-info">
            <text class="lv-name">{{item.name}}<text wx:if="{{item.over}}" class="lv-over">已过时段</text></text>
            <text class="lv-sub">{{item.startDate}} ~ {{item.endDate}}{{item.startTime ? ' ' + item.startTime + '-' + item.endTime : ''}}</text>
          </view>
          <!-- 1.0.6 需求③：行尾从「假条」二字改成**缩略图** ——
               文字看不出「到底传了没」，缩略图一眼就知道，而且能点开核对内容。
               没有图时保留幽灵「传假条」按钮：上传入口不能被缩略图吃掉。
               ⚠️ 换不到临时链接时退回「假条」二字（wx:else），不留空白方块。 -->
          <view
            wx:if="{{item.hasImage}}"
            class="lv-thumb"
            data-id="{{item.leaveId}}"
            data-has="1"
            catchtap="onLeaveHomeImageTap"
          >
            <image wx:if="{{leaveImgUrls[item.image]}}" class="lv-thumb-img" src="{{leaveImgUrls[item.image]}}" mode="aspectFill" />
            <text wx:else class="lv-thumb-t">假条</text>
          </view>
          <view
            wx:elif="{{leaveHomeCanCancel}}"
            class="lv-btn ghost"
            data-id="{{item.leaveId}}"
            data-has="0"
            catchtap="onLeaveHomeImageTap"
          >传假条</view>
        </view>
      </view>
      <view wx:if="{{leaveHomeLoading}}" class="lv-empty">加载中…</view>
      <view wx:elif="{{!leaveHomeListA.length && !leaveHomeListB.length}}" class="lv-empty">今天没有人请假</view>
      <!-- 撤销的补偿入口：roster 不在 tabBar 里，从首页摸过去要 4 跳，
           没有指路牌等于把撤销藏起来了。仅班委/超管可见（辅导员只读，不改数据）。 -->
      <view wx:if="{{leaveHomeCanCancel}}" class="lv-goto" bindtap="onLeaveHomeGotoRoster" hover-class="press-dim" hover-start-time="0" hover-stay-time="60">
        <text class="lv-goto-t">需要撤销？去请假登记</text>
        <app-icon name="arrow-right" variant="light" size="{{24}}" />
      </view>
    </view>
  </bottom-sheet>

  <!-- ============ 课堂情况（2026-10-09 需求②）============
       班长/副班长点首页「今日课次」任意一行 → 这里弹出一段可直接发群的文本。
       ⚠️ 文本是**唯一真源** courseInfoText（`_buildCourseInfo` 现算）——
          弹层显示与「一键复制」读的是同一个字段，不会出现「看到的」与「复制的不一样」。
       ⚠️ 用 footer 固定「一键复制」按钮（结构级固定在面板底部），内容区只放文本预览。
       ⚠️ 加载中时不给复制按钮（内容还没算好，复制出去是残的）。 -->
  <bottom-sheet show="{{courseInfoShow}}" title="课堂情况" bind:close="onCourseInfoClose" footer="{{!courseInfoLoading}}">
    <view class="ci">
      <view wx:if="{{courseInfoLoading}}" class="ci-loading">正在统计…</view>
      <block wx:else>
        <!-- 2026-10-09 用户实拍调整三处：
             ① 文本要装进**卡片框**里（之前是散在弹层背景上，与小程序其它卡片不统一）；
             ② **课程名上面要有班级名**（模板第一行，之前空着看不见）；
             ③ 「复制课堂情况」按钮**被悬浮 tabBar 压住**了 ⇒ 底部要让位
                （bottom-sheet 的 .sheet-footer 注释已写明：让位由内容自己写 padding-bottom）。
             预览块整体复制到剪贴板的形态不变，仍是 courseInfoText 那一份（唯一真源）。 -->
        <view class="ci-card">
          <!-- 班级名：与 `courseInfoText` 第一行**同源**（都由 classFullName → leaveHomeClassName 兜底）。
             ⚠️ 这里**不再自带「本班」占位**：那个占位会在真名已经拿到时仍显示「本班」，
             让人以为没生效（用户实拍过一次）。真名到底在哪一层兜底由 JS 单点决定。 -->
          <text class="ci-line ci-cls">{{classFullName || leaveHomeClassName || '（班级）'}}</text>
          <text class="ci-line ci-course">{{courseInfoTitle}}</text>
          <text class="ci-line">{{courseInfoTeacher}} 应到{{courseInfoExpected}}人 实到{{courseInfoActual}}人</text>
          <text class="ci-line ci-normal">课堂情况：正常</text>
          <text wx:for="{{courseInfoAbsentees}}" wx:key="leaveId" class="ci-line ci-absent">{{item.studentNo}}{{item.name}}请假</text>
        </view>
        <view wx:if="{{!courseInfoAbsentees.length}}" class="ci-none">这节课没人请假，实到 = 应到</view>
      </block>
    </view>
    <view slot="footer" class="ci-foot">
      <view class="ci-copy" bindtap="onCourseInfoCopy" hover-class="press-dim" hover-start-time="0" hover-stay-time="60">
        复制课堂情况
      </view>
    </view>
  </bottom-sheet>

  <!-- ============ 班费 / 团费（2026-10-14）============
       点开卡片弹出 **列表视图**：余额（含总额 / 已消费只读小字）+ 消费明细 + 「增加消费」按钮。
       点「增加消费」切到 **表单视图**：金额 / 备注 / 凭证图片（最多 9 张）+ 提交 / 返回。
       ⚠️ 设置总额**不在这里** —— 已迁到「我的」页「更多」（2026-10-14 需求②），
          避免出现两处入口改同一个值。
       ⚠️ 仅能班费/团费管理者能点开（普通成员卡片仅展示），故表单恒属于有权限者。 -->
  <bottom-sheet show="{{feeShow}}" title="{{feeActiveName}}{{feeCanManage ? ' · 管理' : ' · 仅查看'}}" bind:close="onFeeClose">
    <view class="np">
      <!-- 班费/团费跨班查看（v0.7.43）：**仅辅导员**且负责多于 1 个班时，在弹层内切换查看的班级 -->
      <view wx:if="{{isCounselor && feeClassList.length > 1}}" class="fee-cls-switch">
        <text class="fee-cls-label">查看班级</text>
        <view class="fee-cls-chips">
          <view wx:for="{{feeClassList}}" wx:key="id"
                class="fee-cls-chip {{feeViewClassId === item.id ? 'on' : ''}}"
                data-id="{{item.id}}" bindtap="onFeeClassPick"
                hover-class="press-dim" hover-start-time="0" hover-stay-time="60">
            {{item.name}}
          </view>
        </view>
      </view>
      <!-- 余额（两个视图都显示：填金额时要看得见还剩多少） -->
      <view class="fee-bal-block">
        <text class="fee-bal-label">当前余额</text>
        <text class="fee-bal-num">¥{{feeActive.balanceText}}</text>
        <!-- 只读小字：总额 / 已消费。删掉的只是「可编辑的设置总额输入框」，
             这两个数字在列表视图用来核对，留着不占地方。 -->
        <text class="fee-bal-sub">总额 ¥{{feeActive.totalText}} · 已消费 ¥{{feeActive.expenseText}}</text>
      </view>

      <!-- 列表视图：消费明细 + 增加消费 -->
      <block wx:if="{{feeView === 'list'}}">
        <view class="fee-rec-head">消费明细</view>
        <view class="fee-rec" wx:for="{{feeActive.records}}" wx:key="id">
          <view class="fee-rec-main">
            <text class="fee-rec-amt">-¥{{item.amountText}}</text>
            <text class="fee-rec-note" wx:if="{{item.note}}">{{item.note}}</text>
          </view>
          <view class="fee-rec-meta">
            <text class="fee-rec-op">{{item.operatorName}}</text>
            <text class="fee-rec-time">{{item.createdAt}}</text>
          </view>
          <view class="fee-rec-imgs" wx:if="{{item.images.length}}">
            <view wx:for="{{item.images}}" wx:for-item="img" wx:for-index="imgIdx" wx:key="*this" class="fee-rec-img" data-id="{{item.id}}" data-idx="{{imgIdx}}" data-src="{{img}}" bindtap="onFeePreviewImage" hover-class="press-dim" hover-start-time="0" hover-stay-time="60">
              <image class="fee-rec-img-pic" src="{{img}}" mode="aspectFill" />
            </view>
          </view>
          <!-- 仅管理人可见：追加图片（未满 9 张）/ 删除；view-only 用户完全看不到 -->
          <view class="fee-rec-ops" wx:if="{{feeCanManage}}">
            <view class="fee-rec-append" wx:if="{{item.images.length < 9}}" data-id="{{item.id}}" bindtap="onFeeAppendTap" hover-class="press-dim" hover-start-time="0" hover-stay-time="60">追加图片</view>
            <view class="fee-rec-del" data-id="{{item.id}}" bindtap="onFeeDeleteRecord" hover-class="press-dim" hover-start-time="0" hover-stay-time="60">删除</view>
          </view>
        </view>
        <view class="fee-rec-empty" wx:if="{{!feeActive.records.length}}">还没有消费记录</view>
        <!-- ⚠️ 原此处有一条「仅查看，无法修改或删除」的灰底横幅（2026-10-15 按用户要求删除）：
             它与弹层标题「班费 · 仅查看」重复，且底部「增加消费」按钮本就不渲染（feeCanManage 控制），
             用户看到的是「点不动的按钮 + 一句解释」，双重提示反而像出了 bug。
             权限口径不变：非管理者依旧没有增删改入口，只是不再显式声明。 -->
        <view class="np-actions" wx:if="{{feeCanManage}}">
          <view class="np-btn primary" bindtap="onFeeAddOpen" hover-class="press-dim" hover-start-time="0" hover-stay-time="60">增加消费</view>
        </view>
      </block>

      <!-- 表单视图：金额 / 备注 / 凭证图片 + 提交 -->
      <block wx:if="{{feeView === 'form'}}">
        <view class="np-field">
          <view class="np-label">金额</view>
          <input class="np-input" type="digit" value="{{feeAmount}}" placeholder="消费金额（元）" placeholder-class="f-ph" bindinput="onFeeAmountInput" />
        </view>
        <view class="np-field">
          <view class="np-label">备注<text class="np-opt">选填</text></view>
          <input class="np-input" value="{{feeNote}}" placeholder="例如：买卫生工具" placeholder-class="f-ph" maxlength="200" bindinput="onFeeNoteInput" />
        </view>
        <view class="np-field">
          <view class="np-label">凭证图片<text class="np-opt">最多 9 张，选填</text></view>
          <view class="np-imgs">
            <view wx:for="{{feeImages}}" wx:key="*this" class="np-img">
              <image class="np-img-pic" src="{{item}}" mode="aspectFill" />
              <view class="np-img-x" data-i="{{index}}" bindtap="onFeeRemoveImage" hover-class="press-dim" hover-start-time="0" hover-stay-time="60">
                <app-icon name="close" variant="gray" size="{{24}}" />
              </view>
            </view>
            <view wx:if="{{feeImages.length < 9}}" class="np-img np-img-add" bindtap="onFeePickImage" hover-class="np-abtn-hover" hover-start-time="0" hover-stay-time="60">
              <app-icon name="plus" variant="brand" size="{{40}}" />
              <text class="np-img-add-t">添加</text>
            </view>
          </view>
        </view>
        <view class="np-actions">
          <view class="np-btn ghost" bindtap="onFeeFormBack" hover-class="press-dim" hover-start-time="0" hover-stay-time="60">返回</view>
          <view class="np-btn primary {{feeBusy ? 'off' : ''}}" bindtap="onFeeSubmit">{{feeBusy ? '提交中…' : '提交消费'}}</view>
        </view>
      </block>
    </view>
  </bottom-sheet>
</view>
