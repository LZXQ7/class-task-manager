
/**
 * P2 · 首页
 *
 * ⚠️ 开头这一段是**页面骨架**，整段没了页面会「编译通过但整页变样」：
 *    · `.wrap` —— 内容左右 32rpx 内边距；一没，卡片就满宽贴边；
 *    · `.hero*` —— 值日 Hero 卡；一没，Hero 退化成一行纯文字；
 *    · `.mt16` / `.nav-*` / `.foot-space` —— 卡片间距 / 导航栏中间 / 底部留白。
 * 给本文件追加样式时**一律加到文件末尾**，不要覆盖开头（2026-09-25 踩过一次，
 * 那次把这一段连同「发布通知」样式一起插到头部，结果整段被顶掉）。
 */

/* ---------- 布局骨架 ---------- */
/* 主内容滚动交给 spring-scroll（v0.7.19 需求④）；根不再原生滚动 */
.home { height: 100vh; overflow: hidden; display: flex; flex-direction: column; }
.home-scroll { display: block; }
.wrap { padding: 24rpx 32rpx; }
.mt16 { margin-top: 16rpx; }
.foot-space { height: 168rpx; }        /* 给固定 tabBar 让位，与全局 .page-foot-space 同值 */

/* ---------- NavBar 中间：日期 + 周次 ---------- */
.nav-center { display: flex; flex-direction: row; align-items: baseline; justify-content: center; }
.nav-date { font-size: 30rpx; font-weight: 600; color: #1D2129; }
.nav-week { margin-left: 8rpx; font-size: 22rpx; color: #86909C; }

/* ---------- Hero 值日卡 ----------
 * 状态变体（设计稿）：plain 白底 / blue 蓝渐变（进行中）/ leave 橙底（已请假）/ small 无值日。
 * 主文案与副文案的**颜色不写在这里** —— 由 JS 按状态内联 hero.titleColor / hero.subColor
 * 下发，因为同一句话在白底卡和蓝底卡上要换色。 */
.hero {
  position: relative;
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 40rpx;                 /* 设计稿：Hero 卡 16pt 圆角（普通卡片是 12pt = 24rpx） */
  /* 玻璃材质，与全站卡片统一（v0.7.19 需求③）；plain / small 走玻璃，blue / leave 仍是实色 */
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-edge);
  box-shadow: var(--glass-shadow), var(--glass-highlight);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  overflow: hidden;
}
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .hero { background: rgba(255, 255, 255, 0.9); }
}
@media (prefers-reduced-transparency: reduce) {
  .hero { background: #FFFFFF; -webkit-backdrop-filter: none; backdrop-filter: none; }
}
.hero:active { opacity: 0.94; }
.hero.blue {
  background: linear-gradient(135deg, #3370FF 0%, #5A8CFF 100%);
  border-color: transparent;
  box-shadow: 0 8rpx 32rpx rgba(51,112,255,0.28);
}
.hero.leave { background: #FFF7E8; border-color: #FFF3C2; }
/* 无值日：白底小卡；不带头部状态行，标题上边距在 .noduty 里归零 */
.hero.small { padding: 30rpx 32rpx; }

.hero-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.hero-chip {
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.20);
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 44rpx;
}
/* 白底 / 橙底卡上白胶囊看不见 → 换成浅灰底深字 */
.hero.plain .hero-chip,
.hero.small .hero-chip,
.hero.leave .hero-chip { background: #F2F3F5; color: #4E5969; }
.hero-chip.right { display: flex; flex-direction: row; align-items: center; }
.hero-dot {
  width: 16rpx;
  height: 16rpx;
  margin-left: 10rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
}

.hero-title { margin-top: 20rpx; font-size: 44rpx; line-height: 60rpx; font-weight: 600; }
.hero-sub { margin-top: 8rpx; font-size: 26rpx; line-height: 34rpx; }

.hero-bottom {
  margin-top: 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.hero-peers { display: flex; flex-direction: row; align-items: center; }
.hero-peer-text { font-size: 24rpx; line-height: 34rpx; color: rgba(255, 255, 255, 0.70); }
.hero.plain .hero-peer-text,
.hero.small .hero-peer-text,
.hero.leave .hero-peer-text { color: #86909C; }
.hero-more { font-size: 24rpx; }       /* 颜色随 hero.subColor 内联 */

/* 无值日变体的两行文案 */
.hero-title.noduty { margin-top: 0; font-size: 40rpx; line-height: 56rpx; color: #1D2129; }
.hero-sub.noduty-sub { margin-top: 8rpx; font-size: 26rpx; line-height: 36rpx; color: #86909C; }

/* ============================================================
 * 以下为功能弹层 / 列表样式，追加在骨架之后
 * ============================================================ */

/* ---------- 语音条 ---------- */
.voice-bar {
  background: #F0F5FF;
  border-radius: 40rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}
.voice-ic {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}
.voice-info { flex: 1; margin-left: 24rpx; min-width: 0; }
.voice-title { font-size: 28rpx; color: #245BDB; }
.voice-sub { margin-top: 4rpx; font-size: 24rpx; color: #86909C; }
.voice-btn {
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  color: #3370FF;
  font-size: 26rpx;
  line-height: 64rpx;
}

/* ---------- 卡片 ---------- */
/* 卡片统一用全局玻璃材质（app.wxss .card）；本页不再覆写成纯白（v0.7.19 需求③） */
.card-head {
  height: 88rpx;
  padding: 0 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid #F2F3F5;
}
.card-title { font-size: 30rpx; font-weight: 600; color: #1D2129; }
.card-link { font-size: 26rpx; color: #3370FF; }
.card-sub { font-size: 24rpx; color: #86909C; }

/* ---------- 课次行 ---------- */
.course-row {
  position: relative;
  padding: 16rpx 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  border-bottom: 2rpx solid #F2F3F5;
}
.course-row:last-child { border-bottom: none; }
.course-row.mine { background: #F7F8FA; }
/* 选修课行（2026-10-16 首页并入本人选修课）：**浅蓝强调底** + 左侧蓝色条 ——
   2026-10-29 三轮定稿：先 #F7FAFF（近白，像白块）→ 透明（无区分）→ 现 #D6E4FF
   （比课表页 PERSONAL_BG #EAF1FF 更深一档，蓝色更明确、强调可辨，深色文字仍清晰）。
   🔴 不加 tappable：它不驱动值日、也没有课堂情况名单 ⇒ 纯展示行。 */
.course-row.personal { background: #D6E4FF; }
.course-row.personal .course-bar { background: #3370FF; opacity: 0.45; }
.course-bar {
  position: absolute;
  left: 32rpx;
  top: 24rpx;
  width: 6rpx;
  height: 64rpx;
  border-radius: 3rpx;
  background: #E5E6EB;
}
.course-bar.on { background: #3370FF; }
/* 左列（时间 + 地点竖排）：紧凑成栈，两行间距与单行行一致（4rpx）。
   2026-10-15 结构调整：过去时间+课名同排、地点挂在整行下面 —— 课名折两行时
   时间和地点之间被撑开一大段。现在左列独立成栈，课名作为行的直接子元素，
   靠 .course-row 的 align-items:center 相对左列**上下居中**。 */
.course-side { margin-left: 24rpx; flex-shrink: 0; }
/* 时间列固定宽 ⇒ 课程名左缘全行对齐。
   ⚠️ 宽度只给到刚好装下「08:10-09:50」（24rpx 字号下约 140rpx，取 152 留余量）——
   曾经给到 216rpx，多出的 70rpx 全变成课程名前的空白，长课名被挤到省略号
   （2026-10-15 用户实拍：名称和时间之间一大段空、且显示不全）。改时间格式前先核这列宽。 */
.course-time { font-size: 24rpx; color: #86909C; width: 152rpx; flex-shrink: 0; }
/* 课名：最多两行（2026-10-15 需求：单行放不下的用两行显示），两行仍放不下才省略。
   ⚠️ 用 -webkit-box + line-clamp 才能拿到「两行 + 末尾省略号」；换成普通 block + height
   会有「第二行只露出半截」的破相。
   align-self: flex-start —— 课名**靠上**（首行与左列「时间」那行平齐），不跟着行居中。
   ⚠️ 只改课名自己的对齐：行上的 align-items:center 仍管右侧「A 组 / 全体」标签居中，
      别把整行改成 flex-start，那样标签会顶上去。 */
.course-name {
  font-size: 30rpx;
  color: #1D2129;
  align-self: flex-start;
  /* 与左侧时间列的间距：约两个小字字符宽（时间列字号 24rpx × 2）。
     2026-10-15 定：16rpx 太挤、再放宽到 48rpx。要改只动这一个值。 */
  margin-left: 48rpx;
  flex: 1;
  min-width: 0;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.course-room { margin-top: 4rpx; font-size: 24rpx; color: #86909C; }
.tag {
  flex-shrink: 0;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  line-height: 40rpx;
}
.tag.ga { background: #F0F5FF; color: #3370FF; }
.tag.gb { background: #F3F0FF; color: #7C5CFF; }
.tag.all { background: #F2F3F5; color: #4E5969; }
/* 选修课角标（2026-10-16 首页并入本人选修课）：配色对齐课表页的 PERSONAL_BG/PERSONAL_FG，
   让选修课在首页与课表页里是一眼同源的两处显示。 */
.tag.elective { background: #EAF1FF; color: #3370FF; }
.no-course {
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #86909C;
}

/* ---------- 快捷入口已下线（.quick / .quick-item 一并删除） ---------- */

/* ---------- 提醒卡 ---------- */
.remind {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 32rpx;
}
.remind-info { flex: 1; margin-left: 24rpx; }
.remind-title { font-size: 30rpx; color: #1D2129; }
.remind-sub { margin-top: 4rpx; font-size: 24rpx; color: #86909C; }
.remind-done {
  display: flex;
  flex-direction: row;
  align-items: center;
  color: #00B42A;
  font-size: 26rpx;
}

/* ---------- 管理员 ---------- */
.admin-card { position: relative; padding: 32rpx 0 24rpx; }
.admin-tag {
  position: absolute;
  right: 24rpx;
  top: 20rpx;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  background: #F3F0FF;
  color: #7C5CFF;
  font-size: 22rpx;
  line-height: 40rpx;
}
/* 职位头衔三色分层（超管金 / 班委蓝 / 辅导员青） */
.admin-tag.super { color: #D46B08; background: #FFF3C2; }
.admin-tag.committee { color: #3370FF; background: #F0F5FF; }
.admin-tag.counselor { color: #0AA5A8; background: #E8FFFB; }
.admin-grid { display: flex; flex-direction: row; }
.admin-cell {
  flex: 1;
  height: 144rpx;
  margin: 0 12rpx;
  background: #F7F8FA;
  border-radius: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.admin-cell text { margin-top: 12rpx; font-size: 26rpx; color: #1D2129; }
.admin-cell:active { background: #F0F5FF; }

/* ---------- 提醒卡 · 测试提醒入口（开启后出现；点击发一条测试订阅消息并弹窗回访） ---------- */
.remind-test { margin-top: 8rpx; font-size: 24rpx; color: #3370FF; }
.remind-test.busy { opacity: 0.5; }

/* ---------- 查看通知（§41 需求⑦）全员可见 ---------- */
.notice-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 32rpx;
}
.notice-card:active { background: #F2F3F5; }
.notice-info { flex: 1; margin-left: 24rpx; }
.notice-title { font-size: 30rpx; color: #1D2129; }
.notice-sub { margin-top: 4rpx; font-size: 24rpx; color: #86909C; }
.notice-badge {
  flex-shrink: 0;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: #FFFFFF;
  background: #F53F3F;
  border-radius: 999rpx;
  margin-right: 12rpx;
}

/* ---------- 发布通知 · 多班级选班（§43 需求⑥） ---------- */
/* .np-link-hint（金山文档链接预警）已于 2026-10-27 随发布表单提升到 app.wxss */

/* ---------- 更新公告（v0.7.25）：主页弹层 ---------- */
.an-view {
  padding: 24rpx 32rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}
.an-view-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 16rpx;
}
.an-view-scroll {
  max-height: 560rpx;
}
.an-view-content {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  color: #4E5969;
  white-space: pre-wrap;
  word-break: break-all;
}
.an-view-btn {
  margin-top: 32rpx;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, #EC4899, #8B5CF6);
}

/* ---------- 首页请假卡（1.0.5 追加，需求①②） ---------- */
.leave-home { display: flex; flex-direction: column; padding: 24rpx 32rpx; }
.lh-head { display: flex; align-items: baseline; justify-content: space-between; }
.lh-title { font-size: 30rpx; font-weight: 600; color: #1D2129; }
.lh-date { font-size: 22rpx; color: #86909C; }
.lh-body { display: flex; align-items: baseline; margin: 16rpx 0 12rpx; }
.lh-num { font-size: 64rpx; font-weight: 700; color: #1D2129; line-height: 1; }
.lh-num.warn { color: #D46B08; }
.lh-unit { margin-left: 12rpx; font-size: 26rpx; color: #4E5969; }
.lh-foot { display: flex; align-items: center; font-size: 24rpx; color: #86909C; }
.lh-grp { margin-right: 24rpx; }
.lh-more { margin-left: auto; color: #3370FF; }
.lh-classes { display: flex; flex-direction: column; margin-top: 12rpx; }
.lh-cls {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 0; border-bottom: 2rpx solid #EEF0F3;
}
.lh-cls:last-child { border-bottom: none; }
.lh-cls-name { font-size: 28rpx; color: #1D2129; }
.lh-cls-num { font-size: 28rpx; color: #D46B08; }
.lh-empty {
  padding: 20rpx 0; font-size: 24rpx; color: #86909C;
  text-align: center; background: #F7F8FA; border-radius: 24rpx;
}

/* ---------- 请假名单（首页查看弹层，与 roster 同视觉） ---------- */
.lv { padding: 8rpx 32rpx 40rpx; }
.lv-grp { margin-top: 16rpx; }
.lv-grp-t { display: block; margin-bottom: 8rpx; font-size: 26rpx; font-weight: 600; color: #1D2129; }
.lv-row { display: flex; align-items: center; padding: 16rpx 0; border-top: 2rpx solid #EEF0F3; }
.lv-row:first-of-type { border-top: none; }
.lv-info { flex: 1; min-width: 0; margin-left: 16rpx; display: flex; flex-direction: column; }
.lv-name { font-size: 28rpx; color: #1D2129; }
/* 「已过时段」角标（2026-10-09 需求①）：卡片大数字已改成**实时口径**，
 * 但弹层名单仍是日期口径（含已过时段）—— 不标出来的话，用户会看到
 * 「卡片说 0 人请假、名单里却有人」，以为两个数字打架。
 * ⚠️ 底色 token 是 `--bg-fill`（**没有** `--fill-2` —— 写错不报错，只是背景透明）。 */
.lv-over {
  margin-left: 12rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  color: var(--text-3);
  background: var(--bg-fill);
  border-radius: 8rpx;
}
.lv-sub { margin-top: 4rpx; font-size: 22rpx; color: #86909C; }
/* 行内按钮：假条（实心=有图可看） / 传假条（幽灵=去上传）
 * 1.0.6：原来这里是「撤销」。撤销**只在请假登记里保留**（首页离登记入口太远，
 * 误触成本高），首页这一位让给更高频的假条。
 * ⚠️ 视觉必须与 roster 页的 .lv-btn 完全一致（同一套 class 名）。 */
.lv-btn {
  flex-shrink: 0; padding: 0 20rpx; height: 56rpx; line-height: 56rpx;
  font-size: 24rpx; color: #FFFFFF; background: var(--brand); border-radius: 999rpx;
}
.lv-btn.ghost { color: var(--brand); background: var(--brand-light); }
.lv-btn.ghost:active { background: var(--brand-light-hover); }

/* 1.0.6 需求③：行尾不再写「假条」两个字，改**缩略图** ——
   一眼就能看出「这张假条传了没有」，比文字标签直观得多（文字看不出有没有图）。
   ⚠️ 尺寸与 roster 页历史行的 .lv-thumb 完全一致（72rpx），两处必须长得一样；
      换不到临时链接时退回「假条」二字，绝不留一个空白方块。 */
.lv-thumb {
  flex-shrink: 0; width: 72rpx; height: 72rpx;
  overflow: hidden; background: var(--bg-fill); border-radius: 12rpx;
}
.lv-thumb-img { width: 72rpx; height: 72rpx; }
.lv-thumb-t {
  display: block; width: 72rpx; height: 72rpx;
  line-height: 72rpx; text-align: center; font-size: 20rpx; color: var(--brand);
}

/* 弹层底部：去请假登记的入口（撤销 / 补传假条都在那里）
 * 之所以要这一行：roster 不在 tabBar 里，撤销从首页走要 4 跳，不加指路牌等于没有。 */
.lv-goto {
  display: flex; align-items: center; justify-content: center;
  margin-top: 24rpx; padding: 20rpx 0;
  font-size: 24rpx; color: var(--text-3);
}
.lv-goto-t { margin-right: 4rpx; }
.lv-empty {
  padding: 28rpx 0; font-size: 24rpx; color: #86909C; text-align: center;
  background: #F7F8FA; border-radius: 24rpx;
}

/* ---------- 今日课次「已上完」灰化（2026-09-29 需求） ----------
 * 当前时间 ≥ 下课时间(periodTime.end)即整行变灰、降透明度；不论是否本人(isMine)课次都
 * 统一灰化，表达「这节课已经上完」。仅在 .course-row.done 上生效，明日课次无 done 故不受影响。 */
.course-row.done { opacity: 0.6; }
.course-row.done .course-name,
.course-row.done .course-time,
.course-row.done .course-room { color: #BFBFBF; }
.course-row.done .course-bar.on { background: #E5E6EB; }   /* 本人(isMine)蓝条也退回灰 */
.course-row.done .tag { background: #F2F3F5; color: #C9CDD4; }

/* 可点开的课次行（2026-10-09 需求②）：班长/副班长点它弹课堂情况。
 * ⚠️ 只给一个极轻的按压反馈，**不加箭头/下划线等「可点」暗示** ——
 *   用户没要求过要提示，课次行加了额外符号反而让它不像课次行。 */
.course-row.tappable:active { opacity: 0.75; }

/* ================= 课堂情况弹窗（2026-10-09 需求②） =================
 * ⚠️ 追加到**文件末尾**（本文件开头那段「页面骨架」不能动，见文件头注释：
 *    2026-09-25 踩过一次「追加到头部把骨架顶掉」，那次整页变样）。
 *
 * 2026-10-09 用户实拍后调整三处（这三条都是「能跑但不好看/点不到」）：
 *   ① 文本装进**玻璃卡片框**，与全站其它卡片（.card / .hero）同材质；
 *   ② **课程名上面要有班级名**（模板第一行）；
 *   ③ 「复制课堂情况」按钮**被悬浮 tabBar 压住** ⇒ footer 底部要让位。
 */
/* 🔴 左右必须留边距（2026-10-09 用户实拍「右侧大面积空白不好看」）：
   原来 `.ci` 写的是 `padding: 8rpx 0 0` —— **左右是 0**，而
   `.sheet-body-inner` 自己也没有内边距 ⇒ 卡片左右直接贴到弹层边缘。
   ⚠️ 32rpx 是**全站标准**（首页 `.wrap` 与 roster 的 `.lv` 都是 32rpx），
      不要自造一套数值，否则这张卡与全站其它卡片左边线对不齐。 */
.ci { padding: 8rpx 32rpx 0; }
.ci-loading {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-3);
}
/* 文本框：走全站玻璃卡片材质（与首页 .card 完全一致），而不是散在弹层背景上。
   ⚠️ 五行玻璃属性一个都不能少 —— 少 backdrop-filter 玻璃就不"透"（看着像块灰板）；
      少 border-radius / edge / shadow 就与全站卡片不像。写法照 app.wxss 的 .card。 */
.ci-card {
  display: flex;
  flex-direction: column;
  padding: 24rpx 28rpx;
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-edge);
  border-radius: var(--r-md);
  box-shadow: var(--glass-shadow), var(--glass-highlight);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
}
.ci-line {
  font-size: 28rpx;
  color: var(--text-1);
  line-height: 44rpx;
}
/* 班级名与课程名略加重，其余是正文（用户要求课程名上面有班级名 ⇒ 视觉上要分得出主次）。 */
.ci-cls { font-weight: 600; }
.ci-course { font-weight: 600; }
.ci-normal { color: var(--text-1); }
.ci-absent { color: var(--text-1); }
.ci-none {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: var(--text-3);
  background: var(--bg-fill);
  border-radius: 12rpx;
}
/* 🔴 底部让位：悬浮 tabBar 压在 footer 上，不让位的话按钮被盖住点不到（用户实拍）。
   ⚠️ 写法照 duty-sheet/index.wxss 的同名处理（bottom-sheet 的 .sheet-footer
      注释明确写了「让位由内容自己写 padding-bottom」，别去改组件）。
   max() 那条给不支持 env() 的 WebView 兜底 32px。 */
.ci-foot {
  display: flex;
  padding-bottom: calc(114rpx + max(env(safe-area-inset-bottom), 32px));
}
.ci-copy {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: var(--brand);
  border-radius: 999rpx;
}

/* ---------- 作业提交播报（2026-10-28，取代原远程配置横幅） ----------
 * 一条浅蓝提示条：左边小铃铛，右边一行滚动文字。
 * 生命周期：出现 → 逐条上滚 → 播完淡出并塌陷高度（.home-feed-out）→ wx:if 整体移除。
 * 🔴 左右 32rpx（全站标准，见 .wrap），绝不贴边。 */
.home-feed {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 32rpx 0;
  padding: 18rpx 28rpx;
  background: #F0F5FF;
  border: 2rpx solid #DCE8FF;
  border-radius: 24rpx;
  overflow: hidden;
  /* 收起靠 max-height 塌陷 —— 不能写 height:auto（WXSS 里 auto 不参与过渡）。
     80rpx = padding 18×2 + 行高 40 + border 2×2，写实测值，写大了收尾会先「空一段」。 */
  max-height: 80rpx;
  opacity: 1;
  /* ⚠️ 必须写**一行**：check-wxss 把「属性值换行」判成「漏了分号」（它对多行 transition
     的值不友好）。下面 .home-feed-track 的单属性过渡同理只写一行。 */
  transition: max-height 0.28s ease, margin-top 0.28s ease, padding 0.28s ease, opacity 0.22s ease, border-width 0.28s ease;
}
.home-feed-out {
  max-height: 0;
  margin-top: 0;
  padding-top: 0;
  padding-bottom: 0;
  border-width: 0;
  opacity: 0;
}
.home-feed-hover { background: #E3EDFF; }

/* 只装一行的高度窗口：多出来的裁掉，track 上移时上一条自然滚出去 */
.home-feed-body {
  flex: 1;
  min-width: 0;
  height: 40rpx;
  overflow: hidden;
}
.home-feed-track {
  transition: transform 0.42s cubic-bezier(0.22, 0.61, 0.36, 1);
}
.home-feed-line {
  height: 40rpx;
  line-height: 40rpx;
  font-size: 26rpx;
  color: #245BDB;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* 人名加粗、「提交了《…》」常规 —— 一眼分得清「谁」和「交了什么」 */
.home-feed-name { font-weight: 600; }
.home-feed-text { font-weight: 400; }
