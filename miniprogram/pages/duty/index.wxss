/* 主内容滚动交给 spring-scroll（v0.7.19 需求④）：页面根不再原生滚动，
   height:100vh + overflow:hidden 防止与 spring-scroll 双重滚动。 */
.dt { height: 100vh; overflow: hidden; display: flex; flex-direction: column; }
.dt-scroll { display: block; }
.dt-wrap { padding: 24rpx 32rpx; }
.dt-nav-btn { font-size: 30rpx; color: var(--brand); padding: 0 16rpx; }

/* 卡片统一用全局玻璃材质（app.wxss .card）；本页不再覆写成纯白，
   与「我的」页下方卡片保持一致（v0.7.19 需求③）。 */
.card {
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-edge);
  border-radius: var(--r-md);
  box-shadow: var(--glass-shadow), var(--glass-highlight);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  overflow: hidden;
}
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .card { background: var(--bg-card, rgba(255, 255, 255, 0.9)); }
  .dt-view-tabs, .dt-admin-btn { background: var(--tabbar-solid, rgba(255, 255, 255, 0.88)); }
  .sp-ai-actions .btn { background: var(--tabbar-solid, rgba(255, 255, 255, 0.88)); }
}
@media (prefers-reduced-transparency: reduce) {
  .card { background: var(--bg-card); -webkit-backdrop-filter: none; backdrop-filter: none; }
  .dt-view-tabs, .dt-admin-btn {
    background: var(--tabbar-solid, rgba(255, 255, 255, 0.88));
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  .sp-ai-actions .btn {
    background: var(--tabbar-solid, rgba(255, 255, 255, 0.88));
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
}
.dt-daycard { margin: 0 32rpx 24rpx; }
.dt-dayhead {
  height: 80rpx;
  padding: 0 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid var(--bg-fill);
}
.dt-daytitle { font-size: 30rpx; font-weight: 600; color: var(--text-1); }
.dt-daysub { font-size: 24rpx; color: var(--text-3); }
.dt-dayfoot {
  height: 64rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 24rpx;
  color: var(--text-3);
}

.dt-row {
  position: relative;
  min-height: 112rpx;
  padding: 16rpx 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  border-bottom: 2rpx solid var(--bg-fill);
}
.dt-row:last-child { border-bottom: none; }
.dt-row.mine { background: var(--brand-light); }
.dt-row.sub { background: var(--fill-soft); }
.dt-row-bar {
  position: absolute;
  /* 落在行左 padding（32rpx）的空隙内：既不被序号牌遮挡，也不占用内容宽度 */
  left: 14rpx;
  top: 24rpx;
  width: 6rpx;
  height: 64rpx;
  border-radius: 3rpx;
  background: var(--brand);
}
.dt-row-info { flex: 1; margin-left: 24rpx; min-width: 0; }
.dt-row-edit { margin-left: 12rpx; font-size: 24rpx; color: var(--brand); flex-shrink: 0; }
.dt-row-name { font-size: 30rpx; color: var(--text-1); }
.dt-row.mine .dt-row-name { font-weight: 600; }
.dt-row-sub { font-size: 24rpx; color: var(--text-3); display: block; margin-top: 4rpx; }
/* 保洁角标 + 姓名行（让「保洁」紧贴姓名后，不挤占副标题） */
.dt-row-namerow { display: flex; align-items: center; }
.dt-clean-tag {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: #FFFFFF;
  background: var(--success);
  border-radius: 16rpx;
  flex-shrink: 0;
}


.dt-admin {
  display: flex;
  flex-direction: row;
  align-items: center;
  /* 右对齐 + max-width 组合：4 格（含「历史」）时平分铺满，
     3 格（无历史）时也平分，只有 1 格（普通成员仅「历史」）时靠右成胶囊，不会拉成一整条。 */
  justify-content: flex-end;
  padding: 8rpx 32rpx 0;
  margin-bottom: 24rpx;
}
.dt-admin-btn {
  flex: 1;
  max-width: 220rpx;
  min-width: 0;
  height: 80rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 4 格同排：字号收到 26rpx、横向内边距收到 8rpx，「清空值日表」5 字才不会撑爆 */
  font-size: 26rpx;
  white-space: nowrap;
  margin-right: 16rpx;
  padding: 0 8rpx;
  /* 玻璃按钮（2026-11-17）：与底部导航栏同一套 --tabbar-* 令牌 —— 半透明底 + 背景模糊 +
     亮边 + 柔和投影 + 顶部内高光；深浅色由令牌自动翻（页面 wxss 不写死色值）。
     下面的变体只改文字色，不再各铺一层实底，否则玻璃被盖住、看起来还是老的色块按钮。 */
  background: var(--tabbar-bg, rgba(255, 255, 255, 0.35));
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  backdrop-filter: blur(24px) saturate(180%);
  border: 1rpx solid var(--tabbar-edge, rgba(255, 255, 255, 0.6));
  box-shadow:
    var(--tabbar-shadow, 0 8rpx 28rpx rgba(29, 33, 41, 0.14)),
    var(--tabbar-highlight, inset 0 1rpx 0 rgba(255, 255, 255, 0.95));
}
.dt-admin-btn:last-child { margin-right: 0; }
.dt-admin-btn.ghost { color: var(--text-2); }
.dt-admin-btn.primary { color: var(--brand); font-weight: 600; border-color: var(--brand-disable); }
.dt-admin-btn.danger { color: var(--danger); border-color: var(--danger); }
.dt-admin-btn:active { opacity: 0.85; }

/* 普通管理员提示：值日表的生成/发布仅超级管理员可操作 */
/* v0.7.18 需求④：解释性文字一律**不带背景底色**，只作纯文字（用户口径「仅显示文字解释」）。
   原来的暖黄底块会被读成「告警卡片」，但它只是一句说明 —— 去掉底与圆角，靠字色区分语气。 */
.dt-admin-tip {
  margin: 16rpx 32rpx 24rpx;
  color: var(--warning-strong);
  font-size: 24rpx;
  line-height: 1.6;
}

/* ---------- 合并行（1.0.4.4 #27） ----------
   同一节课若干人合成一行：名牌区两列排布（每人一格 = 序号牌 + 下方姓名），
   4 人自然落 2×2。 */
.dt-row.merged { align-items: center; border-bottom: none; }
/* 每节课值日之间一条灰色分隔线：用 `+` 相邻兄弟**只画在课次与课次之间**
   （首行之上、末行与「本日 N 次值日」之间都不画）。`~` 在真机 fatal，`+` 可用。 */
.dt-row.merged + .dt-row.merged { border-top: 2rpx solid var(--line-1); }
.dt-names {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
  align-items: center;
  /* 两列固定宽：2 × 96rpx。4 人（410大扫除）自然落 2×2；2~3 人仍并排不挤。
     每格内容居中 ⇒ 序号牌与姓名共中线（序号落在姓名正上方中间）；2 字 / 3 字姓名
     的序号中心恒等于格中心 ⇒ 整列纵向对齐、上下齐平。 */
  width: 192rpx;
  flex-shrink: 0;
}
/* 每名成员一格（固定宽、内容居中）：序号牌在上、姓名在下，二者共中线 */
.dt-nm {
  width: 96rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 6rpx 0;
}
.dt-nm .avatar-tag { margin: 0; }
.dt-nm-name {
  margin-top: 6rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.3;
  color: var(--text-1);
  text-align: center;
  white-space: nowrap;
}
.dt-foot { height: 240rpx; }

/* ---------- 合并行成员弹层（1.0.4.4 #27） ---------- */
.dt-group { padding: 8rpx 0 24rpx; }
.dt-group-row {
  position: relative;
  min-height: 112rpx;
  padding: 16rpx 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  border-bottom: 2rpx solid var(--bg-fill);
}
.dt-group-row:last-child { border-bottom: none; }
.dt-group-row.mine { background: var(--brand-light); }

/* ---------- 一键生成 / AI 排班弹层 ---------- */
.ai { padding: 8rpx 32rpx 48rpx; }
/* v0.7.18 需求④：同上 —— 纯说明文字，不要底色 */
.ai-tip {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-3);
  margin-bottom: 24rpx;
}
.ai-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 176rpx;
  padding: 20rpx 24rpx;
  background: var(--fill-soft);
  border-radius: 32rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-1);
}

.ai-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 12rpx;
  font-size: 24rpx;
}
.ai-meta-k { color: var(--text-3); }
.ai-meta-v { color: var(--text-1); margin-left: 10rpx; flex: 1; }
.ai-meta-link { color: var(--brand); }

.ai-prompt { margin-top: 16rpx; }
.ai-prompt-input {
  width: 100%;
  box-sizing: border-box;
  max-height: 520rpx;
  padding: 20rpx 24rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--line-1);
  border-radius: 32rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-2);
}
.ai-prompt-reset {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--brand);
}

.ai-nokey {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: var(--warning-bg);
  border-radius: 24rpx;
  color: var(--warning-strong);
  font-size: 24rpx;
  line-height: 1.6;
}

.ai-actions {
  display: flex;
  flex-direction: row;
  margin-top: 28rpx;
}
.ai-btn {
  height: 88rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  padding: 0 32rpx;
  margin-right: 16rpx;
}
.ai-btn:last-child { margin-right: 0; }
.ai-btn.ghost { background: var(--bg-fill); color: var(--text-2); }
.ai-btn.primary { flex: 1; background: var(--brand); color: #FFFFFF; font-weight: 600; }
.ai-btn.off { opacity: 0.5; }
.ai-btn:active { opacity: 0.85; }

.ai-result { margin-top: 32rpx; }
.ai-result-head {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 8rpx;
}
.ai-plan-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--bg-fill);
}
.ai-plan-when {
  width: 200rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--text-2);
}
.ai-plan-right {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
}
.ai-plan-who {
  font-size: 27rpx;
  color: var(--text-1);
  text-align: right;
}
.ai-plan-tag {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 20rpx;
  color: var(--brand);
  background: var(--brand-light);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}
.ai-notes {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.6;
}
.ai-warn {
  display: flex;
  flex-direction: column;
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  background: var(--warning-bg);
  border-radius: 24rpx;
}
.ai-warn-line {
  font-size: 23rpx;
  color: var(--warning-strong);
  line-height: 1.6;
}

/* 「保持原样」的课次：视觉上明显区别于本次要重排的 */
.ai-plan-row.kept { opacity: 0.62; }
.ai-plan-row.kept .ai-plan-when { color: var(--text-3); }
.ai-plan-tag.keep { color: var(--text-3); background: var(--bg-fill); }

/* 保洁（打扫 410）：不与普通课次混排，单独一块展示，避免被误认为「没排」 */
.ai-clean {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: var(--success-bg);
  border: 1rpx solid var(--success-bg);
  border-radius: 24rpx;
}
.ai-clean .ai-result-head { color: #0E8420; }
.ai-plan-row.clean { border-bottom-color: var(--success-bg); }
.ai-plan-row.clean .ai-plan-when { color: #0E8420; }
.ai-plan-tag.clean { color: #0E8420; background: var(--success-bg); }
/* 深色下提亮：深绿压深绿 tint 看不清（浅色不变） */
.t-dark .ai-clean .ai-result-head,
.t-dark .ai-plan-row.clean .ai-plan-when,
.t-dark .ai-plan-tag.clean { color: var(--success); }

/* 失败详情：以前这里什么都不显示，用户根本无从反馈 */
.ai-err {
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: var(--danger-bg);
  border: 1rpx solid var(--danger-bg);
  border-radius: 24rpx;
}
.ai-err-t {
  font-size: 25rpx;
  font-weight: 600;
  color: #CF1322;
}
.ai-err-msg {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #A8071A;
  line-height: 1.6;
  word-break: break-all;
}
.t-dark .ai-err-t,
.t-dark .ai-err-msg,
.t-dark .ai-diag-v.err { color: var(--danger); }
.ai-err-bar { display: flex; margin-top: 16rpx; }
.ai-err-btn {
  margin-right: 28rpx;
  font-size: 24rpx;
  color: var(--brand);
  padding: 6rpx 0;
}
.ai-err-btn:active { opacity: 0.6; }

/* 自检面板（2026-10-28 改为默认收起）
 * 收起态 = 一行「自检结果 · 结论 · 展开」，点整行切换；
 * 明细在 .ai-diag-body 里，展开才渲染（wx:if，不是隐藏），列表长度不受影响。 */
.ai-diag {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  background: var(--fill-soft);
  border-radius: 24rpx;
}
.ai-diag-hd {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.ai-diag-hd-t {
  flex-shrink: 0;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--text-1);
}
.ai-diag-hd-s {
  flex: 1;
  margin: 0 12rpx;
  font-size: 22rpx;
  color: var(--text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ai-diag-arrow {
  flex-shrink: 0;
  padding: 8rpx 0 8rpx 8rpx;
  font-size: 22rpx;
  color: var(--brand);
}
.ai-diag-arrow:active { opacity: 0.6; }
.ai-diag-body { margin-top: 14rpx; }
.ai-diag-row { display: flex; margin-bottom: 8rpx; }
.ai-diag-k {
  flex-shrink: 0;
  width: 190rpx;
  font-size: 22rpx;
  color: var(--text-3);
}
.ai-diag-v {
  flex: 1;
  font-size: 22rpx;
  color: var(--text-1);
  word-break: break-all;
}
.ai-diag-v.err { color: #CF1322; }
.ai-diag-copy {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--brand);
}
.ai-diag-copy:active { opacity: 0.6; }

/* ============ 教职工班级筛选（v0.7.16 需求⑧） ============
   几何与 classes 页 .cl-fchip 同规格：chip-motion 基类管过渡，
   选中态 padding/font-size 变大 = 布局真变大，邻项被平滑推开；
   flex-wrap 支持小屏换行；保持顺序、不重叠。 */
/* 顶部工具行（2026-11-14）：班级下拉 + 「历史」同一行。
   ⚠️ z-index 必须抬高：下拉浮层是 absolute，若本行停在 auto，后面的 .dt-admin 按钮行与
      .dt-admin-tip（都在 DOM 后面）会盖在浮层之上 —— 用户截图里「历史」和橙色提示文字
      压在班级列表上就是这个原因。 */
.dt-toolbar {
  position: relative;
  z-index: 20;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 32rpx 16rpx;
}

/* 班级下拉容器（组件自带字段/浮层样式，这里只管它在行内的伸缩） */
.dt-clsw {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
}

/* 「历史」：右侧轻量胶囊，与左上角的班级字段同一行。
   原来它是 .dt-admin 里的一个按钮（flex:1 + max-width:220rpx）——
   辅导员没有排班权时那一行只剩它，视觉上就是「历史独占一行」。 */
.dt-hist {
  flex: 0 0 auto;
  padding: 8rpx 22rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--text-2);
  /* 复用 .dt-admin-btn 的玻璃底/亮边/模糊，只在这里收窄尺寸 */
}

/* ============ 加值日生弹层（v0.7.16 需求③） ============
   ⚠️ cl-input / cl-sec / cl-staff-empty 是 classes 页的类名，**页面样式不共享**，
   这里必须本地定义（check-wxss 会抓「用了但没定义」）。 */
.dt-add { padding: 0 8rpx; }
.dt-add .cl-input {
  width: 100%;
  padding: 18rpx 22rpx;
  font-size: 27rpx;
  background: var(--fill-soft);
  border-radius: 24rpx;
  box-sizing: border-box;
}
.dt-add .cl-sec {
  margin: 6rpx 0 16rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-1);
}
.dt-add .cl-staff-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-3);
}
.dt-addrow {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 4rpx 24rpx 20rpx;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: var(--brand);
  border: 2rpx dashed var(--brand-disable);
  border-radius: 24rpx;
}
.dt-add-sess {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  margin-bottom: 12rpx;
  background: var(--fill-soft);
  border-radius: 14rpx;
}
.dt-add-back {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 14rpx;
  font-size: 26rpx;
  color: var(--brand);
}
.dt-add-kw { margin-bottom: 16rpx; }
.dt-add-mem {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  margin-bottom: 10rpx;
  background: var(--fill-soft);
  border-radius: 14rpx;
}
.dt-add-mem.taken { opacity: 0.5; }
.dt-add-taken {
  flex: 0 0 auto;
  font-size: 24rpx;
  color: var(--text-3);
}

/* ---------- 「历史」入口 + 弹层（2026-10-04 需求；2026-10-31 入口改版） ----------
 * 本周早于今天的日子不进「按日」主列表，收进「历史」弹层。
 * 入口已从「独立一行右对齐的 .dt-ended 胶囊」并进 .dt-admin 操作排（第 4 格，文案「历史」），
 * 故 .dt-modebar / .dt-ended 两条样式已随节点删除（避免留死代码）。 */
/* 今天起没有安排时的说明（否则按日会一片空白） */
.dt-ended-empty {
  margin: 0 32rpx 24rpx;
  padding: 48rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3, #86909C);
}
/* 弹层内列表：日期卡自带左右 32rpx 外边距，这里只补上下留白 */
.dt-ended-list { padding: 8rpx 0 24rpx; }

/* ---------- 排班方式 · 岗位槽（2026-10-28） ----------
 * 生活委员自定义「哪天 / 第几节 / 几个人」。
 * period 选「全天」= 承包一整天；选具体节次 = 该节单独一个岗位。
 * 保存只影响之后新生成的周。 */

/* 「一键生成」弹层里的入口行 */
.ai-slot {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: var(--fill-soft);
  border-radius: 16rpx;
}
.ai-slot:active { opacity: 0.85; }
.ai-slot-k { flex: 0 0 auto; font-size: 26rpx; color: var(--text-2, #4E5969); }
.ai-slot-v { flex: 1; text-align: right; font-size: 26rpx; color: var(--text-3, #86909C); }
.ai-slot-go { flex: 0 0 auto; margin-left: 12rpx; font-size: 26rpx; color: var(--brand, #3370FF); }

/* 弹层容器 */
.sl { padding: 8rpx 0 0; }
.sl-tip {
  margin: 0 24rpx 20rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-2, #4E5969);
  background: var(--brand-light, #F0F5FF);
  border-radius: 16rpx;
}

/* 小标题（适用星期 / 岗位）：分组用，弱于正文、强于表头 */
.sl-sec {
  margin: 0 24rpx 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-2, #4E5969);
}
.sl-sec-note {
  margin-left: 8rpx;
  font-weight: 400;
  color: var(--text-3, #86909C);
}

/* 适用星期 chips：勾中的每一天都套用下面这组岗位（一次设定，不用逐天重复填）。
 * 固定 7 个，用 flex:1 均分一行 —— 写死 min-width 在 750rpx 里塞 7 个必然换行。 */
.sl-days {
  display: flex;
  flex-direction: row;
  margin: 0 24rpx 24rpx;
}
.sl-day {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  margin-right: 8rpx;
  font-size: 24rpx;
  text-align: center;
  color: var(--text-2, #4E5969);
  background: var(--bg-fill, #F2F3F5);
  border-radius: 32rpx;
}
.sl-day:last-child { margin-right: 0; }
.sl-day.on {
  font-weight: 600;
  color: var(--brand, #3370FF);
  background: var(--brand-light, #F0F5FF);
  box-shadow: inset 0 0 0 2rpx var(--brand, #3370FF);
}
.sl-day:active { opacity: 0.85; }

/* 表头：与数据行同栅格（节次 200 + 人数 flex + 删除 60），保证列对齐 */
.sl-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 24rpx 12rpx;
  font-size: 22rpx;
  color: var(--text-3, #86909C);
}
.sl-h-pd { width: 200rpx; }
.sl-h-num { flex: 1; text-align: center; }
.sl-h-del { width: 60rpx; }

.sl-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 0 24rpx 12rpx;
  padding: 12rpx 16rpx;
  background: var(--bg-fill, #F2F3F5);
  border-radius: 16rpx;
}
.sl-pick { width: 200rpx; }
.sl-cell {
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  text-align: center;
  color: var(--text-1, #1D2129);
  background: var(--bg-card, #FFFFFF);
  border-radius: 12rpx;
}
.sl-num {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.sl-step {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 32rpx;
  color: var(--brand, #3370FF);
  background: var(--bg-card, #FFFFFF);
  border-radius: 12rpx;
}
.sl-step:active { opacity: 0.7; }
.sl-num-v {
  min-width: 56rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1, #1D2129);
}
.sl-del {
  width: 60rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--danger);
}
.sl-del:active { opacity: 0.7; }

.sl-empty {
  margin: 0 24rpx;
  padding: 40rpx 24rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-3, #86909C);
  background: var(--fill-soft);
  border-radius: 16rpx;
}

.sl-add {
  margin: 8rpx 24rpx 0;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--brand, #3370FF);
  background: var(--brand-light);
  border-radius: 16rpx;
}
.sl-add:active { opacity: 0.85; }

/* 底部操作条：复用全局 .btn / .btn-ghost / .f-actions，这里只补弹层内留白。
 * ⚠️ f-cancel / f-save 必须在**本页** wxss 里定义 —— WXSS 是页面级作用域，
 *    光靠别页的类名等于没样式（check-wxss 会直接判「用了但没定义」）。 */
.sl .f-actions { padding: 16rpx 24rpx 24rpx; }
.sl .f-cancel, .sl .f-save { flex: 1; }

/* 岗位列表容器：只补上下留白，纵向滚动交给 bottom-sheet 自己处理 */
.sl-list { padding: 0 0 8rpx; }

/* ── 主教室（2026-10-28）────────────────────────────────────
 * 18:10 保洁打扫的房间，落库 class.main_room（与后台「班级设置」同一字段）。
 * 形状抄 .sl-row：左右 24rpx、灰底圆角 16rpx，高度对齐 .sl-cell 的 64rpx，
 * 让「主教室」和上面的岗位行看起来是同一套表单，不是外挂一个输入框。 */
.sl-sec-gap { margin-top: 28rpx; }
.sl-room {
  margin: 0 24rpx 24rpx;
  padding: 0 20rpx;
  background: var(--bg-fill, #F2F3F5);
  border-radius: 16rpx;
}
.sl-room-inp {
  /* ⚠️ 小程序 input 不给 width 会按内容收缩（不是块级满宽），必须显式 100% */
  width: 100%;
  height: 84rpx;
  font-size: 28rpx;
  color: var(--text-1, #1D2129);
}
.sl-room-ph {
  font-size: 26rpx;
  color: var(--text-3, #86909C);
}

/* ── 18:10 打扫主教室（2026-10-28）────────────────────────────
 * 独立卡片，与大课岗位明显分区：上半永远是「标题 + 摘要 + 开关」，
 * 打开后才展开星期 / 人数，收起时弹层不会因为多一块而变长。 */
.sl-clean {
  margin: 24rpx 24rpx 0;
  padding: 20rpx 24rpx 8rpx;
  background: var(--fill-soft);
  border-radius: 16rpx;
}
.sl-clean-hd {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
}
.sl-clean-txt {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}
.sl-clean-t {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--text-1, #1D2129);
}
.sl-clean-s {
  margin-top: 4rpx;
  font-size: 23rpx;
  line-height: 1.4;
  color: var(--text-3, #86909C);
}
.sl-clean-body {
  padding-bottom: 16rpx;
}
/* 卡片内不再重复 24rpx 外边距（否则右侧会缩进成两级），底色也换白以便与卡片区分 */
.sl-clean-body .sl-sec { margin: 0 0 12rpx; }
.sl-clean-body .sl-days { margin: 0 0 8rpx; }
.sl-clean-body .sl-list { padding: 0; }
.sl-clean-body .sl-row { margin: 0 0 12rpx; background: var(--bg-card, #FFFFFF); }
.sl-clean-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-3, #86909C);
}

/* 值日 / 课前演讲 分段控件（v2 2026-11-17）：替换原独立页入口卡；不占 st-item 档位。
   轨道做成与底栏同款玻璃胶囊；选中项用 --tab-ind 品牌淡蓝（不是实底蓝），
   文字走 --brand —— 深浅色都由令牌翻，深色下是亮蓝 tint 浮起而非死蓝块。 */
.dt-view-tabs {
  display: flex;
  gap: 8rpx;
  margin: 16rpx 24rpx 4rpx;
  padding: 6rpx;
  border-radius: 999rpx;
  background: var(--tabbar-bg, rgba(255, 255, 255, 0.35));
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  backdrop-filter: blur(24px) saturate(180%);
  border: 1rpx solid var(--tabbar-edge, rgba(255, 255, 255, 0.6));
  box-shadow:
    var(--tabbar-shadow, 0 8rpx 28rpx rgba(29, 33, 41, 0.14)),
    var(--tabbar-highlight, inset 0 1rpx 0 rgba(255, 255, 255, 0.95));
}
.dt-view-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-2);
  transition: background .24s ease, color .24s ease;
}
.dt-view-tab.on {
  background: var(--tab-ind, rgba(51, 112, 255, .22));
  color: var(--brand);
  box-shadow: inset 0 1rpx 0 var(--tab-ind-edge, rgba(255, 255, 255, .6));
}

/* 值日 ↔ 课前演讲 切换：淡入 + 轻微上浮（仅切换时播，首屏不播）。
   .vp-anim 由 onViewMode 与 viewMode 同一次 setData 下发，wx:if 换新节点即播一次。
   ⚠️ 只动 transform / opacity（合成层）；位移 16rpx 与 st-item 入场同量级、但不叠加首屏。 */
@keyframes dtViewIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.dt-vp.vp-anim { animation: dtViewIn .24s cubic-bezier(.23, 1, .32, 1) both; }
@media (prefers-reduced-motion: reduce) {
  .dt-vp.vp-anim { animation: none; }
}

/* ===== 课前演讲视图（v2，从独立页搬入，令牌走 var(--x,兜底)） ===== */
.sp-legend { display: flex; justify-content: space-between; padding: 12rpx 28rpx; }
.sp-leg { font-size: 22rpx; color: var(--text-3); }
.sp-tip { padding: 4rpx 24rpx 12rpx; font-size: 22rpx; color: var(--text-3); }
.sp-days { padding: 8rpx 24rpx 40rpx; }
.sp-day { margin-bottom: 20rpx; padding: 20rpx 24rpx; }
.sp-day-head { display: flex; align-items: baseline; gap: 14rpx; margin-bottom: 14rpx; }
.sp-date { font-size: 28rpx; font-weight: 700; color: var(--text-1); }
.sp-wd { font-size: 22rpx; color: var(--text-3); }
.sp-slot { display: flex; align-items: center; gap: 16rpx; padding: 10rpx 0; }
/* A/B 两组课不同时段（split）：标签与第一行文字对齐，不要被两行内容顶到中间 */
.sp-slot.split { align-items: flex-start; }
.sp-slot-tag { flex: 0 0 76rpx; text-align: center; font-size: 22rpx; font-weight: 600; padding: 6rpx 0; border-radius: 10rpx; }
.sp-slot-tag.am { background: var(--brand-light); color: var(--brand); }
.sp-slot-tag.pm { background: var(--warning-bg); color: var(--warning); }
/* 一行 = 一个组（A 组 / B 组 / 全体），组别小标恒在行首；姓名胶囊里只有姓名 */
.sp-lines { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10rpx; }
.sp-line { display: flex; align-items: center; gap: 12rpx; }
/* 定宽：A组 / B组 / 全体 都是两个字，定宽让多行时姓名左边对齐成一条线 */
.sp-line-tag { flex: 0 0 64rpx; text-align: center; border-radius: 8rpx; font-size: 20rpx; line-height: 32rpx; font-weight: 600; background: var(--brand-light); color: var(--brand); }
.sp-line-tag.all { background: var(--fill-soft); color: var(--text-3); }
.sp-persons { display: flex; flex-wrap: wrap; gap: 12rpx; flex: 1; }
/* 姓名胶囊：胶囊宽度随姓名容器定宽而恒定 ⇒ 一行里第二个人的起始位置也齐 */
.sp-person { display: flex; align-items: center; padding: 8rpx 16rpx; border-radius: 999rpx; background: var(--fill-soft); }
/* 姓名分散对齐（1.0.8.58）：定宽 = 26rpx × 3 字，逐字当 flex item，
   space-between 把 2 字名的两个字推到两端，与 3 字名左右都齐。
   ⚠️ 改字号必须同步改这个宽度（约等于 字号 × 3） */
.sp-name { display: flex; justify-content: space-between; align-items: center; width: 78rpx; }
.sp-name.wide { width: auto; }
.sp-char { font-size: 26rpx; color: var(--text-1); font-weight: 500; }
/* 仅「智能排班」预览用：那里是一人一行的流水账，行尾跟一个小字说明组别；
   卡片时段视图已改成一行的组别小标在前，不用这个 */
.sp-scope { font-size: 20rpx; color: var(--text-3); }
.sp-scope.all { color: var(--brand); }
.sp-none { color: var(--text-4, #C9CDD4); font-size: 24rpx; }
.sp-foot { text-align: center; font-size: 22rpx; color: var(--text-3); padding: 12rpx 0; }
.sp-empty { padding: 80rpx 40rpx; text-align: center; }
.sp-empty-title { font-size: 30rpx; color: var(--text-2); font-weight: 600; }
.sp-empty-sub { font-size: 24rpx; color: var(--text-3); margin-top: 12rpx; }
.sp-skeleton { padding: 16rpx 24rpx; }
.sp-sk-row { height: 160rpx; border-radius: 20rpx; background: var(--fill-soft); margin-bottom: 20rpx; }
/* 弹层内表单容器：左右留白跟页面主栏对齐（32rpx）。
   ⚠️ 2026-11-17：原来是 8rpx，「用一句话描述排班」等文字几乎贴着弹层左沿（用户截图反馈）。
   这里是「演讲进度设置」和「智能排班」两个弹层共用的容器，改一处两边一起对齐。 */
.sp-form { padding: 8rpx 32rpx 20rpx; }
.sp-fld { margin-bottom: 24rpx; }
.sp-label { font-size: 26rpx; color: var(--text-2); margin-bottom: 12rpx; }
.sp-input { width: 100%; box-sizing: border-box; padding: 16rpx 20rpx; border-radius: 12rpx; background: var(--fill-soft); color: var(--text-1); font-size: 26rpx; }
.sp-form-note { font-size: 22rpx; color: var(--text-3); line-height: 1.6; }
/* 每场人数规则（演讲进度设置里，v3）：一场一行 + 右侧 1人/2人 分段 */
.sp-rules { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid var(--fill-soft); }
.sp-rules-title { font-size: 24rpx; font-weight: 600; color: var(--text-2); margin-bottom: 8rpx; }
.sp-rule { display: flex; align-items: center; gap: 16rpx; padding: 10rpx 0; }
.sp-rule-name { flex: 1; min-width: 0; font-size: 26rpx; color: var(--text-1); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.sp-need-seg { flex: 0 0 auto; display: flex; padding: 4rpx; border-radius: 999rpx; background: var(--fill-soft); }
.sp-need-opt { padding: 6rpx 20rpx; border-radius: 999rpx; font-size: 22rpx; color: var(--text-3); }
.sp-need-opt.on { background: var(--brand-light); color: var(--brand); font-weight: 600; }
.sp-rules-note { font-size: 22rpx; color: var(--text-3); line-height: 1.6; margin-top: 8rpx; }
.sp-ai-input { width: 100%; box-sizing: border-box; min-height: 140rpx; padding: 16rpx 20rpx; border-radius: 12rpx; background: var(--fill-soft); color: var(--text-1); font-size: 26rpx; }
.sp-ai-error { margin-top: 16rpx; padding: 16rpx 20rpx; border-radius: 12rpx; background: var(--danger-bg); color: var(--danger); font-size: 24rpx; line-height: 1.5; }
.sp-ai-preview-title { margin: 24rpx 0 12rpx; font-size: 26rpx; font-weight: 600; color: var(--text-1); }
.sp-ai-notes { font-size: 22rpx; color: var(--text-3); margin-bottom: 12rpx; }
.sp-ai-preview { max-height: 40vh; overflow-y: auto; }
.sp-ai-row { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 8rpx; border-bottom: 2rpx solid var(--nav-line); }
.sp-ai-date { font-size: 24rpx; color: var(--text-2); }
.sp-ai-slot { font-size: 22rpx; color: var(--text-3); }
.sp-ai-name { flex: 1; font-size: 24rpx; color: var(--text-1); }
/* 「指定」小标签：仅点名到号的预览行出现，提示这行不是轮转排的 */
.sp-ai-pin { flex: 0 0 auto; padding: 0 10rpx; border-radius: 8rpx; font-size: 20rpx; line-height: 28rpx; color: var(--brand); background: var(--brand-light); }
.sp-swap-list { max-height: 60vh; overflow-y: auto; }
.sp-swap-row { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 8rpx; border-bottom: 2rpx solid var(--nav-line); }
.sp-swap-name { font-size: 28rpx; color: var(--text-1); }
.sp-swap-seq { font-size: 24rpx; color: var(--text-3); }
/* 弹层底部操作条（miniprogram-page-conventions 第 6 条：flex 两按钮等宽） */
.f-actions { display: flex; gap: 20rpx; align-items: stretch; margin-top: 24rpx; }
.f-cancel, .f-save { flex: 1; }
.f-save.off { opacity: .5; }

/* ---------- 智能排班弹窗：三个按钮走底栏同款液态玻璃（2026-11-17 用户口径②） ----------
   ⚠️ `.btn` 自带 135° 紫→蓝→粉渐变（app.wxss），这里**必须显式覆盖 background**：
      只写文字色的话渐变仍会从 .btn 透上来 —— 用户截图里「解析预览 / 确认排班」
      两块彩色渐变就是这么来的。现在底 = --tabbar-* 令牌（深浅色自动翻），
      变体只改文字色：取消 / 解析预览 = 次级灰，确认排班 = 品牌蓝（主操作）。
   三个按钮等宽：.btn 默认不 flex，只靠 .f-cancel/.f-save 撑不开中间那个。 */
.sp-ai-actions .btn {
  flex: 1;
  min-width: 0;
  padding: 0 12rpx;
  background: var(--tabbar-bg, rgba(255, 255, 255, 0.35));
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  backdrop-filter: blur(24px) saturate(180%);
  border: 1rpx solid var(--tabbar-edge, rgba(255, 255, 255, 0.6));
  box-shadow:
    var(--tabbar-shadow, 0 8rpx 28rpx rgba(29, 33, 41, 0.14)),
    var(--tabbar-highlight, inset 0 1rpx 0 rgba(255, 255, 255, 0.95));
  color: var(--text-2);
}
.sp-ai-actions .btn.f-save { color: var(--brand); border-color: var(--brand-disable); }
