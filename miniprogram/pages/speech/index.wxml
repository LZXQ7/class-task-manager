<!-- 防滚动穿透：选人弹层打开时锁页面滚动（check-scroll-lock 守） -->
<page-meta page-style="{{pickerShow ? 'overflow:hidden' : ''}}"></page-meta>

<!-- 左右滑动切周：手势挂页面根节点（utils/swipe.js），选人弹层打开时在 onSwipeEnd 挡掉 -->
<view class="page ms page-fade {{tClass}}" bindtouchstart="onSwipeStart" bindtouchend="onSwipeEnd">

  <!-- 固定顶部：标题 4 字「演讲排班」，右侧留给系统胶囊（不另放状态文字） -->
  <nav-bar
    title="演讲排班"
    show-back="{{true}}"
    fixed="{{true}}"
    border="{{true}}"
    sheet-open="{{pickerShow}}"
  />

  <week-switcher
    week="{{week}}"
    total="{{totalWeeks}}"
    current="{{current}}"
    term-start="{{termStart}}"
    status-text="{{published ? '已发布' : '草稿'}}"
    status-type="{{published ? 'published' : 'draft'}}"
    bind:change="onWeekChange"
  />

  <view class="ms-tip">
    列出本周全部演讲场次（含还没排人的）。点「＋ 添加演讲」安排同学；点已排同学可换人或取消。上午 8:00–8:10、下午 14:30–14:40，每场 1~2 人。
  </view>

  <!-- 数据区：左右滑切周时整块做方向性过渡；fixed 元素（底部条）刻意留在外面 -->
  <view class="wk-swipe {{swipeCls}}">
    <skeleton wx:if="{{loading}}" type="card" rows="{{3}}" height="{{360}}" />

    <empty-state
      wx:elif="{{failed}}"
      icon="cloud-off"
      title="数据没加载出来"
      desc="检查网络后重试"
      btn-text="重新加载"
      bind:action="onReload"
      padding="{{140}}"
    />

    <block wx:elif="{{!days.length}}">
      <empty-state
        icon="empty-box"
        title="本周没有演讲场次"
        desc="先在课程表录入本周第1/3节集体课，再来安排"
        padding="{{140}}"
      />
    </block>

    <block wx:else>
      <view wx:for="{{days}}" wx:key="date" class="ms-day card">
        <view class="ms-dayhead">
          <text class="ms-daytitle">{{item.weekdayText}} {{item.dateText}}</text>
          <text class="ms-daysub">{{item.sessions.length}} 场</text>
        </view>

        <view
          wx:for="{{item.sessions}}"
          wx:for-item="s"
          wx:key="sessionId"
          class="ms-sess"
        >
          <view class="ms-sesshead">
            <text class="ms-sess-title">{{s.whenText}} · {{s.courseName}}</text>
            <text wx:if="{{s.scope !== 'ALL'}}" class="ms-sess-group">{{s.scope}} 组</text>
            <text wx:else class="ms-sess-group all">全体</text>
            <text class="ms-sess-count {{s.full ? 'ok' : ''}}">{{s.countText}}</text>
          </view>

          <view class="ms-chips">
            <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable
              wx:for="{{s.members}}"
              wx:for-item="m"
              wx:key="id"
              class="ms-chip"
              data-date="{{item.date}}"
              data-sid="{{s.sessionId}}"
              data-sid2="{{m.id}}"
              bindtap="onMemberTap"
            >
              <avatar-tag name="{{m.name}}" text="{{m.seqText}}" no-fallback="{{true}}" size="{{52}}" />
              <text class="ms-chip-name">{{m.name}}</text>
              <app-icon name="chevron-down" variant="gray" size="{{24}}" />
            </view>

            <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable
              class="ms-add"
              data-date="{{item.date}}"
              data-sid="{{s.sessionId}}"
              bindtap="onAdd"
            >
              <app-icon name="plus" variant="brand" size="{{28}}" />
              <text class="ms-add-text">添加演讲</text>
            </view>
          </view>
        </view>
      </view>

      <view class="page-foot-space"></view>
    </block>
  </view>

  <!-- 底部固定条：统计 + 发布 -->
  <view wx:if="{{!loading && !failed && days.length}}" class="ms-bar">
    <text class="ms-bar-text">共 {{stats.total}} 人次 · {{stats.people}} 人 · {{stats.sessions}} 场</text>
    <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable wx:if="{{published}}" class="ms-bar-btn ghost" bindtap="onUnpublish">撤回发布</view>
    <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable wx:else class="ms-bar-btn primary" bindtap="onPublish">发布给全班</view>
  </view>

  <!-- 选人弹层：姓名自动补全 -->
  <bottom-sheet
    show="{{pickerShow}}"
    title="{{pickerTitle}}"
    height="{{1040}}"
    tabbar="{{false}}"
    bind:close="onPickerClose"
  >
    <view class="pk">
      <name-autocomplete
        items="{{pickerItems}}"
        value="{{kw}}"
        placeholder="搜索姓名或序号"
        empty-text="没有匹配的同学"
        bind:input="onPickerKw"
        bind:pick="onPickAcMember"
      />
      <view class="pk-gap">
        <text class="pk-gap-text">{{pickerMode === 'SWAP' ? '共 ' + pickerCount + ' 人，选一位已排在其它场次的同学双向对调：他去你原场次演讲，你去他场次演讲。' : '共 ' + pickerCount + ' 人，灰色为不可选（已在此场次 / 分组不符）。演讲名册与「不排值日」无关，卫生值日跳过的人照样能演讲。'}}</text>
      </view>
    </view>
  </bottom-sheet>
</view>
