<!-- 防滚动穿透（v0.7.9）：弹层里的 scroll-view 滑到下沿后，touchmove 会继续冒泡给 page，
     「在弹层里滑到底 → 后面的页面跟着一起滑」就是这么来的。
     page-meta 的 page-style 是官方/社区验证的锁页面滚动方案（Vant Weapp 的 popup 同款）。
     ⚠️ 新增 / 改名的弹层 show 标志必须同步进下面表达式，否则 scripts/check-scroll-lock.js 会报错。 -->
<page-meta page-style="{{(detailShow || formShow || weekPickerShow || shiftShow || calShow) ? 'overflow:hidden' : ''}}"></page-meta>

<view class="page tt {{tClass}} {{paReady ? (animSeq === 0 ? 'pa-first' : (animSeq === 1 ? 'pa-lite-a' : 'pa-lite-b')) : 'pa-hold'}}">

  <nav-bar title="课表">
    <view slot="right" class="tt-nav-right">
      <text hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable wx:if="{{isSuper && hasTimetable && !isCounselor}}" class="tt-nav-btn" bindtap="onCalOpen">校历</text>
    </view>
  </nav-bar>

  <!-- 「切换测试账号」模拟态护栏（v1.0.5）：放导航栏正下方（本页无 spring-scroll，
       直接做块级元素即可；不参与 st-item 入场序列）。 -->
  <notice-bar
    wx:if="{{impersonateBanner}}"
    type="danger"
    icon="info"
    text="{{impersonateBanner}}"
    btnText="恢复本人"
    bind:action="onRecoverSelf"
  />

  <!-- addGlobalClass: true，外部 class 能作用到组件根节点，所以它也参与入场（st-item） -->
  <!-- ⚠️ 守卫两个维度互相独立、不能互相替代：学生的切周条跟「本班是否已有课表」走（hasTimetable，
       由云端同步结果决定）；辅导员的「看」走 canSwitchClass 切班分支，但仍须带 !isCounselor
       守住「不能借 hasTimetable 混进学生视图」的旧口径。 -->
  <week-switcher
    wx:if="{{(!isCounselor && hasTimetable) || (canSwitchClass && classList.length)}}"
    class="st-item st-1"
    week="{{week}}"
    total="{{totalWeeks}}"
    current="{{current}}"
    term-start="{{termStart}}"
    bind:change="onWeekChange"
    bind:pick="onWeekPick"
  />

  <!-- 切班查看（2026-11-14 用户需求③：横排 chips 改为下拉字段，只负责 1 个班也显示）
       可见范围仍是 showClassSwitch：仅「辅导员」与「超管且处于切换测试账号态」。
       ⚠️ 不要改回 canSwitchClass：canSwitchClass 还管周次条 / fab 菜单 / 分组「全部」默认 / 空态，
       真实超管看本班时仍需这些功能；切班条必须单独用 showClassSwitch 收口。 -->
  <view wx:if="{{showClassSwitch && classList.length}}" class="tt-clsw st-item st-2">
    <class-picker
      label="查看班级"
      list="{{classList}}"
      value="{{viewClassId}}"
      bind:change="onTimetableClass"
    />
  </view>

  <!-- 分组视图（A 组 / B 组）与「临时调课」合并进左下角悬浮入口（v0.7.21 需求③）：
       原来顶部一条 A/B 分段 + 左下角一个「临时调课」胶囊，同一件事散在两处。
       现在收成一个入口，点开向上展开三行：A 组 / B 组 / 临时调课（仅超管）。
       空出来的顶部位置也顺手还给了课表本体。 -->

  <!-- 本班在云端还没有课次的学生（且非辅导员/超管）：走空态（hasTimetable 由云端同步结果决定） -->
  <block wx:if="{{!canSwitchClass && !hasTimetable && !loading && !failed}}">
    <view class="tt-empty">
      <view class="tt-empty-title">课表待接入教务系统</view>
      <view class="tt-empty-desc">暂不展示课程表。学校教务系统开通后，这里会接入教务数据。</view>
    </view>
  </block>

  <!-- 辅导员/超管：未绑定任何班级（联系超管在「班级」里绑定） -->
  <block wx:elif="{{canSwitchClass && !classList.length && !loading && !failed}}">
    <view class="tt-empty">
      <view class="tt-empty-title">暂无可查看的班级</view>
      <view class="tt-empty-desc">你没有绑定任何班级，请联系超级管理员在「班级」里把你绑定到相应班级。</view>
    </view>
  </block>

  <!-- 辅导员/超管：所选班级在云端还没有课次（不渲染空网格，给明确空态） -->
  <block wx:elif="{{canSwitchClass && classList.length && !hasTimetable && !loading && !failed}}">
    <view class="tt-empty">
      <view class="tt-empty-title">该班还没有课表</view>
      <view class="tt-empty-desc">这个班级尚未录入课程表，录入后会自动显示在这里。</view>
    </view>
  </block>

  <!-- 加载 / 失败（骨架行数跟随本班节次数，2026-10-14 不再写死 5）
       🔴 2026-11-14 换法：骨架改成**与真实网格同构**（左节次条 + 5 个等分课格）。
       旧写法是在 `.tt-cells` 里塞通用 `<skeleton type="grid">`，而那个组件的格子固定
       220rpx 且 flex-wrap ⇒ 一屏里挤成「两竖列大白块」，与真实课表毫无相似之处，
       数据回来时整块版式还会跳一下（用户截图反馈）。 -->
  <block wx:elif="{{loading}}">
    <view class="tt-grid">
      <!-- 行高绑 rowH（与真实行同一个值）：骨架→数据不跳高度 -->
      <view class="tt-row" wx:for="{{periods.length ? periods : skPeriods}}" wx:key="p" style="height:{{rowH}}rpx">
        <view class="tt-time"><view class="tt-sk-time"></view></view>
        <view class="tt-cells">
          <view class="tt-sk-cell" wx:for="{{skCells}}" wx:for-item="c" wx:key="*this"></view>
        </view>
      </view>
    </view>
  </block>

  <empty-state
    wx:elif="{{failed}}"
    icon="cloud-off"
    title="课表没显示出来"
    desc="{{failMsg || '请重启小程序后重试'}}"
    btn-text="重新加载"
    bind:action="onReload"
    padding="{{160}}"
  />

  <block wx:else>
    <!-- 数据区（课表主体 / 提示 / 底部留白）：左右切换周时这一整块做方向性过渡，
         class 由 utils/swipe.js 下发、样式在 app.wxss（与值日页共用同一套 keyframes）。
         ⚠️ 别把 fixed 元素（.fab / .fab-menu）放进这个容器 —— transform 会创建包含块，
            fixed 后代会跟着一起位移。它们刻意留在容器外，由 scripts/check-tab-enter.js 守着。
         ⚠️ 缩进刻意与容器内层同列：套一层不改变 .st-item 的兄弟关系与档位顺序，
            重排缩进只会让 diff 变脏（值日页 .wk-swipe 也是这个写法）。 -->
    <view class="wk-swipe {{swipeCls}}">
    <!-- 课表主体：左侧「节次」列固定，右侧「日期 + 格子」按需横向滚动。
         默认只显示周一 ~ 周五并铺满屏幕宽；周末有课（含调课调入）时才补上周六 / 周日两列。 -->
    <view class="tt-board st-item st-3">
      <view class="tt-fixed">
        <view class="tt-fixed-head" style="height:{{headH}}rpx"></view>
        <view
          wx:for="{{grid}}"
          wx:for-item="row"
          wx:for-index="r"
          wx:key="r"
          class="tt-fixed-row"
          style="height:{{rowH}}rpx"
        >
          <text class="tt-time-p">{{periods[r].p}}</text>
        </view>
      </view>

      <scroll-view class="tt-scroll" scroll-x>
        <view class="tt-body" style="width:{{dateWidth}}rpx">
          <!-- 日期表头 -->
          <view class="tt-head" style="height:{{headH}}rpx">
            <view
              wx:for="{{dates}}"
              wx:key="dow"
              class="tt-head-cell {{item.isWeekend ? 'wk' : ''}} {{item.isToday ? 'today' : ''}} {{item.isHoliday ? 'off' : ''}}"
            >
              <text class="tt-head-w">{{item.short}}</text>
              <text class="tt-head-d">{{item.day}}</text>
              <text wx:if="{{item.isHoliday}}" class="tt-head-tag">假</text>
              <text wx:elif="{{item.isMakeup}}" class="tt-head-tag mk">班</text>
              <text wx:if="{{item.shiftOutText}}" class="tt-head-shift out">调</text>
              <text wx:elif="{{item.shiftInText}}" class="tt-head-shift in">入</text>
            </view>
          </view>

          <!-- 网格 -->
          <view wx:for="{{grid}}" wx:for-item="row" wx:for-index="r" wx:key="r" class="tt-row" style="height:{{rowH}}rpx">
            <view
              wx:for="{{row}}"
              wx:for-item="cell"
              wx:for-index="c"
              wx:key="c"
              class="tt-cell-slot {{cell.wk ? 'wk' : ''}}"
            >
              <block wx:if="{{!cell.empty}}">
                <!-- 色值走 app.wxss 的 --co-N-bg / --co-N-fg（深色下自动换成暗色版）。
                     底色与字色都写在块上，课名 / 教室**继承** color ——
                     深色下左侧那条 6rpx 色条取的就是这里的 currentColor
                     （见 wxss 的 .t-dark .tt-cell::before）。 -->
                <view data-pressable
                  wx:for="{{cell.courses}}"
                  wx:for-item="co"
                  wx:for-index="ci"
                  wx:key="key"
                  class="tt-cell {{co.isHoliday ? 'holiday' : ''}} {{co.movedIn ? 'moved-in' : ''}} {{co.personal ? 'personal' : ''}} {{ (periods[r].p === currentPeriod && dates[c].isToday) ? 'current' : '' }}"
                  style="background:{{co.bg}};color:{{co.fg}};{{co.flip}}"
                  data-r="{{r}}"
                  data-c="{{c}}"
                  data-sid="{{co.sessionId}}"
                  data-personal="{{co.personal ? 1 : ''}}"
                  data-pid="{{co.personal ? co.pid : ''}}"
                  hover-class="tt-cell-hover"
                  hover-start-time="0"
                  hover-stay-time="60"
                  bindtap="onCell"
                  bindlongpress="onCellLongPress"
                >
                  <view wx:if="{{co.groupScope}}" class="tt-cell-tag">{{co.groupScope}} 组</view>
                  <view wx:elif="{{co.personal}}" class="tt-cell-tag personal-tag">个</view>
                  <text class="tt-cell-name">{{co.name}}</text>
                  <text class="tt-cell-room">{{co.room}}</text>
                  <view wx:if="{{co.movedIn}}" class="tt-cell-shift in">自{{co.shiftFromText}}调入</view>
                  <view wx:elif="{{co.shifted}}" class="tt-cell-shift">调课</view>
                  <view wx:if="{{co.isHoliday}}" class="tt-cell-holiday">假期</view>
                </view>
              </block>
              <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable wx:else class="tt-cell empty" data-r="{{r}}" data-c="{{c}}" bindtap="onCell" bindlongpress="onCellLongPress"></view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{showScrollHint}}" class="tt-scroll-hint">← 左右滑动可查看周六 / 周日 →</view>
    <view wx:if="{{isSuper}}" class="tt-scroll-hint">长按某个格子可以快速临时调课</view>

    <!-- 分组课提示 -->
    <view wx:if="{{tip}}" class="tt-wrap">
      <notice-bar type="warning" icon="info" text="{{tip}}" />
    </view>

    <view class="tt-foot"></view>
    </view>
  </block>

  <!-- 视图 + 调课入口（左下角，v0.7.21 需求③）：一个按钮，点开向上展开三行。
       原先是「顶部 A/B 分段 + 左下角临时调课胶囊」两处，现在收成一处：
       按钮上写着当前正在看的组，展开后能换组、也能进临时调课。
       ⚠️ fixed 元素：必须留在 .wk-swipe 动画容器**外面**（transform 建包含块）。
       ⚠️ 「临时调课」只给超管；普通同学看到的菜单里就是 A 组 / B 组两行。 -->
  <view wx:if="{{!loading && ((canSwitchClass && classList.length) || (!isCounselor && hasTimetable))}}" class="fab-menu {{fabMenuOpen ? 'open' : ''}}">
    <!-- #10 弧形菜单（2026-11-14 按用户口径重做）：
         **长按才展开**，按住期间菜单一直显示；手指拖到某个按钮上会高亮，
         **松手 = 点了那个按钮**；没拖到按钮就松手 ⇒ 四个按钮收回。
         ⚠️ 为什么触摸跟踪在页面而不在组件：bindlongpress 触发时组件才刚渲染，
            后续 touchmove/touchend 的事件目标仍是按钮本身，不会冒泡到组件 ⇒
            组件收不到「松手」。所以页面监听 touch* 并用 selectComponent 转发给组件。
         ⚠️ span-start/span-end 把弧收进**右上象限**（屏幕坐标：0=正右，-90=正上），
            否则靠下的菜单项会掉到 tabBar 底下被遮住。
         ⚠️ 外层 .fab-menu 的 wx:if 守卫是 check-timetable-local 逐入口点名的
            （辅导员不得进调课/编辑入口），改结构时**别动这个守卫**。
         ⚠️ fm* 是「按钮菜单」的独立状态，与「长按格子」那条弧形菜单（rm*）完全分开。 -->
    <view data-pressable class="fab-menu-btn" hover-class="press-dim" hover-start-time="0" hover-stay-time="60"
      bindtouchstart="onFabTouchStart" bindtouchmove="onFabTouchMove"
      bindtouchend="onFabTouchEnd" bindtouchcancel="onFabTouchEnd"
      bindlongpress="onFabRadial">
      <app-icon name="grid" variant="brand" size="{{34}}" />
      <text class="fab-menu-t">{{viewGroup === 'ALL' ? '全部' : (viewGroup === 'B' ? 'B 组' : 'A 组')}}</text>
      <app-icon name="{{fabMenuOpen ? 'chevron-down' : 'chevron-up'}}" variant="gray" size="{{26}}" />
    </view>
    <radial-menu
      id="rm-fab"
      show="{{fmShow}}"
      x="{{fmX}}"
      y="{{fmY}}"
      radius="{{140}}"
      span-start="{{-105}}"
      span-end="{{5}}"
      items="{{fmItems}}"
      bind:close="onFabRadialClose"
      bind:select="onFabSelect"
    />
  </view>

  <!-- 新增课次 FAB：人人可见，**一律是添加个人选修课**（仅自己可见，含超管 —— 2026-10-16 用户定口径）；
       !isCounselor 保留在 wxml（辅导员只看不改，门禁 check-timetable-local 逐入口点名守卫） -->
  <view data-pressable wx:if="{{fabShow && !isCounselor}}" class="fab" hover-class="press-dim" hover-start-time="0" hover-stay-time="60" bindtap="onFab">
    <app-icon name="plus" variant="white" size="{{44}}" />
  </view>

  <!-- 课次详情 -->
  <bottom-sheet show="{{detailShow}}" title="课次详情" bind:close="onDetailClose">
    <view wx:if="{{detail}}" class="ds-form">
      <view class="tt-detail-name">{{detail.name}}</view>
      <view class="tt-detail-row">
        <text class="k">教师</text><text class="v">{{detail.teacher || '未填写'}}</text>
      </view>
      <view class="tt-detail-row">
        <text class="k">教室</text><text class="v">{{detail.room || '未填写'}}</text>
      </view>
      <view class="tt-detail-row">
        <text class="k">时间</text><text class="v">周{{detail.dowText}} 第 {{detail.period}} 节</text>
      </view>
      <view class="tt-detail-row">
        <text class="k">周次</text><text class="v">{{detail.weekText}}</text>
      </view>
      <view class="tt-detail-row">
        <text class="k">分组</text><text class="v">{{detail.groupScope ? detail.groupScope + ' 组（分组课）' : '全体课'}}</text>
      </view>
      <view class="tt-detail-row">
        <text class="k">需值日</text><text class="v">{{detail.dutyCount}} 人</text>
      </view>
      <view class="tt-detail-duties" wx:if="{{detail.duties.length}}">
        <view class="tt-detail-sub">已排值日</view>
        <view wx:for="{{detail.duties}}" wx:key="id" class="tt-duty-row">
          <avatar-tag name="{{item.name}}" text="{{item.seqText}}" no-fallback="{{true}}" size="{{64}}" />
          <text class="tt-duty-name">{{item.name}}</text>
          <status-pill status="{{item.status}}" size="sm" />
        </view>
      </view>
      <view wx:if="{{isAdmin}}" class="tt-detail-actions">
        <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="tt-dbtn danger" bindtap="onDeleteCourse">删除课次</view>
        <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="tt-dbtn primary" bindtap="onEditCourse">编辑</view>
      </view>
    </view>
  </bottom-sheet>

  <!-- 新增 / 编辑课次（管理员）或个人选修课（人人，最多 2 门） P3.1 -->
  <bottom-sheet show="{{formShow}}" title="{{formMode === 'elective' ? (form.electiveId ? '编辑选修课' : '添加选修课') : (form.sessionId ? '编辑课次' : '新增课次')}}" height="{{1080}}" bind:close="onFormClose">
    <view wx:if="{{form}}" class="ds-form">
      <view class="f-row">
        <text class="f-label">课程名</text>
        <input class="f-input" value="{{form.name}}" placeholder="请输入课程名" placeholder-class="f-ph" data-field="name" bindinput="onFormInput" />
      </view>
      <view class="f-row">
        <text class="f-label">教师</text>
        <input class="f-input" value="{{form.teacher}}" placeholder="选填" placeholder-class="f-ph" data-field="teacher" bindinput="onFormInput" />
      </view>
      <view class="f-row">
        <text class="f-label">教室</text>
        <input class="f-input" value="{{form.room}}" placeholder="选填" placeholder-class="f-ph" data-field="room" bindinput="onFormInput" />
      </view>

      <view wx:if="{{formMode !== 'elective'}}" class="f-row">
        <text class="f-label">课程类型</text>
        <segmented
          items="{{[{key:'ALL',text:'全体课'},{key:'GROUP',text:'分组课'}]}}"
          value="{{form.courseType}}"
          width="{{320}}"
          bind:change="onFormSegmented"
          data-field="courseType"
        />
      </view>
      <view wx:if="{{formMode !== 'elective' && form.courseType === 'GROUP'}}" class="f-row">
        <text class="f-label">上课分组</text>
        <view class="f-chips">
          <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="f-chip chip-motion {{form.groupScope === 'A' ? 'on' : ''}}" data-field="groupScope" data-value="A" bindtap="onFormChoose">A 组</view>
          <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="f-chip chip-motion {{form.groupScope === 'B' ? 'on' : ''}}" data-field="groupScope" data-value="B" bindtap="onFormChoose">B 组</view>
        </view>
        <text class="f-tip">A 组＝学号尾号单数，B 组＝学号尾号双数</text>
      </view>

      <view class="f-block">
        <text class="f-label">上课时间</text>
        <view class="f-chips">
          <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable
            wx:for="{{dayChips}}"
            wx:key="key"
            class="f-chip chip-motion {{form.dayOfWeek === item.key ? 'on' : ''}}"
            data-field="dayOfWeek"
            data-value="{{item.key}}"
            bindtap="onFormChoose"
          >周{{item.text}}</view>
        </view>
        <view class="f-chips">
          <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable
            wx:for="{{periodChips}}"
            wx:key="*this"
            class="f-chip chip-motion {{form.period === item ? 'on' : ''}}"
            data-field="period"
            data-value="{{item}}"
            bindtap="onFormChoose"
          >第{{item}}节</view>
        </view>
        <text class="f-tip">共 {{periodChips.length}} 个大节（按班级时间设置）</text>
      </view>

      <view class="f-block">
        <text class="f-label">上课周次</text>
        <text class="f-tip">不勾选＝每周都上；可多选指定周次（1–{{totalWeeks}}）</text>
        <view class="f-chips">
          <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable
            wx:for="{{weekBtns}}"
            wx:key="n"
            class="f-chip chip-motion {{item.on ? 'on' : ''}} {{item.n === week ? 'cur' : ''}}"
            data-week="{{item.n}}"
            bindtap="onToggleWeek"
          >{{item.n}}</view>
        </view>
      </view>

      <view wx:if="{{formMode !== 'elective'}}" class="f-row">
        <text class="f-label">每次需值日</text>
        <stepper value="{{form.dutyCount}}" min="{{0}}" max="{{4}}" bind:change="onStepper" />
      </view>

      <view wx:if="{{formMode === 'elective' && form.electiveId}}" class="f-actions">
        <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="f-save danger {{saving ? 'off' : ''}}" bindtap="onDeleteElective">删除选修课</view>
      </view>

      <view class="f-actions">
        <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="f-save {{saving ? 'off' : ''}}" bindtap="onSave">{{saving ? '保存中' : '保存'}}</view>
      </view>
    </view>
  </bottom-sheet>

  <!-- 周次选择 -->
  <bottom-sheet show="{{weekPickerShow}}" title="选择周次" bind:close="onWeekPickerClose">
    <view class="wk-grid">
      <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable
        wx:for="{{weekList}}"
        wx:key="*this"
        class="wk-chip chip-motion {{week === item ? 'on' : ''}} {{current === item ? 'cur' : ''}}"
        data-week="{{item}}"
        bindtap="onPickWeek"
      >{{item}}</view>
    </view>
  </bottom-sheet>

  <!-- 临时调课（超级管理员）：本周 / 多周次 / 按日期 / AI / 结果 -->
  <bottom-sheet show="{{shiftShow}}" title="临时调课" height="{{1220}}" bind:close="onShiftClose">
    <view class="ds-form">

      <segmented items="{{shiftTabs}}" value="{{shiftTab}}" width="{{686}}" bind:change="onShiftTab" />

      <!-- ① 本周调整 -->
      <block wx:if="{{shiftTab === 'week' || shiftTab === 'multi'}}">
        <view class="f-block">
          <text class="f-label">选择课次</text>
          <picker mode="selector" range="{{shiftSessionLabels}}" value="{{shiftSessionIndex}}" bindchange="onShiftPickSession">
            <view class="ts-pick {{shiftSessionLabels.length ? '' : 'ph'}}">
              {{shiftSessionLabels[shiftSessionIndex] || '本周没有可调课次'}}
            </view>
          </picker>
          <text class="f-tip">也可以直接在课表上长按某一格，自动选中那节课</text>
        </view>

        <view class="f-block">
          <text class="f-label">怎么调</text>
          <segmented
            items="{{[{key:'OFF',text:'这一周不上'},{key:'MOVE',text:'改到别的格子'}]}}"
            value="{{shiftKind}}"
            width="{{520}}"
            bind:change="onShiftKind"
          />
        </view>

        <view wx:if="{{shiftKind === 'MOVE' && shiftTab === 'week'}}" class="f-block">
          <text class="f-label">调到哪一周</text>
          <picker mode="selector" range="{{shiftToWeekLabels}}" value="{{shiftToWeekIndex}}" bindchange="onShiftToWeek">
            <view class="ts-pick">{{shiftToWeekLabels[shiftToWeekIndex] || '本周'}}</view>
          </picker>
          <text class="f-tip">留「本周」＝同一周里换个格子；选别的周＝这一周不上、这次课补到那一周的这一天</text>
        </view>

        <view wx:if="{{shiftKind === 'MOVE'}}" class="f-block">
          <text class="f-label">改到</text>
          <view class="f-chips">
            <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable
              wx:for="{{dayChips}}"
              wx:key="key"
              class="f-chip chip-motion {{shiftToDay === item.key ? 'on' : ''}}"
              data-value="{{item.key}}"
              bindtap="onShiftToDay"
            >周{{item.text}}</view>
          </view>
          <view class="f-chips">
            <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable
              wx:for="{{periodChips}}"
              wx:key="*this"
              class="f-chip chip-motion {{shiftToPeriod === item ? 'on' : ''}}"
              data-value="{{item}}"
              bindtap="onShiftToPeriod"
            >第{{item}}节</view>
          </view>
        </view>

        <view wx:if="{{shiftTab === 'multi'}}" class="f-block">
          <text class="f-label">应用到哪些周</text>
          <text class="f-tip">可多选；带「本周」标记的是你正在看的这一周</text>
          <view class="f-chips">
            <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable
              wx:for="{{shiftWeekBtns}}"
              wx:key="n"
              class="f-chip chip-motion {{item.on ? 'on' : ''}} {{item.cur ? 'cur' : ''}}"
              data-week="{{item.n}}"
              bindtap="onToggleShiftWeek"
            >{{item.n}}</view>
          </view>
        </view>

        <view class="f-actions">
          <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable
            wx:if="{{shiftTab === 'week'}}"
            class="f-save {{shiftSaving ? 'off' : ''}}"
            bindtap="onShiftApplyWeek"
          >应用到第 {{week}} 周</view>
          <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable
            wx:else
            class="f-save {{shiftSaving ? 'off' : ''}}"
            bindtap="onShiftApplyMulti"
          >应用到选中的 {{shiftWeeks.length}} 周</view>
        </view>
      </block>

      <!-- ② 按日期：这几天不上 / 某天调到另一天 -->
      <block wx:elif="{{shiftTab === 'date'}}">
        <view class="f-block">
          <text class="f-label">这几天不上课</text>
          <text class="f-tip">选中第 {{week}} 周里要取消的日期，那一整天所有课都不上</text>
          <view class="ts-days">
            <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable
              wx:for="{{dates}}"
              wx:key="dow"
              class="ts-day {{item.off ? 'on' : ''}}"
              data-dow="{{item.dow}}"
              bindtap="onToggleOffDay"
            >
              <text class="ts-day-w">周{{item.short}}</text>
              <text class="ts-day-d">{{item.day}}</text>
            </view>
          </view>
          <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="cal-save {{shiftSaving ? 'off' : ''}}" bindtap="onApplyDateOff">
            {{offDays.length ? ('取消这 ' + offDays.length + ' 天的课') : '取消选中的日期'}}
          </view>
        </view>

        <view class="f-block">
          <text class="f-label">某天调到另一天</text>
          <text class="f-tip">整天的课都挪到目标日期（可跨周，属于校历调整）</text>
          <view class="cal-two">
            <picker mode="date" value="{{shiftForm.from}}" bindchange="onShiftFrom">
              <view class="cal-picker {{shiftForm.from ? '' : 'ph'}}">{{shiftForm.from || '调出日期'}}</view>
            </picker>
            <text class="cal-arrow">→</text>
            <picker mode="date" value="{{shiftForm.to}}" bindchange="onShiftTo">
              <view class="cal-picker {{shiftForm.to ? '' : 'ph'}}">{{shiftForm.to || '调入日期'}}</view>
            </picker>
          </view>
          <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="cal-save" bindtap="onShiftSave">添加调课</view>
          <text class="f-tip">调课只改变「上课与值日的日期」；调休日的值日请到值日页手动调整。</text>
        </view>
      </block>

      <!-- ③ AI 智能调课 -->
      <block wx:elif="{{shiftTab === 'ai'}}">
        <view class="f-block">
          <text class="f-label">说说要怎么调</text>
          <textarea
            class="ts-area"
            value="{{aiText}}"
            placeholder="例如：这周四第 3 节不上；周三第 5 节的音乐基础改到周五第 1 节"
            placeholder-class="f-ph"
            maxlength="300"
            bindinput="onAiText"
          />
          <view class="ts-chips">
            <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable
              wx:for="{{aiExamples}}"
              wx:key="*this"
              class="ts-chip"
              data-text="{{item}}"
              bindtap="onAiExample"
            >{{item}}</view>
          </view>
        </view>

        <view class="f-block">
          <view class="ts-row">
            <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="ts-btn ghost" bindtap="onAiPromptShow">查看提示词</view>
            <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="ts-btn ghost" bindtap="onAiCheck">链路自检</view>
          </view>
          <view class="ts-row">
            <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable
              class="ts-btn primary {{aiBusy ? 'off' : ''}}"
              bindtap="onAiPlan"
            >{{aiBusy ? 'AI 正在想…' : 'AI 生成调课方案'}}</view>
          </view>
          <view wx:if="{{aiError}}" class="ts-err">{{aiError}}</view>
        </view>

        <view wx:if="{{aiPromptShow}}" class="f-block">
          <text class="f-label">提示词（可编辑）</text>
          <textarea class="ts-area tall" value="{{aiPrompt}}" maxlength="4000" bindinput="onAiPromptInput" />
          <view class="ts-row">
            <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="ts-btn ghost" bindtap="onAiPromptClose">收起</view>
            <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="ts-btn ghost" bindtap="onAiPromptReset">恢复默认</view>
          </view>
        </view>

        <view wx:if="{{aiPreview.length}}" class="f-block">
          <text class="f-label">方案预览（{{aiPreview.length}} 节课）</text>
          <view wx:if="{{aiNotes}}" class="ts-note">{{aiNotes}}</view>
          <view wx:for="{{aiPreview}}" wx:key="sessionId" class="ts-item">
            <view class="ts-item-main">
              <text class="ts-item-name">{{item.name}}</text>
              <text class="ts-item-eff">{{item.fromText}} → {{item.effect}}</text>
            </view>
            <text wx:if="{{item.note}}" class="ts-item-note">{{item.note}}</text>
          </view>
          <view wx:for="{{aiWarnings}}" wx:key="*this" class="ts-warn">⚠ {{item}}</view>
          <view class="ts-row">
            <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="ts-btn ghost" bindtap="onAiDiscard">放弃</view>
            <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable
              class="ts-btn primary {{shiftSaving ? 'off' : ''}}"
              bindtap="onAiApply"
            >应用到第 {{week}} 周</view>
          </view>
        </view>
      </block>

      <!-- ④ 调课结果 -->
      <block wx:else>
        <view class="f-block">
          <text class="f-label">第 {{week}} 周的临时调课（{{shiftItems.length}}）</text>
          <view wx:if="{{!shiftItems.length}}" class="cal-empty">本周没有临时调课</view>
          <view wx:for="{{shiftItems}}" wx:key="key" class="ts-item">
            <view class="ts-item-main">
              <text class="ts-item-name">{{item.name}}</text>
              <text class="ts-item-eff">{{item.effText}}</text>
            </view>
            <text hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="ts-del" data-id="{{item.sessionId}}" data-week="{{item.undoWeek}}" catchtap="onShiftUndo">撤销</text>
          </view>
          <view wx:if="{{shiftItems.length}}" class="ts-row">
            <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="ts-btn ghost danger" bindtap="onShiftClearWeek">撤销本周全部临时调课</view>
          </view>
          <text class="f-tip">调课会改变上课日期与值日日期；本周若已发布，调课后退回草稿，需要重新发布。跨周调课在「调出周」与「调入周」两边各显示一条，点任一条的撤销都会整笔撤销。</text>
        </view>

        <view class="f-block">
          <text class="f-label">本周按天调课（校历）</text>
          <view wx:if="{{!calShifts.length}}" class="cal-empty">暂无按天调课</view>
          <view wx:for="{{calShifts}}" wx:key="id" class="cal-item">
            <text class="cal-date">{{item.from}} → {{item.to}}</text>
            <text class="cal-name">{{item.note}}</text>
            <text hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="cal-del" data-id="{{item.id}}" catchtap="onShiftDel">取消</text>
          </view>
        </view>
      </block>

    </view>
  </bottom-sheet>

  <!-- 校历：节假日 / 调休 / 调课（超级管理员） -->
  <bottom-sheet show="{{calShow}}" title="节假日与调休" height="{{1180}}" bind:close="onCalClose">
    <view class="ds-form">

      <view class="cal-sec">
        <view class="cal-sec-t">节假日（放假不上课）</view>
        <view class="cal-list">
          <view wx:for="{{calHolidays}}" wx:key="date" class="cal-item">
            <text class="cal-date">{{item.date}}</text>
            <text class="cal-name">{{item.name}}</text>
            <text class="cal-kind {{item.kind === 'MAKEUP' ? 'mk' : ''}}">{{item.kind === 'MAKEUP' ? '调休上班' : '放假'}}</text>
            <text hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="cal-del" data-date="{{item.date}}" catchtap="onHolidayDel">删除</text>
          </view>
          <view wx:if="{{!calHolidays.length && !calLoading}}" class="cal-empty">暂无节假日</view>
        </view>
        <view class="cal-form">
          <view class="cal-two">
            <picker mode="date" value="{{holidayForm.date}}" bindchange="onHolidayPick">
              <view class="cal-picker {{holidayForm.date ? '' : 'ph'}}">{{holidayForm.date || '选择日期'}}</view>
            </picker>
            <input class="cal-input" value="{{holidayForm.name}}" placeholder="名称，如 国庆节" placeholder-class="f-ph" bindinput="onHolidayName" />
          </view>
          <view class="f-chips">
            <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="f-chip chip-motion {{holidayForm.kind === 'OFF' ? 'on' : ''}}" data-value="OFF" bindtap="onHolidayKind">放假</view>
            <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="f-chip chip-motion {{holidayForm.kind === 'MAKEUP' ? 'on' : ''}}" data-value="MAKEUP" bindtap="onHolidayKind">调休上班</view>
          </view>
          <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="cal-save" bindtap="onHolidaySave">添加 / 保存</view>
        </view>
      </view>

      <view class="cal-sec">
        <view class="cal-sec-t">按天整体调课（把某天的课挪到另一天）</view>
        <view class="cal-list">
          <view wx:for="{{calShifts}}" wx:key="id" class="cal-item">
            <text class="cal-date">{{item.from}} → {{item.to}}</text>
            <text class="cal-name">{{item.note}}</text>
            <text hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="cal-del" data-id="{{item.id}}" catchtap="onShiftDel">取消</text>
          </view>
          <view wx:if="{{!calShifts.length && !calLoading}}" class="cal-empty">暂无调课</view>
        </view>
        <view class="cal-form">
          <view class="cal-two">
            <picker mode="date" value="{{shiftForm.from}}" bindchange="onShiftFrom">
              <view class="cal-picker {{shiftForm.from ? '' : 'ph'}}">{{shiftForm.from || '调出日期'}}</view>
            </picker>
            <text class="cal-arrow">→</text>
            <picker mode="date" value="{{shiftForm.to}}" bindchange="onShiftTo">
              <view class="cal-picker {{shiftForm.to ? '' : 'ph'}}">{{shiftForm.to || '调入日期'}}</view>
            </picker>
          </view>
          <input class="cal-input" value="{{shiftForm.note}}" placeholder="备注（选填）" placeholder-class="f-ph" bindinput="onShiftNote" />
          <view hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="cal-save" bindtap="onShiftSave">添加调课</view>
        </view>
        <view class="cal-hint">调课只改变「上课与值日的日期」；调休日的值日请手动调整。</view>
      </view>

    </view>
  </bottom-sheet>

  <!-- 调课刚保存后的撤回浮条（8 秒窗口）：误调是最高频事故，给一次一键反悔 -->
  <view wx:if="{{undoBar}}" class="tt-undo-bar">
    <text class="tt-undo-txt">{{undoBar.text}}</text>
    <text hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="tt-undo-act" bindtap="onShiftUndoBar">撤回</text>
    <text hover-class="press-shrink" hover-start-time="0" hover-stay-time="60" data-pressable class="tt-undo-x" bindtap="onShiftUndoBarClose">✕</text>
  </view>

  <!-- #10 课程表长按弧形菜单：从触点放射性展开「本周调整 / 指定日期 / 取消」 -->
  <radial-menu
    show="{{rmShow}}"
    x="{{rmX}}"
    y="{{rmY}}"
    items="{{rmItems}}"
    bind:close="onRmClose"
    bind:select="onRmSelect"
  />

</view>
