.ta { min-height: 100vh; background: var(--bg-page); }
/* 导航右插槽样式（.ta-nav-right / .ta-nav-btn）随「刷新」按钮一起下移到页内，见 .ta-bar */
.ta-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 4rpx;
}
.ta-bar-t { font-size: 24rpx; color: var(--text-3); }
.ta-refresh {
  font-size: 26rpx;
  color: var(--brand);
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: var(--brand-light);
}
.ta-refresh:active { background: var(--brand-light-hover); }
.ta-loading { text-align: center; font-size: 28rpx; color: var(--text-3); padding: 120rpx 0; }
.ta-list { padding: 24rpx 32rpx 60rpx; }
.ta-card { background: var(--bg-card); border-radius: 32rpx; padding: 28rpx 28rpx 20rpx; margin-bottom: 24rpx; box-shadow: 0 8rpx 30rpx rgba(29,33,41,0.06); }
.ta-card-head { display: flex; justify-content: space-between; align-items: center; }
.ta-class { font-size: 32rpx; font-weight: 600; color: var(--text-1); }
.ta-status { font-size: 24rpx; color: var(--brand); background: var(--brand-light); border-radius: 12rpx; padding: 4rpx 16rpx; }
/* 组别徽标（2026-10-05）：A/B 组是两份独立申请，用橙色区分「这份属于哪组」 */
.ta-status.grp { color: #D25F00; background: var(--warning-bg); }
/* 深色下把这几处暗橙提亮（浅色语义色压深色 tint 看不清） */
.t-dark .ta-status.grp,
.t-dark .ta-sum-w,
.t-dark .im-warn-t,
.t-dark .im-warn-item { color: var(--warning); }
.ta-row { display: flex; font-size: 26rpx; margin-top: 16rpx; }
.ta-row .k { color: var(--text-3); width: 130rpx; flex-shrink: 0; }
.ta-row .v { color: var(--text-1); flex: 1; }
.ta-sum { font-size: 24rpx; color: var(--text-2); margin-top: 16rpx; }
.ta-sum-w { color: #D25F00; }
.ta-actions { display: flex; align-items: center; margin-top: 24rpx; }
.ta-btn { font-size: 28rpx; border-radius: 20rpx; padding: 16rpx 0; text-align: center; flex: 1; margin-left: 16rpx; }
.ta-btn:first-child { margin-left: 0; }
.ta-btn.ghost { background: var(--bg-fill); color: var(--text-2); }
.ta-btn.ghost.danger { color: var(--danger); }
.ta-btn.primary { background: var(--brand); color: #FFFFFF; }
.ta-btn.off { opacity: 0.5; }

/* 复用 timetable 页预览样式 */
.ds-form { padding: 8rpx 32rpx 48rpx; }
.im-stat { display: flex; align-items: baseline; font-size: 28rpx; color: var(--text-2); }
.im-list { height: 420rpx; }
.im-empty { font-size: 26rpx; color: var(--text-3); text-align: center; padding: 60rpx 0; }
.im-num { font-size: 44rpx; font-weight: 700; color: var(--text-1); margin: 0 6rpx; }
.im-group { margin-top: 16rpx; font-size: 26rpx; color: var(--text-2); }
.im-group-v { color: var(--brand); font-weight: 600; }
.im-dot { margin: 0 16rpx; color: var(--text-4); }
.im-warn { margin-top: 24rpx; background: var(--warning-bg); border-radius: 20rpx; padding: 20rpx 24rpx; }
.im-warn-t { font-size: 26rpx; color: #D25F00; font-weight: 600; }
.im-warn-item { font-size: 24rpx; color: #8A5A00; margin-top: 10rpx; line-height: 34rpx; }
.im-list-t { font-size: 26rpx; color: var(--text-3); margin: 28rpx 0 12rpx; }
.im-list { max-height: 520rpx; }
.im-course { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; border-bottom: 2rpx solid var(--bg-fill); }
.im-c-name { font-size: 28rpx; color: var(--text-1); }
.im-c-teacher { font-size: 24rpx; color: var(--text-3); }
/* 底部操作按钮统一规范（2026-10-05 对齐全局 .btn：高度 96rpx / 圆角 --r-md / 字号 32rpx / 字重 600；
   .f-actions 为 flex 行 + gap，.f-save 主按钮与 .im-cancel 次按钮等宽。以后加按钮直接套。） */
.f-actions { display: flex; gap: 20rpx; align-items: stretch; margin-top: 28rpx; }
.f-save, .im-cancel {
  flex: 1;
  height: 96rpx;
  border-radius: var(--r-md);
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.f-save { background: var(--brand); color: #FFFFFF; }
.f-save.off { background: var(--brand-disable); }
.im-cancel { background: var(--bg-fill); color: var(--text-2); font-weight: 500; }
